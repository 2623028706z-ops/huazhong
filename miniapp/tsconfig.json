{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["es2023"],
    "types": ["miniprogram-api-typings", "node"]
  },
  "include": ["miniprogram/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "exclude": ["miniprogram/miniprogram_npm"]
}
