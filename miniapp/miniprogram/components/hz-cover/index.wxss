.hz-cover {
  position: fixed;
  top: 0;
  left: 0;
  z-index: -1;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.hz-cover__image,
.hz-cover__soft,
.hz-cover__fade {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hz-cover__soft {
  background: var(--hz-bg);
  opacity: 0.6;
}

/* 登录页：上半透出原图，下部渐亮到墙色 */
.hz-cover__fade {
  background: linear-gradient(to bottom, transparent 52%, var(--hz-bg) 88%);
}
