/* 主卡高 150px、小卡高 100px，间距 12px（docs/design/mock-ext.html） */
.hz-hub__hero {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 150px;
  padding: 20px 18px;
}

.hz-hub__hero-icon {
  font-size: var(--hz-icon-hero);
  color: var(--hz-brand);
}

.hz-hub__hero-name {
  display: block;
  font-size: var(--hz-font-hero);
  letter-spacing: 0.2em;
}

.hz-hub__hero-sub {
  display: block;
  margin-top: 6px;
  font-size: var(--hz-font-note);
  color: var(--hz-muted);
}

.hz-hub__go {
  position: absolute;
  right: var(--hz-card-pad);
  bottom: 22px;
  font-size: var(--hz-icon);
  color: var(--hz-muted);
}

.hz-hub__badge {
  position: absolute;
  top: 18px;
  right: var(--hz-card-pad);
  min-width: 22px;
  padding: 0 9px;
  font-size: var(--hz-font-sm);
  line-height: 22px;
  color: var(--hz-on-brand);
  text-align: center;
  background: var(--hz-brand);
  border-radius: var(--hz-radius-pill);
}

.hz-hub__minis {
  display: grid;
  gap: 12px;
  margin-top: 12px;
}

.hz-hub__mini {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100px;
  padding: var(--hz-card-pad);
}

.hz-hub__mini-icon {
  font-size: var(--hz-icon-tab);
  color: var(--hz-brand);
}

.hz-hub__mini-name {
  font-size: var(--hz-font-md);
  font-weight: 600;
  letter-spacing: 0.12em;
}

/* 同入口卡「不能用」：整张变淡 */
.hz-hub--off {
  opacity: 0.45;
}
