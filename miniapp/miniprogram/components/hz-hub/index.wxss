/* 门店、供应商首页：主格 + 一排小格，和入口窗格同一种细线窗格（docs/design/mock-art.html） */
.hz-hub {
  display: grid;
  overflow: hidden;
  border: 1px solid var(--hz-rule);
  border-radius: var(--hz-radius);
}

.hz-hub__hero {
  position: relative;
  display: flex;
  flex-direction: column;
  grid-column: 1 / -1;
  justify-content: space-between;
  height: 150px;
  padding: 20px 18px;
}

.hz-hub__hero-icon {
  font-size: var(--hz-icon-hero);
  color: var(--hz-brand);
}

.hz-hub__hero-name {
  display: block;
  font-size: var(--hz-font-hero);
  letter-spacing: 0.3em;
}

.hz-hub__hero-sub {
  display: block;
  margin-top: 6px;
  font-size: var(--hz-font-note);
  color: var(--hz-muted);
}

.hz-hub__go {
  position: absolute;
  right: var(--hz-card-pad);
  bottom: 22px;
  font-size: var(--hz-icon);
  color: var(--hz-muted);
}

.hz-hub__badge {
  position: absolute;
  top: 18px;
  right: var(--hz-card-pad);
  min-width: 22px;
  padding: 0 7px;
  font-size: var(--hz-font-sm);
  line-height: 22px;
  color: var(--hz-on-brand);
  text-align: center;
  background: var(--hz-brand);
  border-radius: var(--hz-radius-pill);
}

.hz-hub__mini {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100px;
  padding: var(--hz-card-pad);
  border-top: 1px solid var(--hz-rule);
}

.hz-hub__mini + .hz-hub__mini {
  border-left: 1px solid var(--hz-rule);
}

.hz-hub__mini-icon {
  font-size: var(--hz-icon-tab);
  color: var(--hz-brand);
}

.hz-hub__mini-name {
  font-size: var(--hz-font-md);
  font-weight: 600;
  letter-spacing: 0.12em;
}

/* 不能用：格子里的东西变淡，窗格线不变 */
.hz-hub--off > text,
.hz-hub--off > view {
  opacity: 0.45;
}
