<view class="hz-state">
  <view class="hz-state__pane"></view>
  <text class="hz-state__text u-serif">{{text}}</text>
  <text wx:if="{{detail || hint}}" class="hz-state__detail">{{detail || hint}}</text>
  <text wx:if="{{requestText}}" class="hz-state__detail">{{requestText}}</text>
  <view wx:if="{{action}}" class="hz-state__action">
    <hz-button kind="secondary" text="{{actionText}}" bind:press="onAction" />
  </view>
</view>
