/* 不装卡片，直接落在页面上，上方留白（02 章第 4 节） */
.hz-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64px var(--hz-card-pad) 26px;
  text-align: center;
}

.hz-state__rule {
  width: 28px;
  height: 1px;
  margin-bottom: 14px;
  background: var(--hz-brand);
}

.hz-state__text {
  font-size: var(--hz-font-md);
  letter-spacing: 0.14em;
}

.hz-state__detail {
  margin-top: 6px;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-state__action {
  width: 120px;
  margin-top: 14px;
}
