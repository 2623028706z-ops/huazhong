/* 不装卡片，直接落在页面上，上方留白（02 章第 4 节） */
.hz-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64px var(--hz-card-pad) var(--hz-space-5); /* 64px：02 章规定空状态上方留白 64px，超出 5 档 */
  text-align: center;
}

/* 淡色小窗格（品牌图形「窗格」）：拱顶 + 十字窗棂，2026-10-05 替换原来的陶土短线 */
.hz-state__pane {
  position: relative;
  width: 40px;
  height: 52px;
  margin-bottom: var(--hz-space-4);
  border: 1px solid var(--hz-rule-frame);
  border-radius: var(--hz-radius-pane);
}

.hz-state__pane::before,
.hz-state__pane::after {
  content: '';
  position: absolute;
  background: var(--hz-rule);
}

.hz-state__pane::before {
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1px;
}

.hz-state__pane::after {
  top: 55%;
  right: 0;
  left: 0;
  height: 1px;
}

.hz-state__text {
  font-size: var(--hz-font-md);
}

.hz-state__detail {
  margin-top: var(--hz-space-2);
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-state__action {
  width: 120px;
  margin-top: var(--hz-space-3);
}
