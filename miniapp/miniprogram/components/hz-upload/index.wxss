/* TDesign 上传只改主题变量；添加格用 add-content 插槽画虚线框 */
.hz-upload {
  --td-upload-radius: var(--hz-radius-inner);
  --td-upload-background: var(--hz-tint);
  --td-upload-add-bg-color: transparent;
  --td-grid-bg-color: transparent;
  --td-grid-item-bg-color: transparent;
}

.hz-upload__add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  font-size: var(--hz-icon);
  color: var(--hz-brand);
  border: 1px dashed var(--hz-hair);
  border-radius: var(--hz-radius-inner);
}
