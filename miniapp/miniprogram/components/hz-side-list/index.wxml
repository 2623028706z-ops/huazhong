<scroll-view class="hz-side-list" scroll-y>
  <view
    wx:for="{{items}}"
    wx:key="id"
    class="hz-side-list__item {{item.id === value ? 'hz-side-list__item--on' : ''}}"
    data-key="{{item.id}}"
    bindtap="onTap"
  >
    <text>{{item.name}}</text>
    <text wx:if="{{item.sub}}" class="hz-side-list__sub">{{item.sub}}</text>
  </view>
</scroll-view>
