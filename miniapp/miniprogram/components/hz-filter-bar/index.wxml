<view class="hz-filter-bar">
  <view wx:if="{{searchPlaceholder}}" class="hz-filter-bar__search">
    <view class="hz-filter-bar__search-box">
      <hz-search value="{{value.keyword}}" placeholder="{{searchPlaceholder}}" bind:search="onSearch" />
    </view>

  </view>

  <view wx:if="{{sections.length > 1 || tabs.length > 1 || hasFilter}}" class="hz-filter-bar__tabs">
    <scroll-view class="hz-filter-bar__scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view wx:if="{{sections.length}}" class="hz-filter-bar__track">
        <view
          wx:for="{{sections}}"
          wx:key="key"
          class="hz-filter-bar__tab {{item.key === section ? 'hz-filter-bar__tab--on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onSection"
        >
          <text>{{item.text}}</text>
          <text wx:if="{{item.count}}" class="u-count">{{format.formatCount(item.count)}}</text>
        </view>
      </view>
      <view wx:else class="hz-filter-bar__track">
        <view
          wx:for="{{tabs}}"
          wx:key="code"
          class="hz-filter-bar__tab {{item.code === value.status ? 'hz-filter-bar__tab--on' : ''}}"
          data-index="{{index}}"
          bindtap="onTab"
        >
          <text>{{item.text}}</text>
          <text wx:if="{{item.showCount}}" class="u-count">{{format.formatCount(item.count)}}</text>
        </view>
      </view>
    </scroll-view>
    <view
      wx:if="{{hasFilter}}"
      class="hz-filter-bar__button hz-filter-bar__button--bare {{dot?'hz-filter-bar__button--active':''}}"
      bindtap="onOpen"
    >
      <text class="hz-filter-bar__label">{{filterText}}</text>
      <text wx:if="{{filterCount}}">{{filterCount}}</text><text class="hz-icon hz-icon--sliders-horizontal"></text>
    </view>
  </view>

  <view
    wx:if="{{chips.length > 0}}"
    class="hz-filter-bar__chips"
  >
    <view class="hz-filter-bar__chip-list">
      <view wx:for="{{chips}}" wx:key="key" class="hz-filter-bar__chip">
        <text>{{item.text}}</text>
        <view class="hz-filter-bar__chip-x u-tap" data-key="{{item.key}}" bindtap="onRemoveChip">
          <text class="hz-icon hz-icon--x"></text>
        </view>
      </view>
      <hz-button wx:if="{{chips.length > 0}}" kind="text" text="{{clearText}}" bind:press="onClear" />
    </view>

  </view>
</view>

<hz-sheet
  show="{{show}}"
  title="{{view === 'pick' ? pickTitle : title}}"
  back="{{view === 'pick'}}"
  bind:close="onClose"
  bind:back="onBack"
>
  <block wx:if="{{view === 'main'}}">
    <view wx:if="{{dateLabel}}" class="u-sheet-section">
      <view class="u-caption">{{dateLabel}}</view>
      <view class="hz-filter-bar__segments">
        <view
          wx:for="{{segments}}"
          wx:key="key"
          class="hz-filter-bar__segment {{item.key === active ? 'hz-filter-bar__segment--on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onPreset"
        >
          {{item.text}}
        </view>
      </view>
      <view wx:if="{{active === 'custom'}}" class="hz-filter-bar__range">
        <view class="hz-filter-bar__range-item">
          <hz-picker label="{{fromLabel}}" mode="date" value="{{draftFrom}}" end="{{draftTo}}" bind:change="onDraftFrom" />
        </view>
        <view class="hz-filter-bar__range-item">
          <hz-picker label="{{toLabel}}" mode="date" value="{{draftTo}}" start="{{draftFrom}}" bind:change="onDraftTo" />
        </view>
      </view>
    </view>
    <view
      wx:for="{{rows}}"
      wx:key="key"
      class="u-sheet-section hz-filter-bar__row"
      data-key="{{item.key}}"
      bindtap="onDimension"
    >
      <text>{{item.label}}</text>
      <view class="hz-filter-bar__row-value">
        <text>{{item.text}}</text>
        <text class="hz-icon hz-icon--chevron-right"></text>
      </view>
    </view>
  </block>
  <block wx:else>
    <view class="u-sheet-section">
      <hz-search paper placeholder="{{pickSearch}}" bind:search="onPickSearch" />
    </view>
    <view class="u-sheet-section">
      <view
        wx:for="{{options}}"
        wx:key="id"
        class="u-choice {{item.picked ? 'u-choice--on' : ''}}"
        data-key="{{item.id}}"
        bindtap="onPick"
      >
        <text>{{item.name}}</text>
        <text wx:if="{{item.picked}}" class="hz-icon hz-icon--check u-choice__check"></text>
      </view>
    </view>
  </block>
</hz-sheet>
<wxs src="../../core/format.wxs" module="format" />
