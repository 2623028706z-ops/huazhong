/* 和下面的内容隔 --hz-gap-controls：列表本身已有 --hz-card-gap，这里补上差值 */
.hz-filter-bar {
  display: flex;
  flex-direction: column;
  gap: var(--hz-space-2);
  margin-bottom: calc(var(--hz-gap-controls) - var(--hz-card-gap));
}

.hz-filter-bar__search {
  display: flex;
  gap: var(--hz-space-2);
  align-items: center;
}

/* 搜索框的宿主节点在 flex 行里会按内容收缩，套一层拉满 */
.hz-filter-bar__search-box {
  flex: 1;
  min-width: 0;
}

/* 筛选按钮 44×44、卡片底；在标签行里时透明底、44×40 */
.hz-filter-bar__button {
  position: relative;
  display: flex;
  flex: none;
  gap: var(--hz-space-1);
  align-items: center;
  justify-content: flex-end;
  min-width: var(--hz-tap);
  height: var(--hz-tap);
  padding-left: var(--hz-space-3);
  font-size: var(--hz-font-row);
  color: var(--hz-ink);
}

.hz-filter-bar__button--bare {
  height: var(--hz-tap);
}

.hz-filter-bar__dot {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 6px;
  height: 6px;
  background: var(--hz-brand);
  border-radius: 50%;
}

/* 状态标签行：没有外框、没有底线，两端不留内边距；高 44px（点击区域）；「筛选」在最右 */
.hz-filter-bar__tabs {
  display: flex;
  align-items: stretch;
  height: var(--hz-tap);
}

.hz-filter-bar__scroll {
  flex: 1;
  min-width: 0;
  height: var(--hz-tap);
  white-space: nowrap;
}

.hz-filter-bar__track {
  display: inline-flex;
  gap: var(--hz-space-5);
  padding-left: var(--hz-space-1);
  height: var(--hz-tap);
}

.hz-filter-bar__tab {
  position: relative;
  display: flex;
  align-items: center;
  height: var(--hz-tap);
  font-size: var(--hz-font);
  color: var(--hz-muted);
  white-space: nowrap;
}

.hz-filter-bar__tab--on {
  font-weight: 600;
  color: var(--hz-ink);
}

.hz-filter-bar__tab--on::after {
  position: absolute;
  bottom: 4px;
  left: 50%;
  width: 18px;
  height: 2px;
  margin-left: -9px; /* 负值：短线宽的一半，用来居中，不是间距 */
  content: '';
  background: var(--hz-brand);
  border-radius: var(--hz-radius-line);
}

/* 条件胶囊：高 28px、亮格底、细线，× 的点击区域 44px */
.hz-filter-bar__chips {
  display: flex;
  gap: var(--hz-space-2);
  align-items: center;
}

.hz-filter-bar__chip-list {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  gap: var(--hz-space-2);
  align-items: center;
  min-width: 0;
}

.hz-filter-bar__chip {
  display: flex;
  align-items: center;
  height: 28px;
  padding-left: var(--hz-space-2);
  font-size: var(--hz-font-sm);
  color: var(--hz-ink);
  background: var(--hz-paper);
  border-radius: var(--hz-radius-pill);
  box-shadow: inset 0 0 0 1px var(--hz-hair);
}

.hz-filter-bar__chip-x {
  margin: -8px -8px -8px -12px; /* 负值：× 的点击区外扩，不撑高胶囊 */
  font-size: var(--hz-icon-xs);
  color: var(--hz-muted);
}

/* 弹层：日期窗格分段 */
.hz-filter-bar__segments {
  display: flex;
  padding: var(--hz-space-1);
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
  border-radius: var(--hz-radius);
  box-shadow: inset 0 0 0 1px var(--hz-hair);
}

.hz-filter-bar__segment {
  display: flex;
  flex: 1 1 auto;
  align-items: center;
  justify-content: center;
  height: var(--hz-tap);
  padding: 0 var(--hz-space-2);
  white-space: nowrap;
  border-radius: var(--hz-radius-inner);
}

.hz-filter-bar__segment--on {
  font-weight: 600;
  color: var(--hz-ink);
  background: var(--hz-paper);
  box-shadow: inset 0 -2px 0 var(--hz-brand);
}

.hz-filter-bar__range {
  display: flex;
  gap: var(--hz-space-2);
  margin-top: var(--hz-row-pad);
}

.hz-filter-bar__range-item {
  flex: 1;
  min-width: 0;
}

.hz-filter-bar__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hz-tap);
  padding-top: 0;
  padding-bottom: 0;
  font-size: var(--hz-font);
}

.hz-filter-bar__row-value {
  display: flex;
  gap: var(--hz-space-1);
  align-items: center;
  color: var(--hz-muted);
}

.hz-filter-bar__button--active {
  font-weight: 600;
  color: var(--hz-brand);
}
