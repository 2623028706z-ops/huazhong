.hz-progress {
  display: flex;
  align-items: flex-start;
  padding: 10px 6px 4px;
}

.hz-progress__step {
  position: relative;
  flex: 1;
  text-align: center;
  color: var(--hz-muted);
  font-size: var(--hz-font-sm);
}

/* 定稿 .steps：13 圆点、1.5 连线，字 12、日期 11；已走过墨色、当前品牌色加粗 */
.hz-progress__step::before {
  position: absolute;
  top: 6px;
  left: -50%;
  width: 100%;
  height: 1.5px;
  content: '';
  background: var(--hz-rule);
}

.hz-progress__step:first-child::before {
  display: none;
}

.hz-progress__dot {
  position: relative;
  box-sizing: border-box;
  width: 13px;
  height: 13px;
  margin: 0 auto 7px;
  background: var(--hz-bg);
  border: 1.5px solid var(--hz-hair);
  border-radius: 50%;
}

/* 已走过：墨色圆点和连线，字深色；当前：品牌色空心点 + 光圈，字品牌色（红色只给当前这一步）；
   流程走完时最后一格也是「已走过」；没走到：灰；取消、作废：灰色终点（2026-10-05） */
.hz-progress__step--done .hz-progress__dot {
  background: var(--hz-ink);
  border-color: var(--hz-ink);
}

.hz-progress__step--done::before,
.hz-progress__step--current::before {
  background: var(--hz-ink);
}

.hz-progress__step--done {
  color: var(--hz-ink);
  font-weight: 500;
}

.hz-progress__step--current {
  color: var(--hz-brand);
  font-weight: 700;
}

.hz-progress__step--pending {
  color: var(--hz-muted);
  opacity: 0.7;
}

.hz-progress__step--ended {
  color: var(--hz-muted);
  font-weight: 700;
}

.hz-progress__step--ended .hz-progress__dot {
  background: var(--hz-grey-bg);
  border-color: var(--hz-muted);
}

.hz-progress__label {
  display: block;
}

.hz-progress__date {
  display: block;
  white-space: nowrap;
  margin-top: 2px;
  font-size: var(--hz-font-xs);
  font-weight: 400;
  color: var(--hz-muted);
}

.hz-progress__step--current .hz-progress__dot {
  background: var(--hz-paper);
  border-color: var(--hz-brand);
  box-shadow: 0 0 0 3px var(--hz-tint);
}
