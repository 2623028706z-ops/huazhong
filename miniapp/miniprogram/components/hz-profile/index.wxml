<view class="hz-profile"><text class="hz-profile__name u-serif">{{name}}</text><text class="hz-profile__sub">{{sub}}</text><view class="hz-profile__phone"><text>{{texts.loginPhone}}</text><text>{{phone}}</text></view><hz-entry-grid wx:if="{{menus.length}}" entries="{{menus}}" bind:select="onSelect" /><hz-button wx:if="{{external}}" kind="secondary" text="{{texts.contact}}" disabled="{{!contactPhone}}" reason="{{!contactPhone?texts.missing:''}}" bind:press="onContact" /></view><view class="hz-profile__logout"><hz-button kind="secondary" text="{{texts.logout}}" bind:press="onLogout" /></view>
