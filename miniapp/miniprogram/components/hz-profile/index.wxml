<view class="hz-profile"><text class="hz-profile__name u-serif">{{name}}</text><text class="hz-profile__sub">{{sub + separator + phone}}</text><hz-entry-grid wx:if="{{entries.length}}" entries="{{entries}}" bind:select="onSelect" /></view><view class="hz-profile__logout"><hz-button kind="secondary" text="{{texts.logout}}" bind:press="onLogout" /></view><view wx:if="{{devMenus.length}}" class="hz-profile__dev"><hz-entry-grid entries="{{devMenus}}" compact bind:select="onSelect" /></view>
