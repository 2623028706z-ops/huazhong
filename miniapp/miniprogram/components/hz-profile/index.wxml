<view class="hz-profile"><text class="hz-profile__name u-serif">{{name}}</text><view class="hz-profile__lines"><view wx:for="{{lines}}" wx:for-item="line" wx:key="key" class="hz-profile__line"><text wx:for="{{line.fields}}" wx:key="label" class="hz-profile__field">{{item.label}} <text class="hz-profile__value">{{item.value}}</text></text></view></view><slot /><hz-entry-grid wx:if="{{entries.length}}" entries="{{entries}}" bind:select="onSelect" /></view><view class="hz-profile__logout"><text class="hz-profile__logout-text u-tap" bindtap="onLogout">{{texts.logout}}</text></view><view wx:if="{{devMenus.length}}" class="hz-profile__dev"><hz-entry-grid entries="{{devMenus}}" compact bind:select="onSelect" /></view>
