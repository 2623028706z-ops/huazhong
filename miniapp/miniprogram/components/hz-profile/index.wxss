.hz-profile {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.hz-profile__name {
  font-size: var(--hz-font-hero);
  font-weight: 600;
}

.hz-profile__sub {
  font-size: var(--hz-font);
  color: var(--hz-muted);
}

.hz-profile__logout {
  margin-top: 24px;
}

.hz-profile__dev {
  margin-top: 16px;
}
