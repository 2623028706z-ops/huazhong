.hz-profile {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.hz-profile__name {
  font-size: var(--hz-font-hero);
  font-weight: 600;
}

.hz-profile__lines {
  display: flex;
  flex-direction: column;
  gap: var(--hz-line-gap);
}

/* 字段名次要色、值墨色；同一行字段之间两个全角空格的距离 */
.hz-profile__line {
  display: flex;
  flex-wrap: wrap;
  column-gap: var(--hz-gap-page);
  font-size: var(--hz-font);
  color: var(--hz-muted);
}

.hz-profile__value {
  color: var(--hz-ink);
}

/* 退出登录：页面最下面居中灰字，不用整行描边按钮（比上面的入口还抢眼，2026-10-05） */
.hz-profile__logout {
  display: flex;
  justify-content: center;
  margin-top: 24px;
}

.hz-profile__logout-text {
  display: flex;
  align-items: center;
  padding: 0 var(--hz-row-pad);
  font-size: var(--hz-font);
  color: var(--hz-muted);
}

.hz-profile__dev {
  margin-top: 16px;
}
