.hz-profile {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.hz-profile__name {
  font-size: var(--hz-font-hero);
  font-weight: 600;
}

.hz-profile__sub {
  font-size: var(--hz-font);
  color: var(--hz-muted);
}

.hz-profile__phone {
  display: flex;
  justify-content: space-between;
  font-size: var(--hz-font);
  padding-bottom: 16px;
  border-bottom: 1px solid var(--hz-rule);
}

.hz-profile__phone > text:first-child {
  color: var(--hz-muted);
}

.hz-profile__logout {
  margin-top: 24px;
}
