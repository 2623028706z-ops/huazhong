.hz-error {
  display: flex;
  gap: var(--hz-space-2);
  align-items: center;
  padding: var(--hz-space-2) var(--hz-card-pad);
  font-size: var(--hz-font);
  color: var(--hz-danger);
  background: var(--hz-danger-bg);
  border-radius: var(--hz-radius);
  box-shadow: inset 2px 0 0 var(--hz-danger);
}

.hz-error__main {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.hz-error__request {
  margin-top: var(--hz-space-1);
  font-size: var(--hz-font-xs);
}

/* 文字按钮的 44px 点击区域不撑高提示条 */
.hz-error__retry {
  margin: -10px -8px; /* 负值：文字按钮 44px 点击区不撑高提示条 */
}
