/* 弹层本身透明，框由 hz-confirm__box 画 */
.hz-confirm {
  --td-popup-bg-color: transparent;
}

.hz-confirm__box {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: 300px;
  padding: var(--hz-space-5) var(--hz-space-4) var(--hz-space-4);
  text-align: center;
  background: var(--hz-paper);
  border-radius: var(--hz-radius-sheet);
}

.hz-confirm__title {
  font-size: var(--hz-font-lg);
}

.hz-confirm__body {
  margin: var(--hz-space-2) 0 var(--hz-space-4);
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
  white-space: pre-line;
}

.hz-confirm__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--hz-space-2);
}
