.hz-tag {
  color: var(--hz-grey);
  background: var(--hz-grey-bg);
}

/* 异常标记（改价、少发、多收、拒收、取消申请中）：暖红褐，和琥珀色的「待办」状态分开（2026-10-05） */
.hz-tag--warn {
  color: var(--hz-alert);
  background: var(--hz-alert-bg);
}

.hz-tag--danger {
  color: var(--hz-danger);
  background: var(--hz-danger-bg);
}

.hz-tag--done {
  color: var(--hz-green);
  background: var(--hz-green-bg);
}
