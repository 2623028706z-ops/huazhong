.hz-tag {
  color: var(--hz-grey);
  background: var(--hz-grey-bg);
}

.hz-tag--warn {
  color: var(--hz-amber);
  background: var(--hz-amber-bg);
}

.hz-tag--danger {
  color: var(--hz-danger);
  background: var(--hz-danger-bg);
}

.hz-tag--done {
  color: var(--hz-green);
  background: var(--hz-green-bg);
}
