/* TDesign 搜索框只改主题变量；外面一圈细线（定稿 .search .box：高 38、细线、按钮圆角） */
.hz-search {
  --td-search-height: 36px;
  --td-search-bg-color: var(--hz-paper);
  --td-search-square-radius: var(--hz-radius-button);
  --td-search-text-color: var(--hz-ink);
  --td-search-placeholder-color: var(--hz-muted);
  --td-search-icon-color: var(--hz-muted);
  --td-search-clear-icon-color: var(--hz-muted);
  --td-search-font: var(--hz-font) / 1.5 var(--td-font-family);
  --td-search-padding: 0;

  flex: 1;
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--hz-hair);
  border-radius: var(--hz-radius-button);
}

.hz-search--paper {
  --td-search-bg-color: var(--hz-bg);
}

.hz-search__icon {
  margin-right: var(--hz-space-2);
  font-size: var(--hz-icon);
  color: var(--hz-muted);
}
