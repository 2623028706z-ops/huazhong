.hz-card {
  display: flex;
  flex-direction: column;
  gap: var(--hz-line-gap);
  padding: 14px var(--hz-card-pad);
}

.hz-card__row {
  display: flex;
  gap: 8px;
  align-items: center;
}

.hz-card__row--head {
  justify-content: space-between;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-card__title {
  flex: 1;
  font-size: var(--hz-font-md);
  font-weight: 500;
}

.hz-card__total {
  flex: none;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-card__total--key {
  font-size: var(--hz-font-md);
  font-weight: 600;
  color: var(--hz-ink);
}

.hz-card__total--gain {
  color: var(--hz-green);
}

.hz-card__total--loss {
  color: var(--hz-danger);
}

.hz-card__row--foot {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-card__amount {
  flex: none;
  margin-left: auto;
  font-size: var(--hz-font-md);
  font-weight: 600;
  color: var(--hz-ink);
}
