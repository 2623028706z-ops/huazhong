.hz-card {
  padding: var(--hz-card-pad-y) var(--hz-card-pad);
}

.hz-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--hz-space-2);
  padding-bottom: var(--hz-space-2);
  border-bottom: 1px solid var(--hz-line);
}

.hz-card__title {
  flex: 1;
  min-width: 0;
  font-size: var(--hz-font-md);
  font-weight: 600;
}

/* 抬头右边的提醒（往来账「未结清 n 张」）：琥珀小标签，同状态标签 */
.hz-card__status {
  color: var(--hz-amber);
  background: var(--hz-amber-bg);
}

/* 字段左右一行：字段名固定 4 字宽、值紧跟（02 章卡片写法）；两列并排，wide 占整行。
   左列放单号、日期，比右列宽（定稿 164px : 其余，约 1.25 : 1），值不换行（定稿 .kv nowrap），太长省略 */
.hz-card__fields {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(140px, auto);
  gap: var(--hz-space-1) var(--hz-space-2);
  align-items: baseline;
  margin-top: var(--hz-space-2);
}

.hz-card__field {
  display: flex;
  align-items: baseline;
  gap: var(--hz-line-gap);
  min-width: 0;
  font-size: var(--hz-font-row);
  line-height: 26px;
}

.hz-card__field--wide {
  grid-column: 1 / -1;
}

.hz-card__label {
  flex: none;
  width: var(--hz-label-w);
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
  white-space: nowrap;
}

.hz-card__value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hz-card__field--wide .hz-card__value {
  overflow-wrap: anywhere;
  white-space: normal;
}

.hz-card__amount {
  font-size: var(--hz-font-md);
  font-weight: 600;
  color: var(--hz-ink);
}

.hz-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--hz-space-2);
  margin-top: var(--hz-space-2);
}

.hz-card__check {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  margin: -6px 0 -6px -6px; /* 负值：32px 勾选点击区外扩，不撑高行 */
}

.hz-card__value--good {
  color: var(--hz-green);
}

.hz-card__field--minor .hz-card__value {
  font-size: var(--hz-font-sm);
  color: var(--hz-ink-soft);
}

/* 金额是 0：退成次要色、不加粗，有数的金额才显眼（2026-10-05） */
.hz-card__value--zero,
.hz-card__amount.hz-card__value--zero {
  font-weight: 400;
  color: var(--hz-muted);
}

/* 新样式（对照稿 batch4 .rc）：左大字 + 小字，右状态 / 金额；约 80px 高 */
.hz-card--rc {
  display: flex;
  gap: var(--hz-space-3);
  align-items: flex-start;
}

.hz-card__check--rc {
  margin: -6px; /* 负值：32px 勾选点击区外扩，不撑高行 */
}

.hz-card__main {
  flex: 1;
  min-width: 0;
}

.hz-card__big {
  display: flex;
  gap: var(--hz-space-2);
  align-items: center;
  overflow: hidden;
  font-size: var(--hz-font-md);
  font-weight: 600;
  line-height: 24px;
  color: var(--hz-ink);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hz-card__big--serif {
  font-family: var(--hz-serif);
  font-size: var(--hz-font-lg);
  font-weight: 400;
}

/* 门店没看过的结果：标题前小红点 */
.hz-card__dot {
  flex: none;
  width: 8px;
  height: 8px;
  background: var(--hz-brand);
  border-radius: var(--hz-radius-pill);
}

.hz-card__sub {
  display: block;
  margin-top: var(--hz-space-1);
  overflow: hidden;
  font-size: var(--hz-font-row);
  color: var(--hz-muted);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hz-card__side {
  display: flex;
  flex: none;
  flex-direction: column;
  gap: var(--hz-space-1);
  align-items: flex-end;
  max-width: 50%;
  text-align: right;
}

.hz-card__side-text {
  font-size: var(--hz-font-row);
  color: var(--hz-ink);
  white-space: nowrap;
}

.hz-card__side-text--late {
  color: var(--hz-alert);
}

.hz-card__money {
  font-size: var(--hz-font-lg);
  color: var(--hz-ink);
  white-space: nowrap;
}

.hz-card__note {
  font-size: var(--hz-font-xs);
  color: var(--hz-muted);
  white-space: nowrap;
}
