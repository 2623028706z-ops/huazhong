.hz-card {
  padding: 14px var(--hz-card-pad);
}

.hz-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--hz-line);
}

.hz-card__title {
  flex: 1;
  min-width: 0;
  font-size: var(--hz-font-md);
  font-weight: 600;
}

/* 抬头右边的提醒（往来账「未结清 n 张」）：琥珀小标签，同状态标签 */
.hz-card__status {
  color: var(--hz-amber);
  background: var(--hz-amber-bg);
}

/* 字段左右一行：字段名固定 4 字宽、值紧跟（02 章卡片写法）；两列并排，wide 占整行。
   左列放单号、日期，比右列宽（定稿 164px : 其余，约 1.25 : 1），值不换行（定稿 .kv nowrap），太长省略 */
.hz-card__fields {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
  gap: 2px 14px;
  margin-top: 8px;
}

.hz-card__field {
  display: flex;
  align-items: baseline;
  gap: 8px;
  min-width: 0;
  font-size: var(--hz-font-row);
  line-height: 26px;
}

.hz-card__field--wide {
  grid-column: 1 / -1;
}

.hz-card__label {
  flex: none;
  width: 4em;
  color: var(--hz-muted);
  white-space: nowrap;
}

.hz-card__value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hz-card__field--wide .hz-card__value {
  overflow-wrap: anywhere;
  white-space: normal;
}

.hz-card__amount {
  font-size: var(--hz-font);
  font-weight: 700;
  color: var(--hz-ink);
}

.hz-card__tags {
  display: flex;
  gap: 8px;
  margin-top: 8px;
}

.hz-card__check {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  margin: -6px 0 -6px -6px;
}

.hz-card__value--good {
  color: var(--hz-green);
}
