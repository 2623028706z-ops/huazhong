<wxs src="../../core/format.wxs" module="format" />
<view class="u-card hz-card" bindtap="onTap">
  <view class="hz-card__row hz-card__row--head">
    <text wx:if="{{date && today}}">{{format.formatCardDate(date, today)}}</text>
    <hz-status kind="{{statusKind}}" code="{{status}}" />
  </view>
  <view class="hz-card__row">
    <text class="hz-card__title u-ellipsis">{{title}}</text>
    <text class="hz-card__total">{{total}}</text>
  </view>
  <view class="hz-card__row hz-card__row--foot">
    <hz-tag wx:for="{{tags}}" wx:key="text" text="{{item.text}}" warn="{{item.warn}}" />
    <text class="u-ellipsis">{{meta}}</text>
    <text wx:if="{{amount !== null}}" class="hz-card__amount u-serif-amount">{{format.formatMoney(amount)}}</text>
  </view>
</view>
