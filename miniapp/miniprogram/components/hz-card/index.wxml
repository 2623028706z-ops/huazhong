<!-- 列表卡新样式（row.main，views/card.ts 的 CardRow）：左边大字 + 小字，右边状态 / 金额 -->
<view wx:if="{{row.main}}" class="u-card hz-card hz-card--rc" bindtap="onTap">
  <view wx:if="{{selectable}}" class="hz-card__check hz-card__check--rc" catchtap="onToggle"><view class="u-check {{selected ? 'u-check--on' : ''}}"><text wx:if="{{selected}}" class="hz-icon hz-icon--check"></text></view></view>
  <view class="hz-card__main">
    <view class="hz-card__big {{row.serif ? 'hz-card__big--serif' : ''}}"><text wx:if="{{row.dot}}" class="hz-card__dot"></text><text>{{row.main}}</text></view>
    <text wx:if="{{row.sub}}" class="hz-card__sub">{{row.sub}}</text>
    <view wx:if="{{row.tags.length}}" class="hz-card__tags"><hz-tag wx:for="{{row.tags}}" wx:key="text" text="{{item.text}}" warn="{{item.warn}}" danger="{{item.danger}}" /></view>
  </view>
  <view wx:if="{{row.status || row.side || row.amount || row.note}}" class="hz-card__side">
    <hz-status wx:if="{{row.status}}" kind="{{statusKind}}" code="{{row.status}}" />
    <text wx:if="{{row.side}}" class="hz-card__side-text {{row.late ? 'hz-card__side-text--late' : ''}}">{{row.side}}</text>
    <text wx:if="{{row.amount}}" class="u-serif-amount hz-card__money">{{row.amount}}</text>
    <text wx:if="{{row.note}}" class="hz-card__note">{{row.note}}</text>
  </view>
</view>
<!-- 字段式（行式列表以外还没换新样式的） -->
<view wx:else class="u-card hz-card" bindtap="onTap">
  <view class="hz-card__head"><view wx:if="{{selectable}}" class="hz-card__check" catchtap="onToggle"><view class="u-check {{selected ? 'u-check--on' : ''}}"><text wx:if="{{selected}}" class="hz-icon hz-icon--check"></text></view></view><text class="hz-card__title">{{row.title}}</text><text wx:if="{{row.headText}}" class="u-pill hz-card__status">{{row.headText}}</text><hz-status wx:elif="{{row.status}}" kind="{{statusKind}}" code="{{row.status}}" /></view>
  <view class="hz-card__fields"><view wx:for="{{row.fields}}" wx:key="label" class="hz-card__field {{item.wide ? 'hz-card__field--wide' : ''}} {{item.minor || minorSet[item.label] ? 'hz-card__field--minor' : ''}}"><text class="hz-card__label">{{item.label}}</text><text wx:if="{{item.phone}}" class="hz-card__value u-link" data-phone="{{item.phone}}" catchtap="onPhone">{{item.value}}</text><text wx:else class="hz-card__value {{item.amount ? 'u-serif-amount hz-card__amount' : ''}} {{item.good ? 'hz-card__value--good' : ''}} {{item.value === '¥0.00' ? 'hz-card__value--zero' : ''}}">{{item.value}}</text></view></view>
  <view wx:if="{{row.tags.length}}" class="hz-card__tags"><hz-tag wx:for="{{row.tags}}" wx:key="text" text="{{item.text}}" warn="{{item.warn}}" danger="{{item.danger}}" /></view>
</view>
