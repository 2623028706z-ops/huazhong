<wxs src="../../core/format.wxs" module="format" />
<view wx:if="{{mode !== 'after'}}" class="u-card hz-line-item__table {{mode !== 'view' ? 'hz-line-item__table--edit' : ''}}">
  <view class="hz-line-item__tr hz-line-item__tr--head {{quantityOnly ? (lines[0].orderedQty !== undefined ? 'hz-line-item__tr--actual' : 'hz-line-item__tr--qty') : (lines[0].purchaseQty !== undefined ? 'hz-line-item__tr--received' : 'hz-line-item__tr--price')}}">
    <text class="hz-line-item__name">{{title || texts.lines}}<text wx:if="{{picking}}" class="hz-line-item__meta"> {{packedText}}</text></text>
    <text wx:if="{{lines[0].purchaseQty !== undefined}}">{{texts.purchaseQty}}</text><text>{{qtyLabel || texts.qty}}</text><text wx:if="{{quantityOnly && lines[0].orderedQty !== undefined}}">{{texts.actual}}</text><text>{{texts.unit}}</text>
    <block wx:if="{{!quantityOnly}}"><text>{{texts.price}}</text><text>{{texts.subtotal}}</text></block>
  </view>
  <view wx:for="{{lines}}" wx:key="key" class="hz-line-item__row" data-index="{{index}}" bindtap="onEdit"><text wx:if="{{mode !== 'view' && !item.readonly}}" class="hz-icon hz-icon--chevron-right hz-line-item__go"></text>
    <view class="hz-line-item__tr {{quantityOnly ? (lines[0].orderedQty !== undefined ? 'hz-line-item__tr--actual' : 'hz-line-item__tr--qty') : (lines[0].purchaseQty !== undefined ? 'hz-line-item__tr--received' : 'hz-line-item__tr--price')}}">
      <view class="hz-line-item__name"><view wx:if="{{picking}}" class="hz-line-item__check" data-index="{{index}}" catchtap="onPacked"><view class="u-check {{item.packed ? 'u-check--on' : ''}}"><text wx:if="{{item.packed}}" class="hz-icon hz-icon--check"></text></view></view><text>{{item.name}}</text></view>
      <text wx:if="{{item.purchaseQty !== undefined}}">{{item.purchaseQty}}</text><text>{{item.orderedQty === undefined ? item.qty : item.orderedQty}}</text><text wx:if="{{quantityOnly && item.orderedQty !== undefined}}">{{item.qty}}</text><text>{{item.unit}}</text>
      <block wx:if="{{!quantityOnly}}"><text>{{item.hideAmount ? '—' : format.formatMoney(item.priceCents)}}</text><text>{{item.hideAmount ? '—' : format.formatMoney(item.amountCents)}}</text></block>
    </view>
    <view wx:if="{{item.code || item.meta || item.tags.length}}" class="hz-line-item__sub">
      <text wx:if="{{item.code}}"><text class="hz-line-item__code-label">{{material ? texts.materialCode : texts.customerCode}}</text>{{item.code}}</text><text wx:if="{{item.meta}}">{{item.meta}}</text>
      <hz-tag wx:for="{{item.tags}}" wx:for-item="tag" wx:key="text" text="{{tag.text}}" warn="{{tag.warn}}" />
    </view>
<hz-button wx:if="{{mode==='view' && removable && item.removable}}" kind="text" text="{{texts.remove}}" data-index="{{index}}" catch:press="onRemoveRead" />
    <hz-notice wx:if="{{item.notice}}" text="{{item.notice}}" />
    <text wx:if="{{item.qtyError || item.priceError}}" class="u-field__error">{{item.qtyError || item.priceError}}</text>
  </view>
  <view wx:if="{{note}}" class="hz-line-item__note"><text>{{noteLabel}}</text><text>{{note}}</text></view>
  <view wx:if="{{addText}}" class="hz-line-item__add u-tap" bindtap="onAdd"><text class="hz-icon hz-icon--plus"></text><text>{{addText}}</text></view>
  <view class="hz-line-item__totals"><view class="hz-line-item__total"><text class="hz-line-item__total-label">{{texts.totalQty}}</text><text class="hz-line-item__total-qty">{{totalQty}}</text></view><view wx:if="{{!quantityOnly}}" class="hz-line-item__total hz-line-item__total--amount"><text class="hz-line-item__total-label">{{texts.totalAmount}}</text><text class="hz-line-item__total-amount">{{totalAmount}}</text></view></view>
</view>
<view wx:else>
  <view wx:for="{{lines}}" wx:key="key" class="u-card hz-line-item__after">
    <view class="hz-line-item__head"><text>{{item.name}}</text><view class="hz-line-item__qtys"><text class="hz-line-item__meta">{{item.applied}}</text><text class="hz-line-item__meta">{{item.handled}}</text></view></view>
    <text wx:if="{{item.meta}}" class="hz-line-item__meta">{{item.meta}}</text>
    <view wx:if="{{item.reason}}"><hz-tag text="{{item.reason}}" danger /></view><text wx:if="{{item.description}}">{{item.description}}</text>
    <view wx:if="{{item.images.length}}" class="u-thumbs"><image wx:for="{{item.images}}" wx:for-item="image" wx:key="url" class="u-thumbs__item" src="{{image.thumbUrl}}" mode="aspectFill" data-url="{{image.url}}" data-urls="{{item.urls}}" bindtap="onPreview" /></view>
  </view>
</view>
<hz-sheet show="{{showEditor}}" title="{{activeLine.name}}" center footer bind:close="onClose">
  <view class="u-sheet-form">
    <view class="u-sheet-row"><text>{{quantityOnly && activeLine.orderedQty !== undefined ? texts.actual : texts.qty}}</text><view class="hz-line-item__quantity"><hz-stepper wx:if="{{!quantityReadonly}}" value="{{draftQty}}" min="{{min}}" max="{{activeLine.max === undefined ? maxQty : activeLine.max}}" bind:change="onDraftQty" /><text wx:else>{{draftQty}}</text><text>{{activeLine.unit}}</text></view></view>
    <hz-field wx:if="{{mode === 'price' && !quantityOnly}}" label="{{texts.price}}" type="digit" value="{{draftPrice}}" suffix="{{texts.yuan}}" error="{{priceError}}" bind:change="onDraftPrice" />
    <view wx:if="{{!quantityOnly}}" class="u-sheet-row"><text>{{texts.subtotal}}</text><text class="u-serif-amount">{{draftAmount}}</text></view>
  </view>
  <hz-button wx:if="{{removable}}" slot="footer" kind="secondary" text="{{texts.remove}}" bind:press="onRemove" /><hz-button wx:if="{{rejectText}}" slot="footer" kind="secondary" text="{{rejectText}}" bind:press="onRejectLine" /><hz-button slot="footer" text="{{texts.confirm}}" bind:press="onConfirm" />
</hz-sheet>
