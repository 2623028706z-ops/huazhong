.hz-line-item__table {
  overflow: hidden;
}

/* 明细表（定稿 .tbl / .tr）：左右留 16、列宽 1fr 30 28 54 68、字 13 基线对齐；表头 11 灰字、标题宋体 14 */
.hz-line-item__row,
.hz-line-item__tr--head {
  margin: 0 var(--hz-card-pad);
}

.hz-line-item__tr {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 30px 28px 54px 68px;
  column-gap: 6px;
  align-items: baseline;
  font-size: var(--hz-font-row);
  text-align: right;
  white-space: nowrap;
}

.hz-line-item__row {
  padding: 12px 0;
}

.hz-line-item__tr--price > text:nth-child(3) {
  text-align: center;
  color: var(--hz-muted);
}

.hz-line-item__tr--price > text:last-child {
  font-weight: 600;
}

.hz-line-item__tr--qty {
  grid-template-columns: minmax(130px, 1fr) repeat(2, 48px);
}

.hz-line-item__tr--head {
  padding: 14px 0 8px;
  font-size: var(--hz-font-xs);
  color: var(--hz-muted);
  border-bottom: 1px solid var(--hz-line);
}

.hz-line-item__tr--received {
  grid-template-columns: minmax(0, 1fr) 44px 44px 24px 46px 58px;
  column-gap: 4px;
}

.hz-line-item__tr--received > text:nth-child(4) {
  text-align: center;
  color: var(--hz-muted);
}

.hz-line-item__tr--received > text:last-child {
  font-weight: 600;
}

.hz-line-item__tr--head.hz-line-item__tr--received > text:last-child {
  font-weight: 400;
}

.hz-line-item__tr--head.hz-line-item__tr--price > text:last-child {
  font-weight: 400;
}

.hz-line-item__name {
  display: flex;
  align-items: center;
  text-align: left;
  font-size: var(--hz-font);
  font-weight: 600;
  white-space: normal;
  overflow-wrap: anywhere;
}

.hz-line-item__tr--head .hz-line-item__name {
  font-family: var(--hz-serif);
  font-size: var(--hz-font);
  letter-spacing: 1px;
  color: var(--hz-ink);
}

.hz-line-item__row + .hz-line-item__row {
  border-top: 1px solid var(--hz-line);
}

.hz-line-item__sub {
  display: flex;
  gap: 4px 14px;
  margin-top: 5px;
  color: var(--hz-muted);
  font-size: var(--hz-font-sm);
  flex-wrap: wrap;
}

.hz-line-item__totals {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 14px;
  align-items: baseline;
  padding: var(--hz-card-pad-y) 0;
  margin: 0 var(--hz-card-pad);
  border-top: 1px solid var(--hz-line);
  font-size: var(--hz-font-row);
}

/* 合计（定稿 .tot）：左「合计数量 30 束」15 号；右「合计金额」贴右，金额宋体 19 粗 */
.hz-line-item__total {
  display: flex;
  gap: 8px;
  align-items: baseline;
}

.hz-line-item__total--amount {
  justify-content: flex-end;
}

.hz-line-item__total-label {
  color: var(--hz-muted);
}

.hz-line-item__total-qty,
.hz-line-item__total-amount {
  font-family: var(--hz-serif);
  font-size: var(--hz-font-total);
  font-weight: 700;
  color: var(--hz-ink);
}

.hz-line-item__quantity {
  display: flex;
  gap: 8px;
  align-items: center;
}

.hz-line-item__head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: baseline;
  gap: 10px;
  font-family: var(--hz-serif);
  font-size: var(--hz-font-md);
}

.hz-line-item__after {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: var(--hz-card-pad);
  margin-bottom: var(--hz-card-gap);
}

.hz-line-item__meta {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-line-item__check {
  display: flex;
  margin-right: 8px;
}

.hz-line-item__tr--actual {
  grid-template-columns: minmax(100px, 1fr) repeat(3, 44px);
}

.hz-line-item__note {
  display: flex;
  gap: 12px;
  padding: 10px 0;
  margin: 0 var(--hz-card-pad);
  font-size: var(--hz-font-sm);
  border-top: 1px solid var(--hz-line);
}

.hz-line-item__qtys {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 12px;
  justify-content: flex-end;
}

.hz-line-item__add {
  display: flex;
  gap: 6px;
  align-items: center;
  justify-content: center;
  height: var(--hz-tap);
  margin: 0 var(--hz-card-pad);
  font-size: var(--hz-font);
  color: var(--hz-brand);
  border-top: 1px solid var(--hz-line);
}

.hz-line-item__code-label {
  margin-right: var(--hz-line-gap);
}

/* 能点开改的明细（定稿表单里的表格）：右边留一个「›」 */
.hz-line-item__table--edit .hz-line-item__row,
.hz-line-item__table--edit .hz-line-item__tr--head {
  position: relative;
  padding-right: 14px;
}

.hz-line-item__go {
  position: absolute;
  top: 14px;
  right: -2px;
  width: 16px;
  text-align: center;
  font-size: var(--hz-icon-sm);
  color: var(--hz-muted);
}

/* 可编辑明细还没有行：表头下面放一句提示，免得只剩表头和 0 合计（2026-10-05） */
.hz-line-item__empty {
  padding: 22px var(--hz-card-pad);
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
  text-align: center;
}
