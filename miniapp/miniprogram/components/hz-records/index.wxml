<wxs src="../../core/format.wxs" module="format" />
<view class="u-section">
  <view class="hz-records__toggle" bindtap="onToggle">
    <text class="u-section__title">{{title}}</text>
    <text class="hz-records__count">{{countText}}<text class="hz-icon hz-icon--chevron-right hz-records__arrow {{open ? 'hz-records__arrow--open' : ''}}"></text></text>
  </view>
  <view wx:if="{{open}}" class="u-card hz-records">
    <view wx:for="{{rows}}" wx:key="id" class="hz-records__row">
      <view class="hz-records__who">
        <view class="u-info__line"><text>{{timeLabel}}</text><text>{{format.formatTime(item.at)}}</text></view>
        <view class="u-info__line"><text>{{actorLabel}}</text><text>{{item.actor}}</text></view>
      </view>
      <view class="hz-records__what">
        <text wx:for="{{item.changes}}" wx:for-item="change" wx:key="*this">{{change}}</text>
        <text wx:if="{{item.reasonText}}" class="hz-records__reason">{{item.reasonText}}</text>
      </view>
    </view>
  </view>
</view>
