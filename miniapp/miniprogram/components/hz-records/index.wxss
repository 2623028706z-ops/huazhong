.hz-records {
  padding: 0 var(--hz-card-pad);
}

.hz-records__row {
  display: flex;
  flex-direction: column;
  gap: var(--hz-space-2);
  padding: var(--hz-row-pad) 0;
  font-size: var(--hz-font-sm);
}

.hz-records__row + .hz-records__row {
  border-top: 1px solid var(--hz-line);
}

.hz-records__who {
  display: flex;
  flex-direction: column;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-records__what {
  display: flex;
  flex-direction: column;
}

.hz-records__reason {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-records__toggle {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.hz-records__count {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-records__arrow {
  margin-left: var(--hz-space-1);
  transition: transform 0.2s;
}

.hz-records__arrow--open {
  transform: rotate(90deg);
}
