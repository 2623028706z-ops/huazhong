/* 亮格底，按钮等分、间距 8px，内边距 9px 14px + 安全区 */
.hz-action-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: grid;
  grid-auto-columns: 1fr;
  grid-auto-flow: column;
  gap: 8px;
  align-items: start;
  padding: 9px var(--hz-gap-bar);
  padding-bottom: calc(9px + env(safe-area-inset-bottom));
  background: var(--hz-paper);
}

/* 占住底栏的高度，页面内容不被挡住 */
.hz-action-bar__spacer {
  height: calc(var(--hz-tap) + 18px + env(safe-area-inset-bottom));
}

/* 底栏页：贴在底栏上面 */
.hz-action-bar--tabbar {
  bottom: calc(var(--hz-tabbar) + env(safe-area-inset-bottom));
  padding-bottom: 9px;
}

.hz-action-bar__spacer--tabbar {
  height: calc(var(--hz-tap) + 18px);
}
