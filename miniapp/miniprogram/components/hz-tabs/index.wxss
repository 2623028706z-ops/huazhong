.hz-tabs {
  display: flex;
  gap: var(--hz-gap-controls);
  border-bottom: 1px solid var(--hz-rule);
}

.hz-tabs__item {
  display: flex;
  align-items: center;
  min-height: var(--hz-tap);
  font-size: var(--hz-font-md);
  color: var(--hz-muted);
  border-bottom: 2px solid transparent;
}

.hz-tabs__item--on {
  font-weight: 600;
  color: var(--hz-ink);
  border-bottom-color: var(--hz-brand);
}

.hz-tabs--big {
  gap: var(--hz-space-5);
  padding: var(--hz-space-1) var(--hz-space-1) 0;
  border-bottom: 0;
}

.hz-tabs--big .hz-tabs__item {
  position: relative;
  min-height: 0;
  padding-bottom: var(--hz-space-2);
  font-family: var(--hz-serif);
  font-size: var(--hz-font-total);
  font-weight: 500;
  letter-spacing: 0; /* 02 章：字距一律 0 */
  border-bottom: 0;
}

.hz-tabs--big .hz-tabs__item--on {
  font-weight: 600;
}

.hz-tabs--big .hz-tabs__item--on::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 20px;
  height: 2.5px;
  margin-left: -10px; /* 负值：短线宽的一半，用来居中，不是间距 */
  background: var(--hz-brand);
  border-radius: var(--hz-radius-line);
}
