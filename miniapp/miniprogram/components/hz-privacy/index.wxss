.hz-privacy {
  display: flex;
  gap: var(--hz-space-2);
  align-items: center;
  justify-content: center;
  min-height: var(--hz-tap);
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-privacy--shake {
  animation: hz-shake 0.4s;
}

.hz-privacy__check {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  font-size: var(--hz-font-sm);
  border: 1px solid var(--hz-muted);
  border-radius: 50%;
}

.hz-privacy__check--on {
  color: var(--hz-on-brand);
  background: var(--hz-brand);
  border-color: var(--hz-brand);
}

.hz-privacy__contract {
  color: var(--hz-ink);
  text-decoration: underline;
  text-decoration-color: var(--hz-brand);
}

@keyframes hz-shake {
  25% {
    transform: translateX(-6px);
  }

  75% {
    transform: translateX(6px);
  }
}
