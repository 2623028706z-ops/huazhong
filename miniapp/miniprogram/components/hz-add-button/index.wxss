.hz-add-button {
  display: flex;
  gap: 6px;
  align-items: center;
  justify-content: center;
  height: var(--hz-tap);
  font-size: var(--hz-font);
  font-weight: 600;
  background: var(--hz-paper);
  border: 1px dashed var(--hz-rule-frame);
  border-radius: var(--hz-radius);
}

.hz-add-button__icon {
  font-size: var(--hz-icon);
  color: var(--hz-brand);
}
