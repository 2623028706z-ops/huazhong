/* 明细卡最后一行（02 章 hz-add-button）：细线隔开、居中，陶土红加号 + 陶土红文字；不再用卡片外的虚线框 */
.hz-add-button {
  display: flex;
  gap: var(--hz-space-2);
  align-items: center;
  justify-content: center;
  height: var(--hz-tap);
  font-size: var(--hz-font);
  color: var(--hz-brand);
  border-top: 1px solid var(--hz-line);
}

.hz-add-button__icon {
  font-size: var(--hz-icon);
}
