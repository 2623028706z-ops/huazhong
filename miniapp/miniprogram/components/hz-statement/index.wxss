.hz-statement {
  overflow: hidden;
}

.hz-statement__cells {
  display: grid;
  grid-auto-columns: 1fr;
  grid-auto-flow: column;
  gap: var(--hz-line-gap);
  padding: var(--hz-card-pad) var(--hz-row-pad);
}

/* 只有两格时靠左并排，不撑满 */
.hz-statement__cells--few {
  grid-auto-columns: max-content;
  gap: calc(var(--hz-card-pad) * 2);
  padding-left: var(--hz-card-pad);
}

.hz-statement__cell {
  display: flex;
  flex-direction: column;
  gap: var(--hz-line-gap);
  align-items: center;
}

.hz-statement__label {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-statement__amount {
  font-size: var(--hz-font-md);
  color: var(--hz-ink);
}

.hz-statement__amount--due {
  color: var(--hz-brand);
}

.hz-statement__row {
  display: flex;
  gap: var(--hz-line-gap);
  align-items: baseline;
  padding: var(--hz-row-pad) var(--hz-card-pad);
  font-size: var(--hz-font);
  border-top: 1px solid var(--hz-line);
}

.hz-statement__row .hz-statement__label {
  font-size: var(--hz-font);
}

.hz-statement__value {
  flex: 1;
  text-align: right;
}

/* 行里的金额（多收、多付、期初欠款）和上面格子里的金额同字号 */
.hz-statement__value.u-serif-amount {
  font-size: var(--hz-font-md);
  color: var(--hz-ink);
}
