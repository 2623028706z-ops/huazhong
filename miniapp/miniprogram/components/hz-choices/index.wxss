/* 胶囊高 32px，外面一层点击区域 44px（margin 不算点击区域） */
.hz-choices {
  display: flex;
  flex-wrap: wrap;
  column-gap: var(--hz-space-2);
}

.hz-choices__tap {
  display: flex;
  align-items: center;
  min-height: var(--hz-tap);
}

.hz-choices__item {
  height: 32px;
  padding: 0 var(--hz-space-3);
  font-size: var(--hz-font);
  line-height: 30px;
  color: var(--hz-muted);
  background: var(--hz-paper);
  border: 1px solid var(--hz-hair);
  border-radius: var(--hz-radius-pill);
}

.hz-choices__item--on {
  font-weight: 600;
  color: var(--hz-ink);
  border-color: var(--hz-brand);
}

.hz-choices__item--error {
  border-color: var(--hz-danger);
}
