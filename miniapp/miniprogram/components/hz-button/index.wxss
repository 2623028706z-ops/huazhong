/* TDesign 按钮只改主题变量（02 章第 2 节） */
.hz-button {
  --td-button-medium-height: var(--hz-tap);
  --td-button-border-radius: var(--hz-radius-button);
  --td-button-medium-font: 600 var(--hz-font-md) / 1 var(--td-font-family);
  --td-button-medium-padding-horizontal: var(--hz-row-pad);
  --td-button-primary-bg-color: var(--hz-brand);
  --td-button-primary-border-color: var(--hz-brand);
  --td-button-primary-color: var(--hz-on-brand);
  --td-button-primary-active-bg-color: var(--hz-brand);
  --td-button-primary-active-border-color: var(--hz-brand);

  /* 不能点的主按钮：保留主色调淡（相当于 opacity .4）+ 白字，和次按钮拉开（第 4 批第 3 条，2026-10-06）。
     用半透明底色而不是整颗 opacity，白字不跟着变淡 */
  --td-button-primary-disabled-bg: var(--hz-brand-off);
  --td-button-primary-disabled-border-color: transparent;
  --td-button-primary-disabled-color: var(--hz-on-brand);
  --td-button-default-outline-color: var(--hz-ink);
  --td-button-default-outline-border-color: var(--hz-rule);
  --td-button-default-outline-active-bg-color: var(--hz-paper);
  --td-button-default-outline-active-border-color: var(--hz-rule);
  --td-button-default-outline-disabled-color: var(--hz-muted);
  --td-button-default-disabled-bg: transparent;
  --td-button-default-disabled-border-color: var(--hz-rule);
  --td-button-default-disabled-color: var(--hz-grey);
  --td-bg-color-container: transparent;
}

.hz-button--secondary {
  --td-button-medium-font: 400 var(--hz-font-md) / 1 var(--td-font-family);
}

.hz-button__inner {
  letter-spacing: 0;
}

/* 微信原生 button:not([size=mini]) 默认 184px 宽，优先级高过 TDesign 的 --block，这里拉满 */
.hz-button .hz-button__inner {
  width: 100%;
}

/* 次按钮描边：TDesign 画在原生 button 的 ::after 上，小程序里实测显示不出来，改在按钮本身用内阴影画 */
.hz-button--secondary .hz-button__inner {
  box-shadow: inset 0 0 0 1px var(--hz-rule);
}

.hz-button__spinner {
  width: 14px;
  height: 14px;
  margin-right: var(--hz-space-2);
  border: 2px solid currentcolor;
  border-top-color: transparent;
  border-radius: 50%;
  animation: hz-spin 0.8s linear infinite;
}

@keyframes hz-spin {
  to {
    transform: rotate(360deg);
  }
}

.hz-button__reason {
  margin-top: var(--hz-space-1);
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
  text-align: center;
}

/* 文字按钮：墨色加粗 + 陶土红下划线 */
.hz-button__text {
  display: inline-flex;
  padding: 0 var(--hz-line-gap);
  font-size: var(--hz-font);
  font-weight: 600;
  color: var(--hz-ink);
  text-decoration: underline;
  text-decoration-color: var(--hz-brand);
  text-underline-offset: 4px;
}

/* 页底灰字（第三个操作、少用的危险操作）：灰色、不加粗、无下划线 */

/* 页面最下面的第三个操作：居中、灰字（02 章：第三项操作用灰色），不再贴左挂在卡片外（2026-10-05） */
.hz-button--quiet {
  display: flex;
  justify-content: center;
  padding-top: var(--hz-space-1);
}

.hz-button__text--quiet {
  font-size: var(--hz-font);
  font-weight: 500;
  color: var(--hz-muted);
  text-decoration: underline;
  text-decoration-color: var(--hz-rule);
}

/* 明确可点：文字后接 ›，和灰掉的停用样子分开 */
.hz-button__text--quiet::after {
  margin-left: var(--hz-space-1);
  content: '›';
}

/* 停用的文字操作：灰、无下划线、无箭头 */
.hz-button__text--off,
.hz-button__text--quiet.hz-button__text--off {
  color: var(--hz-muted);
  text-decoration: none;
  opacity: 0.6;
}

.hz-button__text--quiet.hz-button__text--off::after {
  content: '';
}

/* 订货结算条上的主按钮（定稿 .cb .go）：红色胶囊，停用时深底上的灰褐色 */
.hz-button--round {
  --td-button-medium-height: 44px;
  --td-button-border-radius: var(--hz-radius-pill);
  --td-button-medium-padding-horizontal: var(--hz-space-5);
  --td-button-primary-disabled-bg: var(--hz-bar-off);
  --td-button-primary-disabled-border-color: var(--hz-bar-off);
  --td-button-primary-disabled-color: var(--hz-bar-off-text);
}

.hz-button--round .hz-button__inner {
  letter-spacing: 0; /* 02 章：字距一律 0 */
}

/* 停用原因放到结算条上方（定位到结算条），不撑高胶囊 */
.hz-button--round .hz-button__reason {
  position: absolute;
  right: 0;
  bottom: 64px;
  left: 0;
  margin: 0;
  color: var(--hz-amber);
}
