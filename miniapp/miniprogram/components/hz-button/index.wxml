<view class="hz-button hz-button--{{kind}}">
  <view wx:if="{{kind === 'text' || kind === 'quiet'}}" class="hz-button__text {{kind === 'quiet' ? 'hz-button__text--quiet' : ''}} u-tap" bindtap="onTap">{{text}}</view>
  <t-button
    wx:else
    t-class="hz-button__inner"
    theme="{{kind === 'secondary' ? 'default' : 'primary'}}"
    variant="{{kind === 'secondary' ? 'outline' : 'base'}}"
    size="medium"
    block
    disabled="{{disabled || blocked}}"
    open-type="{{openType}}"
    bind:tap="onTap"
    bind:getphonenumber="onPhone"
  >
    <view wx:if="{{spinning}}" class="hz-button__spinner"></view>
    {{loading ? submitting : text}}
  </t-button>
  <view wx:if="{{disabled && reason}}" class="hz-button__reason">{{reason}}</view>
</view>
