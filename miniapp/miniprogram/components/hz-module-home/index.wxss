.hz-module-home {
  display: flex;
  flex-direction: column;
  gap: var(--hz-card-gap);
  padding: var(--hz-row-pad) var(--hz-gap-page);
}

/* 区块标题和卡片左边缘对齐（不再缩进 4px），和「我的」页一致；
   标题贴近自己下面的卡片、和上一块拉开（组间距大于组内距，2026-10-05） */
.hz-module-home .u-section__title {
  padding: 0;
  margin-bottom: -4px; /* 负值：分组标题贴近下面的卡片 */
}

.hz-module-home .u-section__title:not(:first-child) {
  margin-top: var(--hz-space-2);
}

/* 待办小卡：三列，大数字在上、名称在下，右上小箭头 */
.hz-module-home__todos {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--hz-card-gap);
}

.hz-module-home__todo {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--hz-space-1);
  min-width: 0;
  padding: var(--hz-space-3) var(--hz-row-pad) var(--hz-space-3) var(--hz-card-pad);
}

.hz-module-home__arrow {
  position: absolute;
  top: 12px;
  right: 10px;
  font-size: var(--hz-icon-sm);
  color: var(--hz-muted);
}

.hz-module-home__count {
  font-family: var(--hz-serif);
  font-size: var(--hz-font-todo);
  font-weight: 700;
  line-height: 1.2;
  color: var(--hz-brand);
}

.hz-module-home__count--zero {
  font-weight: 400;
  color: var(--hz-muted);
}

.hz-module-home__label {
  font-size: var(--hz-font-sm);
  color: var(--hz-ink);
}

/* 待办为 0：整张卡变淡（数字、名称都退成次要色），有数的卡才突出（2026-10-05） */
.hz-module-home__todo--zero .hz-module-home__count,
.hz-module-home__todo--zero .hz-module-home__label {
  opacity: 0.6;
}

.hz-module-home__todo--zero .hz-module-home__label {
  color: var(--hz-muted);
}
