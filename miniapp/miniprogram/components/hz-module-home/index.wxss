.hz-module-home {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 14px var(--hz-gap-page);
}

.hz-module-home__todos {
  display: flex;
  gap: 8px;
}

.hz-module-home__todo {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 12px 8px;
  text-align: center;
}

.hz-module-home__label {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-module-home__count {
  font-size: var(--hz-font-todo);
  font-weight: 600;
  color: var(--hz-brand);
}

.hz-module-home__count--zero {
  color: var(--hz-muted);
}
