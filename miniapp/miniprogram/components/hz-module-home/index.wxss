.hz-module-home {
  display: flex;
  flex-direction: column;
  gap: var(--hz-gap-controls);
  padding: 12px var(--hz-gap-home);
}

.hz-module-home__todos {
  display: flex;
  flex-direction: column;
  gap: var(--hz-card-gap);
}

.hz-module-home__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 抬头和「查看全部」同一行，不要 u-section__title 的负下边距 */
.hz-module-home__head .u-section__title {
  margin-bottom: 0;
}
