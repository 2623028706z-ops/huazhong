<hz-cover mode="soft" /><hz-navbar title="{{title}}" back="{{back}}" transparent />
<view class="hz-module-home">
  <hz-state wx:if="{{failure.kind === 'page' && failure.state !== 'internal'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" />
  <block wx:else><hz-error wx:if="{{failure}}" message="{{failure.message}}" request-id="{{failure.requestId}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
    <view class="hz-module-home__todos"><view wx:for="{{todos}}" wx:key="key" class="u-card hz-module-home__todo" data-key="{{item.key}}" bindtap="onTodo"><text class="hz-module-home__label">{{item.label}}</text><text class="hz-module-home__count {{item.count===0?'hz-module-home__count--zero':''}}">{{item.count}}</text><text wx:if="{{item.amount}}" class="u-serif-amount">{{item.amount}}</text></view></view>
    <text class="u-section__title">{{texts.common}}</text>
    <hz-entry-grid entries="{{common}}" bind:select="onEntry" />
    <text wx:if="{{masters.length}}" class="u-section__title">{{texts.masters}}</text><hz-entry-grid wx:if="{{masters.length}}" entries="{{masters}}" compact bind:select="onEntry" />
    <view wx:if="{{!back && !tabs.length}}" class="u-detail-third"><hz-button kind="text" text="{{texts.my}}" bind:press="onMy" /></view>
  </block>
</view><hz-tabbar wx:if="{{tabs.length}}" tabs="{{tabs}}" current="home" />
