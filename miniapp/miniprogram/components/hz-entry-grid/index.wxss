/* 一整块细线窗格：外框 --hz-rule-frame，格子之间淡一档 --hz-rule-soft（2026-10-05），不铺底色（docs/design/mock-art.html） */
.hz-entry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  overflow: hidden;
  border: 1px solid var(--hz-rule-frame);
  border-radius: var(--hz-radius);
}

.hz-entry-grid__cell {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 118px;
  padding: 18px var(--hz-card-pad) var(--hz-card-pad);
  border-top: 1px solid var(--hz-rule-soft);
}

/* 第一行不要上线，右列加左线 */
.hz-entry-grid__cell:nth-child(-n + 2) {
  border-top: 0;
}

.hz-entry-grid__cell:nth-child(even) {
  border-left: 1px solid var(--hz-rule-soft);
}

.hz-entry-grid__cell--wide {
  flex-direction: row;
  grid-column: 1 / 3;
  gap: var(--hz-card-pad);
  align-items: center;
  justify-content: flex-start;
  min-height: 72px;
}

/* 不能用：格子里的东西变淡，窗格线不变 */
.hz-entry-grid__cell--off > text {
  opacity: 0.45;
}

.hz-entry-grid__icon {
  font-size: var(--hz-icon-entry);
  color: var(--hz-brand);
}

/* 入口名：宋体 500 16、字距 0（2026-10-05 从 18 + 字距 3 缩一档，原来比页面标题还抢眼） */
.hz-entry-grid__name {
  font-size: var(--hz-font-md);
  font-weight: 500;
}

.hz-entry-grid__go {
  position: absolute;
  right: 14px;
  bottom: 18px;
  font-size: var(--hz-icon-sm);
  color: var(--hz-muted);
}

.hz-entry-grid__cell--wide .hz-entry-grid__go {
  bottom: 23px;
}

/* 模块首页：小一号 */
.hz-entry-grid--compact .hz-entry-grid__cell {
  min-height: 56px;
  padding: var(--hz-card-pad-y) var(--hz-card-pad);
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 10px;
}

.hz-entry-grid--compact .hz-entry-grid__cell--wide {
  min-height: 56px;
}

.hz-entry-grid--compact .hz-entry-grid__icon {
  font-size: var(--hz-icon-nav);
}

/* 定稿 .window.docs：资料小格用正文字体 14 */
.hz-entry-grid--compact .hz-entry-grid__name {
  font-family: var(--hz-sans);
  font-size: var(--hz-font);
  letter-spacing: 0;
}

.hz-entry-grid--compact .hz-entry-grid__cell--wide .hz-entry-grid__go {
  bottom: 19px;
}
