.hz-entry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.hz-entry-grid__cell {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 104px;
  padding: var(--hz-card-pad);
}

.hz-entry-grid__cell--wide {
  flex-direction: row;
  grid-column: 1 / 3;
  gap: var(--hz-card-pad);
  align-items: center;
  justify-content: flex-start;
  height: 64px;
}

.hz-entry-grid__cell--off {
  opacity: 0.45;
}

.hz-entry-grid__icon {
  font-size: var(--hz-icon-entry);
  color: var(--hz-brand);
}

.hz-entry-grid__name {
  font-size: var(--hz-font-lg);
  font-weight: 600;
  letter-spacing: 0.12em;
}

.hz-entry-grid__go {
  position: absolute;
  right: 14px;
  bottom: var(--hz-card-pad);
  font-size: var(--hz-icon-sm);
  color: var(--hz-muted);
}

.hz-entry-grid__cell--wide .hz-entry-grid__go {
  bottom: 24px;
}
