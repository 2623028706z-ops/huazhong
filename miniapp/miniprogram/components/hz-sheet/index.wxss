/* TDesign 弹层只改主题变量 */
.hz-sheet {
  --td-popup-bg-color: var(--hz-paper);
  --td-popup-border-radius: var(--hz-radius-sheet);
}

.hz-sheet__panel {
  display: flex;
  flex-direction: column;
  max-height: 75vh;
}

.hz-sheet__header {
  position: relative;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  height: 48px;
}

.hz-sheet__corner {
  position: absolute;
  top: 2px;
  left: 4px;
  font-size: var(--hz-icon-md);
  color: var(--hz-ink);
}

/* 标题行右上的入口（slot="extra"，如「盘点记录 ›」），没有就不占地方 */
.hz-sheet__extra {
  position: absolute;
  top: 0;
  right: var(--hz-gap-sheet);
  display: flex;
  align-items: center;
  height: 100%;
}

.hz-sheet__title {
  font-size: var(--hz-font-lg);
  letter-spacing: 0.08em;
}

/* 内容长了在这里滚动：高度上限 = 75vh 减去标题（48px），有底部按钮再减按钮区（44 + 18 + 1px 细线） */
.hz-sheet__body {
  flex: 0 1 auto;
  min-height: 0;
  max-height: calc(75vh - 48px);
}

.hz-sheet__body--footer {
  max-height: calc(75vh - 48px - var(--hz-tap) - 19px - env(safe-area-inset-bottom));
}

/* 底部按钮排法用 hz-action-bar 的 inline 模式，这里只让它不被压缩 */
.hz-sheet__footer {
  flex: none;
}

.hz-sheet__panel--center {
  width: 90vw;
  overflow: hidden;
  border-radius: var(--hz-radius-sheet);
}
