<view class="hz-sheet">
  <t-popup visible="{{show}}" placement="{{center ? 'center' : 'bottom'}}" bind:visible-change="onVisibleChange">
    <view class="hz-sheet__panel {{center ? 'hz-sheet__panel--center' : ''}}">
      <view class="hz-sheet__header">
        <view class="hz-sheet__corner u-tap" bindtap="onCorner">
          <text class="hz-icon hz-icon--{{back ? 'chevron-left' : 'x'}}"></text>
        </view>
        <text class="hz-sheet__title u-serif">{{title}}</text>
      </view>
      <scroll-view class="hz-sheet__body {{footer ? 'hz-sheet__body--footer' : ''}}" scroll-y>
        <slot />
      </scroll-view>
      <hz-action-bar wx:if="{{footer}}" class="hz-sheet__footer" inline>
        <slot name="footer" />
      </hz-action-bar>
    </view>
  </t-popup>
</view>
