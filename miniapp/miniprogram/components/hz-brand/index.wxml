<wxs src="../../core/format.wxs" module="format" />
<view class="hz-brand">
  <image class="hz-brand__logo" src="/assets/logo.png" mode="heightFix" />
  <view class="hz-brand__identity">
    <text><text class="hz-brand__lead">{{lead}}</text><text wx:if="{{person}}" class="hz-brand__person"> · {{person}}</text></text>
    <text wx:if="{{today}}" class="hz-brand__date">{{format.formatNavDate(today)}}</text>
  </view>
</view>
