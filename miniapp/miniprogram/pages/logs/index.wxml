<hz-navbar title="{{title}}" back />
<view class="u-list">
  <hz-filter-bar date-label="{{dateLabel}}" dimensions="{{dimensions}}" value="{{filter}}" bind:change="onFilter" />
  <hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" />
  <hz-error wx:elif="{{failure}}" message="{{failure.message}}" request-id="{{failure.requestId}}" retry bind:retry="onFailureAction" />
  <hz-skeleton wx:if="{{skeleton}}" type="list" />
  <hz-state wx:elif="{{loaded && rows.length === 0}}" object="{{emptyObject}}" />
  <view wx:for="{{rows}}" wx:key="id" data-key="{{item.id}}" bindtap="onOpen">
    <hz-card title="{{item.title}}" total="{{item.total}}" meta="{{item.meta}}" />
  </view>
  <text wx:if="{{done && rows.length > 0}}" class="u-list__end">{{allLoaded}}</text>
</view>
<hz-sheet show="{{sheet}}" title="{{sheetTitle}}" bind:close="onCloseSheet">
  <hz-error wx:if="{{detailError}}" message="{{detailError}}" />
  <view wx:if="{{detail.reason}}" class="hz-logs__section">
    <text class="hz-logs__heading">{{reasonLabel}}</text>
    <text>{{detail.reason}}</text>
  </view>
  <view wx:for="{{detail.sections}}" wx:key="title" wx:for-item="section" class="hz-logs__section">
    <text class="hz-logs__heading">{{section.title}}</text>
    <view wx:for="{{section.rows}}" wx:key="label" class="hz-logs__row">
      <text class="hz-logs__label">{{item.label}}</text>
      <text>{{item.value}}</text>
    </view>
  </view>
</hz-sheet>
