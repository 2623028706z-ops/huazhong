<hz-cover />
<hz-navbar transparent back="{{back}}" />
<view class="u-home">
  <view class="u-home__body">
    <hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
    <hz-error wx:elif="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
    <hz-profile
      wx:if="{{profile}}"
      name="{{profile.name}}"
      lines="{{profile.lines}}"
      menus="{{profile.menus}}" dev-menus="{{profile.devMenus}}"
      contact-phone="{{profile.contactPhone}}" external="{{profile.external}}"
      bind:select="onSelect"
      bind:logout="onLogout"
    >
      <view wx:if="{{statements}}" class="u-section">
        <text class="u-section__title">{{texts.statements}}</text>
        <view wx:if="{{!statements.length}}" class="u-card u-my-statements__empty">{{texts.noStatement}}</view>
        <hz-card wx:for="{{statements}}" wx:key="id" row="{{item}}" status-kind="statementStatus" data-key="{{item.id}}" bind:press="onStatement" />
      </view>
    </hz-profile>
  </view>
</view>
<hz-confirm id="hz-confirm" />
<hz-tabbar wx:if="{{tabs.length}}" tabs="{{tabs}}" current="my" />
