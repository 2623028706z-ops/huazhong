<import src="/views/stock.wxml" />
<hz-navbar title="{{title}}" back />
<view class="u-list">
  <hz-filter-bar search-placeholder="{{searchPlaceholder}}" dimensions="{{dimensions}}" value="{{filter}}" bind:change="onFilter" />
  <hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
  <hz-error wx:elif="{{failure}}" message="{{failure.message}}" request-id="{{failure.requestId}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  <hz-skeleton wx:if="{{skeleton}}" type="list" />
  <hz-state wx:elif="{{loaded && rows.length === 0}}" object="{{emptyObject}}" />
  <template is="hz-stock-groups" data="{{groups, openable: false}}" />
  <text wx:if="{{done && rows.length > 0}}" class="u-list__end">{{allLoaded}}</text>
</view>
<hz-action-bar wx:if="{{canManage || canCreate}}"><hz-button wx:if="{{canManage}}" kind="secondary" text="{{texts.manage}}" bind:press="onManage" /><hz-button wx:if="{{canCreate}}" text="{{texts.create}}" bind:press="onCreate" /></hz-action-bar>
