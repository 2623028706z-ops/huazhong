/* 字标在上部；隐私勾选和登录按钮贴底，按钮底边离屏幕底 58px，落在渐亮的墙色上（docs/design/mock-login.html） */
.hz-login {
  padding: 0 var(--hz-gap-page);
}

.hz-login__logo {
  display: block;
  height: 46px;
  margin: 160px auto 0; /* 160px：登录页品牌区离顶的版面位置，不是间距档 */
}

.hz-login__panel {
  position: fixed;
  right: var(--hz-gap-page);
  bottom: 58px;
  left: var(--hz-gap-page);
  display: flex;
  flex-direction: column;
  gap: var(--hz-space-4);
}
