/* 只写布局：间距、排列；外观都在组件里 */
.hz-gallery {
  display: flex;
  flex-direction: column;
  gap: var(--hz-space-5);
  padding: var(--hz-row-pad) var(--hz-gap-page) 40px; /* 40px：开发样张页底部留白，不上线 */
}

.hz-gallery__section {
  display: flex;
  flex-direction: column;
  gap: var(--hz-card-gap);
}

.hz-gallery__card {
  display: flex;
  flex-direction: column;
  gap: var(--hz-card-gap);
  padding: var(--hz-card-pad);
}

.hz-gallery__row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--hz-space-2);
  align-items: center;
}

.hz-gallery__row--center {
  justify-content: center;
}

.hz-gallery__pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--hz-space-2);
}

/* 固定定位的底栏、操作区放进框里：transform 让 fixed 相对这个框 */
.hz-gallery__frame {
  position: relative;
  overflow: hidden;
  transform: translateZ(0);
}

.hz-gallery__swatch {
  display: flex;
  flex-direction: column;
  gap: var(--hz-space-1);
  align-items: center;
}

.hz-gallery__chip {
  width: var(--hz-tap);
  height: var(--hz-tap);
}

.hz-gallery__icon {
  font-size: var(--hz-icon-md);
}
