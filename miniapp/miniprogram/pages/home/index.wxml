<hz-cover />
<hz-navbar transparent />
<view class="u-home">
  <hz-brand lead="{{lead}}" person="{{person}}" />
  <view class="u-home__body">
    <hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" />
    <hz-error wx:elif="{{failure}}" message="{{failure.message}}" retry bind:retry="onFailureAction" />
    <hz-entry-grid wx:else entries="{{entries}}" bind:select="onSelect" />
  </view>
</view>
<hz-tabbar tabs="{{tabs}}" current="home" />
