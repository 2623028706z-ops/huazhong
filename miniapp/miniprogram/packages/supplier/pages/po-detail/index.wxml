<import src="/views/purchase.wxml" /><import src="/views/detail.wxml" /><hz-navbar title="{{title}}" back /><hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" /><view wx:else class="u-list"><hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" /><hz-skeleton wx:if="{{!loaded}}" type="detail" /><block wx:else><hz-button wx:if="{{statementLink}}" kind="text" text="{{statementLink}}" bind:press="onStatement" /><template is="po-body" data="{{...view}}" /></block></view><hz-action-bar wx:if="{{canCancel || canEdit}}"><hz-button wx:if="{{canCancel}}" kind="secondary" text="{{cancelText}}" bind:press="onCancel" /><hz-button wx:if="{{canEdit}}" text="{{editText}}" bind:press="onEdit" /></hz-action-bar><hz-reason-sheet show="{{cancelSheet}}" title="{{cancelText}}" required confirm="{{confirmCancel}}" error="{{error}}" loading="{{busy}}" bind:close="onCloseCancel" bind:submit="onSubmitCancel" />
