<import src="/views/detail.wxml" />
<hz-navbar title="{{title}}" back />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
<view wx:else class="u-list">
  <hz-realtime-bar text="{{realtime}}" />
  <hz-error wx:if="{{failure}}" message="{{failure.message}}" request-id="{{failure.requestId}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="detail" /></block>
  <template wx:elif="{{view}}" is="order-body" data="{{...view}}" />
</view>
<template is="buttons" data="{{buttons, busy}}" />

<hz-reason-sheet
  show="{{cancelSheet}}"
  title="{{texts.cancelTitle}}"
  required="{{cancelRequired}}"
  optional="{{cancelOptional}}"
  subject="{{texts.cancelSubject}}"
  hint="{{texts.cancelBody}}"
  body="{{texts.cancelBody}}"
  confirm="{{texts.confirmCancel}}"
  error="{{cancelError}}"
  loading="{{busy === 'cancel'}}"
  bind:close="onCloseCancel"
  bind:submit="onCancel"
/>
<hz-order-confirm show="{{confirmSheet}}" orders="{{confirmTargets}}" overdue="{{confirmOverdue}}" bind:close="onCloseConfirm" bind:done="onConfirmDone" />
<hz-sheet show="{{bomSheet}}" title="{{bom.title}}" bind:close="onCloseBom">
  <view class="u-sheet-section">
    <view class="u-section__title u-section__title--split">{{texts.shippedBom}}<text class="u-caption">{{bom.hint}}</text></view>
    <view wx:for="{{bom.rows}}" wx:key="key" class="u-sheet-row"><text>{{item.name}}</text><text>{{item.qty}}</text></view>
    <text class="u-caption">{{texts.shippedHint}}</text>
  </view>
</hz-sheet>
<hz-confirm id="hz-confirm" />
