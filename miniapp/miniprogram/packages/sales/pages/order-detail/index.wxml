<import src="/views/detail.wxml" />
<hz-navbar title="{{title}}" back />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
<view wx:else class="u-list">
  <hz-realtime-bar text="{{realtime}}" />
  <hz-error wx:if="{{failure}}" message="{{failure.message}}" request-id="{{failure.requestId}}" retry bind:retry="onFailureAction" />
  <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="detail" /></block>
  <template wx:elif="{{view}}" is="order-body" data="{{...view}}" />
</view>
<template is="buttons" data="{{buttons, busy}}" />
<hz-sheet show="{{confirmSheet}}" title="{{texts.confirmTitle}}" footer bind:close="onCloseConfirm">
  <view class="u-sheet-form">
    <hz-error wx:if="{{confirmError}}" message="{{confirmError}}" />
    <hz-picker label="{{texts.shipDate}}" mode="date" value="{{shipDate}}" bind:change="onShipDate" />
  </view>
  <hz-button slot="footer" text="{{texts.confirm}}" loading="{{busy === 'confirm'}}" bind:press="onConfirm" />
</hz-sheet>
<hz-reason-sheet
  show="{{cancelSheet}}"
  title="{{texts.cancelTitle}}"
  required="{{cancelRequired}}"
  body="{{texts.cancelBody}}"
  confirm="{{texts.confirmCancel}}"
  error="{{cancelError}}"
  loading="{{busy === 'cancel'}}"
  bind:close="onCloseCancel"
  bind:submit="onCancel"
/>
