<import src="/views/pick.wxml" />
<import src="/views/detail.wxml" />
<hz-navbar title="{{title}}" back guard="{{changed}}" />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
<view wx:else class="u-list">
  <hz-realtime-bar text="{{realtime}}" bind:refresh="onRealtime" />
  <hz-error wx:if="{{failure}}" message="{{failure.message}}" retry bind:retry="onFailureAction" />
  <hz-error wx:if="{{formError}}" message="{{formError}}" />
  <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="form" /></block>
  <block wx:else>
    <!-- 修改时客户门店不能改，只读一张信息卡 -->
    <template wx:if="{{mode !== 'create'}}" is="info" data="{{rows: customerRows}}" />
    <view class="u-section">
      <text class="u-section__title">{{texts.orderInfo}}</text>
      <view class="u-card u-form-card">
        <block wx:if="{{mode === 'create'}}">
          <hz-picker label="{{texts.customer}}" options="{{customerOptions}}" value="{{form.customerId}}" error="{{fields.customerId}}" bind:change="onCustomer" />
          <hz-picker label="{{texts.store}}" options="{{storeOptions}}" value="{{form.storeId}}" error="{{fields.storeId}}" bind:change="onStore" />
        </block>
        <hz-picker label="{{texts.shipDate}}" mode="date" value="{{form.shipDate}}" error="{{fields.shipDate}}" bind:change="onShipDate" />
        <hz-field label="{{texts.note}}" type="textarea" placeholder="{{texts.optional}}" value="{{form.note}}" bind:change="onNote" />
      </view>
    </view>
    <view class="u-section">
      <text class="u-section__title">{{texts.lines}}</text>
      <hz-line-item lines="{{lineViews}}" mode="price" removable min="{{1}}" bind:qty="onQty" bind:price="onPrice" bind:remove="onRemove" />
      <hz-add-button text="{{texts.add}}" bind:press="onOpenPick" />
      <template is="info-card" data="{{rows: amountRows}}" />
    </view>
    <view wx:if="{{mode !== 'create'}}" class="u-card u-form-card">
      <hz-field label="{{texts.reason}}" type="textarea" value="{{form.reason}}" error="{{fields.reason}}" bind:change="onReason" />
    </view>
  </block>
</view>
<hz-action-bar>
  <hz-button text="{{submitText}}" loading="{{saving}}" bind:press="onSubmit" />
</hz-action-bar>
<template is="pick-sheet" data="{{show: pickSheet, title: texts.pickTitle, picks, empty: texts.noPick}}" />
<hz-confirm id="hz-confirm" />
