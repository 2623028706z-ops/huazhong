<hz-navbar title="{{title}}" back />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
<block wx:else>
  <view class="u-list">
    <hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  </view>
  <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="list" /></block>
  <block wx:elif="{{side.length === 0}}"><hz-state object="{{texts.empty}}" /></block>
  <view wx:else class="u-split">
    <view class="u-split__side">
      <hz-side-list items="{{side}}" value="{{customerId}}" bind:change="onCustomer" />
    </view>
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="u-split__main">
      <view class="u-info__head">
        <text class="u-info__title">{{customerName}}</text>
      </view>
      <text wx:if="{{stores.length === 0}}" class="u-info__meta">{{texts.noStores}}</text>
      <view wx:if="{{stores.length}}" class="u-card u-rows">
        <view wx:for="{{stores}}" wx:key="id" class="u-rows__item"><view class="u-rows__line">
          <view class="u-store-row__pick u-tap" data-key="{{item.id}}" bindtap="onPickStore"><view class="u-check u-store-row__radio {{item.picked ? 'u-check--on' : ''}}"><text wx:if="{{item.picked}}" class="hz-icon hz-icon--check"></text></view></view>
          <view class="u-store-row__main" data-key="{{item.id}}" bindtap="onOpen">
            <text class="u-rows__name u-ellipsis">{{item.name}}</text>
            <hz-tag wx:if="{{item.disabled}}" text="{{texts.disabled}}" />
            <text class="hz-icon hz-icon--chevron-right u-store-row__arrow"></text>
          </view>
        </view></view>
      </view>
    </scroll-view>
  </view>
</block>
<!-- 操作只放底栏（2026-10-06 第 4 批）：邀请订货 / 新建门店，新建客户、修改客户收进「更多」；
     没有新建门店权限时两个客户操作直接放底栏；还没有客户时只有「新建客户」 -->
<hz-action-bar wx:if="{{loaded && side.length === 0 && canCreateCustomer}}"><hz-button text="{{texts.createCustomer}}" bind:press="onNewCustomer" /></hz-action-bar>
<hz-action-bar wx:elif="{{loaded && side.length > 0 && canCreate}}" more>
  <hz-more>
    <hz-button wx:if="{{canCreateCustomer}}" kind="secondary" text="{{texts.createCustomer}}" bind:press="onNewCustomer" />
    <hz-button kind="secondary" text="{{texts.editCustomer}}" bind:press="onEditCustomer" />
  </hz-more>
  <hz-button kind="secondary" text="{{texts.invite}}" bind:press="onInvite" /><hz-button text="{{texts.createStore}}" bind:press="onNewStore" />
</hz-action-bar>
<hz-action-bar wx:elif="{{loaded && side.length > 0}}"><hz-button kind="secondary" text="{{texts.editCustomer}}" bind:press="onEditCustomer" /><hz-button wx:if="{{canCreateCustomer}}" text="{{texts.createCustomer}}" bind:press="onNewCustomer" /></hz-action-bar>
<hz-sheet show="{{customerSheet}}" title="{{editingCustomer ? texts.customerTitle : texts.newCustomerTitle}}" guard="{{customerChanged}}" footer bind:close="onCloseSheet">
  <view class="u-sheet-form">
    <view wx:if="{{editingCustomer}}" class="u-sheet-head">
      <text class="u-sheet-head__title">{{customerForm.name}}</text>
    </view>
    <hz-error wx:if="{{formError}}" message="{{formError}}" />
    <hz-field label="{{texts.name}}" value="{{customerForm.name}}" error="{{fields.name}}" bind:change="onCustomerName" />
    <hz-switch label="{{texts.enabled}}" value="{{customerForm.enabled}}" bind:change="onCustomerEnabled" />
  </view>
  <hz-button slot="footer" text="{{texts.saveCustomer}}" loading="{{saving}}" bind:press="onSaveCustomer" />
</hz-sheet>
<hz-store-invite show="{{inviteSheet}}" customers="{{inviteCustomers}}" store-id="{{inviteStoreId}}" bind:close="onCloseInvite" bind:invited="onInvited" bind:updated="onStoreUpdated" />
