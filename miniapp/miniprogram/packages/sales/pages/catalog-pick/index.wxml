<hz-navbar title="{{title}}" back /><view class="u-list"><hz-search placeholder="{{texts.search}}" value="{{keyword}}" bind:search="onSearch" /><hz-state wx:if="{{failure.kind==='page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" /><hz-error wx:elif="{{failure}}" message="{{failure.message}}" retry bind:retry="onFailureAction" /><hz-skeleton wx:if="{{!loaded && !failure}}" type="list" /><block wx:if="{{loaded}}"><hz-state wx:if="{{rows.length===0}}" object="{{texts.empty}}" /><view wx:for="{{rows}}" wx:key="id" class="u-card u-info" data-key="{{item.id}}" bindtap="onPick"><view class="u-info__head"><text class="u-info__title">{{item.name}}</text><text wx:if="{{selected===item.id}}" class="hz-icon hz-icon--check"></text></view><text>{{item.sub}}</text></view></block></view><hz-action-bar><hz-button text="{{texts.next}}" disabled="{{!selected}}" bind:press="onNext" /></hz-action-bar>
