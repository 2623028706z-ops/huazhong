<import src="/views/bom.wxml" /><hz-navbar title="{{title}}" back guard="{{changed}}" /><hz-state wx:if="{{failure.kind==='page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" /><view wx:else class="u-list"><hz-realtime-bar text="{{realtime}}" bind:refresh="onRealtime" /><hz-error wx:if="{{failure}}" message="{{failure.message}}" retry bind:retry="onFailureAction" /><hz-error wx:if="{{formError}}" message="{{formError}}" /><hz-skeleton wx:if="{{!loaded && !failure}}" type="form" /><block wx:if="{{loaded}}"><view class="u-info__head"><text class="u-info__title">{{form.name}}</text><text>{{customerName}}</text></view><view class="u-card u-form-card"><hz-field label="{{texts.code}}" value="{{form.customerCode}}" error="{{fields.customerCode}}" bind:change="onCode" /><hz-picker label="{{texts.category}}" options="{{categoryOptions}}" value="{{form.categoryId}}" error="{{fields.categoryId}}" bind:change="onCategory" /><hz-field label="{{texts.price}}" type="digit" value="{{form.priceText}}" suffix="{{texts.yuan}}" error="{{fields.priceCents}}" bind:change="onPrice" /><hz-switch label="{{texts.enabled}}" value="{{form.enabled}}" bind:change="onEnabled" /></view><template is="bom-rows" data="{{heading:texts.sharedBom,note:texts.sharedNote,error:bomError,bomRows,editKey,add:texts.addMaterial}}" /></block></view><hz-action-bar><hz-button text="{{texts.save}}" loading="{{saving}}" disabled="{{!loaded}}" bind:press="onSaveItem" /></hz-action-bar><hz-sheet show="{{layer==='material'}}" title="{{texts.pickMaterial}}" bind:close="onItemClose"><view class="u-sheet-section"><view wx:for="{{materialPicks}}" wx:key="id" class="u-choice" data-key="{{item.id}}" bindtap="onPickMaterial"><view class="u-choice__main"><text>{{item.name}}</text><text wx:if="{{item.sub}}" class="u-choice__sub">{{item.sub}}</text></view></view></view><hz-state wx:if="{{materialPicks.length===0}}" object="{{texts.noMaterial}}" /></hz-sheet><hz-confirm id="hz-confirm" />
