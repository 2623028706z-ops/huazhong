<import src="/views/pick.wxml" />
<import src="/views/bom.wxml" />
<hz-navbar title="{{title}}" back />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" />
<block wx:else>
  <view class="u-list">
    <hz-realtime-bar text="{{realtime}}" bind:refresh="onRealtime" />
    <hz-error wx:if="{{failure}}" message="{{failure.message}}" retry bind:retry="onFailureAction" />
  </view>
  <hz-skeleton wx:if="{{!loaded}}" type="list" />
  <hz-state wx:elif="{{side.length === 0}}" object="{{texts.noCustomers}}" />
  <view wx:else class="u-split">
    <view class="u-split__side">
      <hz-side-list items="{{side}}" value="{{customerId}}" bind:change="onCustomer" />
    </view>
    <scroll-view scroll-y class="u-split__main">
      <text wx:if="{{groups.length === 0}}" class="u-info__meta">{{texts.empty}}</text>
      <view wx:for="{{groups}}" wx:key="id" wx:for-item="group" class="u-section">
        <text class="u-section__title">{{group.name}}</text>
        <view class="u-card u-rows">
          <view wx:for="{{group.rows}}" wx:key="productId" class="u-rows__item" data-key="{{item.productId}}" bindtap="onOpenItem">
            <view class="u-rows__head">
              <text class="u-rows__title u-clamp-2">{{item.name}}</text>
              <text class="u-rows__price u-serif-amount">{{item.priceText}}</text>
            </view>
            <view wx:if="{{item.tags.length > 0 || item.code}}" class="u-rows__foot">
              <hz-tag wx:for="{{item.tags}}" wx:for-item="tag" wx:key="text" text="{{tag.text}}" warn="{{tag.warn}}" />
              <text class="u-ellipsis">{{item.code}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</block>
<hz-action-bar>
  <hz-button kind="secondary" text="{{texts.manage}}" bind:press="onManage" />
  <hz-button text="{{texts.add}}" disabled="{{categories.length === 0}}" reason="{{texts.needCategory}}" bind:press="onOpenPick" />
</hz-action-bar>
<!-- 目录项弹层：抬头产品名 + 客户名；上块订货信息，下块配方（所有客户共用）；「添加花材」在同一个弹层里切到选花材 -->
<hz-sheet
  show="{{layer !== ''}}"
  title="{{layer === 'material' ? texts.pickMaterial : texts.itemTitle}}"
  back="{{layer === 'material'}}"
  guard="{{layer === 'item' && changed}}"
  footer="{{layer === 'item'}}"
  bind:close="onItemClose"
  bind:back="onItemBack"
>
  <view wx:if="{{layer === 'item' && form}}" class="u-sheet-form">
    <view class="u-sheet-head">
      <text class="u-sheet-head__title">{{form.name}}</text>
      <text class="u-sheet-head__meta">{{customerName}}</text>
    </view>
    <hz-error wx:if="{{formError}}" message="{{formError}}" />
    <view class="u-section">
      <text class="u-section__title">{{texts.customerItem}}</text>
      <hz-field label="{{texts.code}}" placeholder="{{texts.optional}}" value="{{form.customerCode}}" error="{{fields.customerCode}}" bind:change="onCode" />
      <hz-picker label="{{texts.category}}" options="{{categoryOptions}}" value="{{form.categoryId}}" error="{{fields.categoryId}}" bind:change="onCategory" />
      <hz-field label="{{priceLabel}}" type="digit" value="{{form.priceText}}" error="{{fields.priceCents}}" bind:change="onPrice" />
      <hz-switch label="{{texts.enabled}}" value="{{form.enabled}}" bind:change="onEnabled" />
    </view>
    <template is="bom-rows" data="{{heading: texts.sharedBom, note: texts.sharedNote, error: bomError, bom: form.bom, add: texts.addMaterial}}" />
  </view>
  <block wx:if="{{layer === 'material'}}">
    <view wx:if="{{materialPicks.length === 0}}" class="u-sheet-section">{{texts.noMaterial}}</view>
    <view wx:for="{{materialPicks}}" wx:key="id" class="u-pick-row" data-key="{{item.id}}" bindtap="onPickMaterial">
      <text>{{item.name}}</text>
      <text class="u-pick-row__sub">{{item.sub}}</text>
    </view>
  </block>
  <hz-button slot="footer" text="{{texts.save}}" loading="{{saving}}" bind:press="onSaveItem" />
</hz-sheet>
<template is="pick-sheet" data="{{show: pickSheet, title: texts.pickTitle, picks, empty: texts.noPick}}" />
<hz-category-sheet
  show="{{categorySheet}}"
  title="{{texts.categories}}"
  categories="{{categories}}"
  error="{{categoryError}}"
  loading="{{saving}}"
  bind:close="onCloseCategories"
  bind:save="onSaveCategory"
  bind:up="onUpCategory"
  bind:remove="onRemoveCategory"
/>
<hz-confirm id="hz-confirm" />
