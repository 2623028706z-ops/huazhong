<import src="/views/list.wxml" />
<hz-navbar title="{{title}}" back />
<view class="u-list">
  <hz-filter-bar status-kind="{{statusKind}}" statuses="{{statuses}}" counts="{{counts}}" search-placeholder="{{searchPlaceholder}}" date-label="{{dateLabel}}" dimensions="{{dimensions}}" value="{{filter}}" bind:change="onFilter" />
  <template is="list-state" data="{{failure, skeleton, loaded, rows, emptyObject}}" />
  <template is="cards" data="{{rows, statusKind, done, allLoaded,selection:filter.status==='pending_confirm'}}" />
</view>
<hz-action-bar wx:if="{{filter.status === 'pending_confirm'}}"><hz-button kind="secondary" text="{{texts.allSelected}}" bind:press="onSelectAll" /><hz-button text="{{batchText}}" disabled="{{!selected.length}}" bind:press="onOpenBatch" /></hz-action-bar>
<hz-action-bar wx:elif="{{canCreate}}"><hz-button kind="secondary" text="{{texts.invite}}" bind:press="onInvite" /><hz-button text="{{createText}}" bind:press="onCreate" /></hz-action-bar>
<hz-sheet show="{{batchSheet}}" title="{{batchTitle}}" footer bind:close="onCloseBatch"><view class="u-sheet-form"><hz-notice wx:for="{{batchOverdue}}" wx:key="index" text="{{item}}" /><hz-error wx:if="{{batchError}}" message="{{batchError}}" /><hz-picker label="{{texts.shipDate}}" mode="date" value="{{batchDate}}" bind:change="onBatchDate" /><view wx:for="{{batchRows}}" wx:key="id" class="u-sheet-row"><text>{{item.title}}</text><text class="u-info__meta">{{item.no}}</text></view><text wx:if="{{batchMore}}" class="u-info__meta">{{batchMore}}</text><text class="u-info__meta">{{texts.note}}</text></view><hz-button slot="footer" kind="secondary" text="{{texts.back}}" bind:press="onCloseBatch" /><hz-button slot="footer" text="{{texts.confirmOrders}}" loading="{{batchBusy}}" bind:press="onConfirmBatch" /></hz-sheet>
<hz-sheet show="{{inviteSheet}}" title="{{texts.inviteTitle}}" bind:close="onCloseInvite"><view class="u-sheet-form"><hz-error wx:if="{{inviteError}}" message="{{inviteError}}" /><text wx:if="{{inviteOptions.length === 0}}" class="u-info__meta">{{texts.noInvite}}</text><block wx:else><hz-picker label="{{texts.inviteStore}}" options="{{inviteOptions}}" value="{{inviteStoreId}}" bind:change="onInviteStore" /><block wx:if="{{invited}}"><text class="u-info__meta">{{invited.expiresText}}</text><hz-button text="{{texts.share}}" open-type="share" /></block></block></view></hz-sheet>
