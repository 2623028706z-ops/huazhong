<import src="/views/pick.wxml" />
<import src="/views/detail.wxml" />
<hz-navbar title="{{title}}" back guard="{{changed}}" />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
<view wx:else class="u-list"><hz-realtime-bar text="{{realtime}}" bind:refresh="onRealtime" />
  <hz-error wx:if="{{formError}}" message="{{formError}}" />
  <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="form" /></block>
  <block wx:else>
    <template is="info" data="{{title: infoTitle, rows: info, cols: true}}" />
    <block wx:if="{{isProcess}}"><view wx:for="{{lines}}" wx:key="id" class="u-card u-info"><text class="u-info__title">{{item.name}}</text><text>{{texts.reason}} {{item.readonlyMeta}}</text><text wx:if="{{item.description}}">{{texts.description}} {{item.description}}</text><view wx:if="{{item.images.length}}" class="u-thumbs"><image wx:for="{{item.images}}" wx:for-item="image" wx:key="url" class="u-thumbs__item" src="{{image.thumbUrl}}" mode="aspectFill" data-url="{{image.url}}" data-urls="{{item.urls}}" bindtap="onPreview" /></view></view></block>
    <hz-line-item title="{{texts.lines}}" lines="{{lineViews}}" mode="custom" add-text="{{isProcess ? '' : texts.add}}" bind:edit="onEditLine" bind:add="onOpenPick" />
    <view class="u-card u-form-card"><hz-field label="{{texts.note}}" type="textarea" placeholder="{{texts.optional}}" value="{{note}}" bind:change="onNote" /></view>
  </block>
</view>
<hz-action-bar>
  <hz-button text="{{texts.save}}" loading="{{saving}}" bind:press="onSubmit" />
</hz-action-bar>
<template is="pick-sheet" data="{{show: pickSheet, error: '', title: texts.pickTitle, placeholder: texts.searchProduct, keyword: pickKeyword, picks, empty: texts.noPick, count: pickCount, confirm: pickConfirm, summary: pickSummary}}" />
<hz-confirm id="hz-confirm" />
<hz-sheet show="{{editor}}" title="{{draft.name}}" center footer bind:close="onCloseEditor"><view class="u-sheet-form"><text>{{draft.maxText}}</text><view class="u-sheet-row"><text>{{texts.qty}}</text><hz-stepper value="{{draft.qty}}" error="{{!!draftErrors.qty}}" min="{{isProcess ? 0 : 1}}" max="{{draft.maxQty}}" data-field="qty" bind:change="onDraft" /><text>{{draft.unit}}</text></view><text wx:if="{{draftErrors.qty}}" class="u-field__error">{{draftErrors.qty}}</text><hz-field label="{{texts.price}}" type="digit" value="{{draft.priceText}}" error="{{draftErrors.price}}" suffix="{{texts.yuan}}" data-field="priceText" bind:change="onDraft" /><view class="u-sheet-row"><text>{{texts.subtotal}}</text><text class="u-serif-amount">{{draftAmount}}</text></view><block wx:if="{{!isProcess}}"><hz-picker label="{{texts.reason}}" options="{{reasonOptions}}" value="{{draft.reason}}" error="{{draftErrors.reason}}" data-field="reason" bind:change="onDraft" /><hz-field label="{{texts.description}}" type="textarea" value="{{draft.description}}" error="{{draftErrors.description}}" data-field="description" bind:change="onDraft" /></block></view><hz-button wx:if="{{!isProcess}}" slot="footer" kind="secondary" text="{{texts.remove}}" bind:press="onRemoveEdited" /><hz-button slot="footer" text="{{texts.confirm}}" bind:press="onConfirmEditor" /></hz-sheet>
