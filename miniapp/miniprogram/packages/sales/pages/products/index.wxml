<hz-navbar title="{{title}}" back />
<view class="u-list">
  <hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
  <hz-error wx:elif="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="list" /></block>
  <hz-state wx:elif="{{groups.length === 0}}" object="{{texts.empty}}" />
  <view wx:for="{{groups}}" wx:key="id" wx:for-item="group" class="u-section">
    <text class="u-section__title">{{group.name}}</text>
    <view class="u-card u-rows">
      <view wx:for="{{group.rows}}" wx:key="id" class="u-rows__item u-products__row" data-key="{{item.id}}" bindtap="onOpen">
        <view class="u-products__main">
          <view class="u-products__name"><text class="u-rows__title">{{item.name}}</text><hz-tag wx:if="{{item.disabled}}" text="{{texts.disabled}}" /></view>
          <text class="u-info__meta">{{item.meta}}</text>
        </view>
        <text class="hz-icon hz-icon--chevron-right u-field__icon"></text>
      </view>
    </view>
  </view>
</view>
<hz-action-bar wx:if="{{canCreate || canManage}}">
  <hz-button wx:if="{{canManage}}" kind="secondary" text="{{texts.manage}}" bind:press="onManage" />
  <hz-button wx:if="{{canCreate}}" text="{{texts.create}}" bind:press="onCreate" />
</hz-action-bar>
<hz-category-sheet
  show="{{sheet}}"
  title="{{texts.categories}}"
  categories="{{categories}}"
  error="{{sheetError}}"
  loading="{{saving}}"
  bind:close="onCloseSheet"
  bind:save="onSaveName"
  bind:up="onUp"
  bind:remove="onDelete"
/>
<hz-confirm id="hz-confirm" />
