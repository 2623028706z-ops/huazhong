<hz-navbar title="{{title}}" back />
<hz-invite-list wx:if="{{section==='invites'}}" supplier-id="{{inviteSupplierId}}" sections="{{sections}}" section="{{section}}" search-placeholder="{{texts.search}}" bind:section="onSection" />
<block wx:else>
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" />
<view wx:else class="u-list">
  <hz-filter-bar search-placeholder="{{texts.search}}" sections="{{sections}}" section="{{section}}" date-label="{{texts.shipDate}}" date-presets="{{datePresets}}" default-date="next7Days" value="{{dateFilter}}" bind:change="onDemandFilter" bind:section="onSection" />
  <view wx:if="{{overdue.count}}" class="u-note-warn" bindtap="onOverdue"><text>{{overdueText}} ›</text></view>
  <hz-error wx:if="{{failure && !sourceSheet && !supplierSheet}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  <hz-skeleton wx:if="{{!loaded}}" type="list" />
  <block wx:else><text wx:if="{{rows.length}}" class="u-info__meta">{{count}}</text><hz-state wx:if="{{!rows.length}}" object="{{emptyObject}}" message="{{emptyText}}" /></block>
  <hz-demand-row wx:for="{{rows}}" wx:key="id" name="{{item.name}}" enabled="{{item.enabled}}" selected="{{item.selected}}" range="{{item.range}}" need="{{item.needText}}" stock="{{item.stockText}}" transit="{{item.transitText}}" left="{{item.left}}" short="{{item.leftQty < 0}}" tags="{{item.tags}}" data-key="{{item.id}}" bind:toggle="onToggle" bind:open="onSource" />
</view>
<hz-action-bar><hz-button wx:if="{{canInvite}}" kind="secondary" text="{{inviteText}}" disabled="{{!selected.length}}" bind:press="onInvite" /><hz-button wx:if="{{canCreate}}" text="{{createText}}" disabled="{{!selected.length}}" bind:press="onCreate" /></hz-action-bar>
<hz-sheet show="{{supplierSheet}}" title="{{texts.invite}}" footer bind:close="onCloseSupplier">
  <view class="u-sheet-form"><hz-picker inline label="{{texts.supplier}}" options="{{suppliers}}" value="{{supplierId}}" error="{{error}}" bind:change="onSupplier" /><text wx:if="{{!suppliers.length}}" class="u-info__meta">{{texts.noSuppliers}}</text></view>
  <hz-button slot="footer" text="{{texts.next}}" bind:press="onNext" />
</hz-sheet>
<hz-sheet show="{{sourceSheet}}" title="{{sourceName}}" bind:close="onCloseSource">
  <view class="u-sheet-form u-sheet-plain">
    <hz-error wx:if="{{error}}" message="{{error}}" />
    <hz-info-rows rows="{{sourceTop}}" cols />
    <view wx:for="{{sourceSections}}" wx:key="key" wx:for-item="section" class="u-sheet-form__group">
      <text class="u-section__title">{{section.title}}</text>
      <view wx:for="{{section.blocks}}" wx:key="key" class="u-info" data-key="{{item.key}}" data-kind="{{item.kind}}" bindtap="onOpenBlock">
        <view class="u-info__head"><text class="u-info__title">{{item.title}}</text><text wx:if="{{item.link}}" class="hz-icon hz-icon--chevron-right"></text></view>
        <hz-info-rows rows="{{item.fields}}" cols />
      </view>
    </view>
  </view>
</hz-sheet>
</block>
