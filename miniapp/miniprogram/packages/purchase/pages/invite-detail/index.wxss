.hz-share-card {
  overflow: hidden;
  padding: 0;
}

.hz-share-card__title {
  display: block;
  padding: var(--hz-row-pad) var(--hz-card-pad);
  font-size: var(--hz-font-md);
}

.hz-share-card__cover {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96px;
}

.hz-share-card__logo {
  position: relative;
  height: 40px;
}

.hz-share-card__foot {
  display: block;
  padding: var(--hz-line-gap) var(--hz-card-pad);
}

.hz-share-copy {
  padding: var(--hz-row-pad) 0;
  border-top: 1px solid var(--hz-line);
}
