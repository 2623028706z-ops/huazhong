<wxs src="../../../../core/format.wxs" module="format" />
<hz-navbar title="{{title}}" />
<view class="u-list">
  <hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
  <block wx:else>
    <hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
    <hz-notice wx:if="{{notice}}" text="{{notice}}" />
    <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="list" /></block>
    <hz-state wx:elif="{{rows.length === 0}}" object="{{emptyObject}}" />
    <block wx:else>
      <hz-line-item lines="{{rows}}" mode="qty" removable bind:qty="onQty" bind:remove="onRemove" />
      <view class="hz-cart__clear">
        <hz-button kind="text" text="{{texts.clear}}" bind:press="onClear" />
      </view>
    </block>
  </block>
</view>
<!-- 结算条固定在底栏上面（02 章 hz-action-bar tabbar），空购物车、整页状态时不出 -->
<hz-action-bar wx:if="{{loaded && rows.length > 0 && failure.kind !== 'page'}}" tabbar>
  <view class="hz-cart__sum">
    <text class="u-serif-amount">{{format.formatMoney(total)}}</text>
    <text class="u-info__meta">{{countText}}</text>
  </view>
  <hz-button text="{{texts.checkout}}" disabled="{{count === 0 || notice !== ''}}" bind:press="onCheckout" />
</hz-action-bar>
<hz-tabbar tabs="{{tabs}}" current="cart" />
