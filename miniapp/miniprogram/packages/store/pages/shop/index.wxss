/* 订货：顶部信息 + 搜索，下面左侧分类、右侧产品（只写布局） */

/* 整页撑满一屏竖排，分栏占剩下的高度 */
page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.hz-shop__top {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: var(--hz-line-gap);
  padding: 12px var(--hz-gap-page) 0;
}

.hz-shop__head {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.hz-shop__body {
  flex: 1;
  min-height: 0;
  display: flex;
  margin-top: var(--hz-gap-controls);
}

.hz-shop__side {
  flex: none;
  width: 96px;
}

.hz-shop__main {
  flex: 1;
  min-width: 0;
  padding: 0 var(--hz-gap-page) 0 var(--hz-line-gap);
}

.hz-shop__product {
  display: flex;
  gap: var(--hz-row-pad);
  padding: var(--hz-row-pad);
  margin-bottom: var(--hz-card-gap);
}

.hz-shop__info {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.hz-shop__title {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

/* 价格「¥68.00/束」在上面单独一行，步进器靠右（窄栏里放一行会挤出卡片） */
.hz-shop__buy {
  display: flex;
  justify-content: flex-end;
}

.hz-shop__bar {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: var(--hz-tap);
}
