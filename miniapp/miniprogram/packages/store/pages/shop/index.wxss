/* 订货：顶部信息 + 搜索，下面左侧分类、右侧产品（只写布局） */

/* 整页撑满一屏竖排，分栏占剩下的高度 */
page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.hz-shop__top {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: var(--hz-line-gap);
  padding: 12px var(--hz-gap-page) 0;
}

.hz-shop__head {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.hz-shop__body {
  flex: 1;
  min-height: 0;
  display: flex;
  margin-top: var(--hz-gap-controls);
}

.hz-shop__side {
  flex: none;
  width: 96px;
}

.hz-shop__main {
  flex: 1;
  min-width: 0;
  padding: 0 var(--hz-gap-page) 0 var(--hz-line-gap);
  background: var(--hz-paper);
  border-top-left-radius: var(--hz-radius);
}

.hz-shop__product {
  display: flex;
  gap: var(--hz-row-pad);
  padding: var(--hz-row-pad) 0;
  border-bottom: 1px solid var(--hz-line);
}

.hz-shop__product:last-child {
  border-bottom: 0;
}

.hz-shop__price {
  flex: 1;
  min-width: 0;
}

.hz-shop__info {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.hz-shop__title {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

/* 价格在左、步进器靠右同一行 */
.hz-shop__buy {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 6px;
}

.hz-shop__product .u-thumbs__item {
  width: 84px;
  height: 84px;
  flex: none;
  border-radius: var(--hz-radius-button);
}

.hz-shop__plus {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  color: var(--hz-brand);
  border: 1px solid var(--hz-brand);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: var(--hz-font-lg);
}

.hz-shop__placeholder {
  background: var(--hz-tint);
  color: var(--hz-muted);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hz-shop__clear {
  display: flex;
  justify-content: flex-end;
}
