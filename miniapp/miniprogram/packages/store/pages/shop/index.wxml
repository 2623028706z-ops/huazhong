<wxs src="../../../../core/format.wxs" module="format" />
<hz-cover mode="full" />
<hz-navbar title="{{title}}" back="{{isEdit}}" />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
<block wx:else>
  <view class="hz-shop__top">
    <hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
    <hz-error wx:if="{{catalogError}}" message="{{catalogError}}" />
    <hz-brand />
    <view wx:if="{{!headerCollapsed}}" class="hz-shop__head">
      <text class="u-info__title">{{head}}</text>
      <text class="u-info__meta">{{dateLabel}} {{date}}　　{{countText}}</text>
    </view>
    <hz-notice wx:if="{{notice}}" text="{{notice}}" />
    <hz-search value="{{keyword}}" placeholder="{{searchPlaceholder}}" bind:search="onSearch" />
  </view>
  <view class="hz-shop__body">
    <view wx:if="{{!keyword}}" class="hz-shop__side">
      <hz-side-list items="{{categories}}" value="{{categoryId}}" bind:change="onCategory" />
    </view>
    <scroll-view class="hz-shop__main" scroll-y bindscroll="onProductScroll">
      <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="list" /></block>
      <hz-state wx:elif="{{products.length === 0}}" object="{{emptyObject}}" />
      <view wx:for="{{products}}" wx:key="id" class="u-card hz-shop__product">
        <image wx:if="{{item.thumbUrl}}" class="u-thumbs__item" src="{{item.thumbUrl}}" mode="aspectFill" lazy-load data-key="{{item.id}}" binderror="onImageError" />
        <view wx:else class="u-thumbs__item hz-shop__placeholder"><text class="hz-icon hz-icon--image"></text></view>
        <view class="hz-shop__info">
          <view class="hz-shop__title">
            <text class="u-info__title">{{item.name}}</text>
            <text wx:if="{{item.code}}" class="u-info__meta">{{item.code ? '编码 ' + item.code : ''}}</text>
            <text class="u-serif-amount u-ellipsis">{{item.priceText}}</text>
          </view>
          <view class="hz-shop__buy">
            <view wx:if="{{item.qty===0}}" class="hz-shop__plus" aria-role="button" aria-label="{{texts.add}}" data-key="{{item.id}}" bindtap="onAdd">＋</view>
            <block wx:else><hz-stepper value="{{item.qty}}" min="{{0}}" data-key="{{item.id}}" bind:change="onQty" /><text>{{item.unit}}</text></block>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  <hz-action-bar settlement tabbar="{{!isEdit}}">
    <view class="u-bar-total" bindtap="onOpenCart">
      <text class="u-serif-amount">{{format.formatMoney(cartTotal)}}</text>
      <text class="u-info__meta">{{cartText}}</text>
    </view>
    <hz-button text="{{texts.checkout}}" disabled="{{cartCount === 0 || notice}}" reason="{{notice}}" bind:press="onCheckout" />
  </hz-action-bar>
</block>
<hz-sheet show="{{cartSheet}}" title="{{texts.picked}}" footer bind:close="onCloseCart">
  <view class="u-sheet-form">
    <hz-line-item lines="{{cartRows}}" mode="qty" removable bind:qty="onCartQty" bind:remove="onCartRemove" />
  </view>
  <hz-button slot="footer" kind="secondary" text="{{texts.clear}}" bind:press="onClear" />
  <hz-button slot="footer" text="{{texts.checkout}}" disabled="{{cartCount === 0 || notice}}" reason="{{notice}}" bind:press="onCheckout" />
</hz-sheet>

<hz-tabbar wx:if="{{!isEdit}}" tabs="{{tabs}}" current="shop" />
<hz-confirm id="hz-confirm" />
