<wxs src="../../../../core/format.wxs" module="format" />
<hz-cover mode="full" />
<!-- 订货页定稿不写页名，抬头就是字标和门店名；改单模式有返回、写页名 -->
<hz-navbar title="{{isEdit ? title : ''}}" back="{{isEdit}}" guard="{{isEdit && note !== initialNote}}" />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
<block wx:else>
  <view class="hz-shop__top">
    <hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
    <hz-error wx:if="{{catalogError}}" message="{{catalogError}}" />
    <hz-brand no-date />
    <view wx:if="{{!headerCollapsed}}" class="hz-shop__head">
      <text class="u-info__title">{{head}}</text>
      <text class="u-info__meta">{{countText}}<block wx:if="{{date}}">　|　{{date}}</block></text>
    </view>
    <hz-notice wx:if="{{notice}}" text="{{notice}}" />
    <hz-search value="{{keyword}}" placeholder="{{searchPlaceholder}}" bind:search="onSearch" />
    <view wx:if="{{lastOrder && !isEdit && !keyword}}" class="u-card hz-shop__last">
      <text class="hz-icon hz-icon--rotate-ccw hz-shop__last-icon"></text>
      <view class="hz-shop__last-main"><text class="hz-shop__last-title">{{lastOrder.title}}</text><text class="u-info__meta u-ellipsis">{{lastOrder.meta}}</text></view>
      <view class="hz-shop__reorder u-tap {{notice ? 'hz-shop__reorder--off' : ''}}" aria-role="button" aria-disabled="{{!!notice}}" bindtap="onReorder">{{texts.reorder}}</view>
    </view>
  </view>
  <view class="hz-shop__body">
    <view wx:if="{{!keyword}}" class="hz-shop__side">
      <hz-side-list items="{{categories}}" value="{{categoryId}}" bind:change="onCategory" />
    </view>
    <scroll-view class="hz-shop__main" scroll-y bindscroll="onProductScroll">
      <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="list" /></block>
      <hz-state wx:elif="{{products.length === 0}}" object="{{emptyObject}}" />
      <view wx:for="{{products}}" wx:key="id" class="hz-shop__product">
        <image wx:if="{{item.thumbUrl}}" class="u-thumbs__item" src="{{item.thumbUrl}}" mode="aspectFill" lazy-load data-key="{{item.id}}" binderror="onImageError" />
        <view wx:else class="u-thumbs__item hz-shop__placeholder"><text class="hz-icon hz-icon--image"></text></view>
        <view class="hz-shop__info">
          <view class="hz-shop__title">
            <text class="u-info__title">{{item.name}}</text>
            <text wx:if="{{item.code}}" class="u-info__meta">{{texts.code}} {{item.code}}</text>
          </view>
          <view class="hz-shop__buy">
            <text class="u-serif-amount u-ellipsis hz-shop__price">{{item.priceText}}</text>
            <view wx:if="{{item.qty===0}}" class="hz-shop__plus" aria-role="button" aria-label="{{texts.add}}" data-key="{{item.id}}" bindtap="onAdd">＋</view>
            <view wx:else class="hz-shop__qty"><hz-stepper value="{{item.qty}}" min="{{0}}" data-key="{{item.id}}" bind:change="onQty" /><text>{{item.unit}}</text></view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
  <hz-action-bar settlement tabbar="{{!isEdit}}">
    <view class="u-cart" bindtap="onOpenCart">
      <view class="u-cart__icon"><text class="hz-icon hz-icon--shopping-cart"></text><text wx:if="{{cartRows.length}}" class="u-cart__badge">{{cartRows.length}}</text></view>
      <view class="u-bar-total">
        <text class="u-bar-total__amount">{{format.formatMoney(cartTotal)}}</text>
        <text wx:if="{{cartText}}" class="u-bar-total__meta">{{cartText}}</text>
      </view>
    </view>
    <hz-button kind="round" text="{{isEdit ? texts.reviewEdit : texts.checkout}}" disabled="{{cartCount === 0 || notice}}" reason="{{notice}}" bind:press="onCheckout" />
  </hz-action-bar>
</block>
<hz-sheet show="{{cartSheet}}" title="{{pickedTitle}}" footer bind:close="onCloseCart">
  <view class="u-sheet-form">
    <hz-error wx:if="{{formError}}" message="{{formError}}" />
    <hz-notice wx:if="{{notice}}" text="{{notice}}" />
    <hz-notice wx:if="{{reviewNotice}}" text="{{reviewNotice}}" />
    <view wx:if="{{isEdit}}" class="hz-shop__changes">
      <text class="u-sheet-section__title">{{texts.changedLines}}</text>
      <view wx:for="{{editChanges}}" wx:key="key" class="u-sheet-row"><text>{{item.name}}</text><text class="hz-shop__change-qty">{{item.text}}</text></view>
      <text wx:if="{{!editChanges.length}}" class="u-caption">{{texts.noChange}}</text>
    </view>
    <view class="hz-shop__clear"><hz-button kind="quiet" text="{{texts.clear}}" bind:press="onClear" /></view>
    <hz-line-item lines="{{cartRows}}" mode="qty" removable bind:qty="onCartQty" bind:remove="onCartRemove" />
    <hz-field label="{{texts.note}}" type="textarea" placeholder="{{texts.optional}}" value="{{note}}" bind:change="onNote" />
    <view class="u-sheet-row"><text>{{texts.orderAmount}}</text><view class="u-bar-total hz-shop__sheet-total"><text class="u-bar-total__amount">{{format.formatMoney(cartTotal)}}</text><text wx:if="{{cartText}}" class="u-bar-total__meta">{{cartText}}</text></view></view>
  </view>
  <hz-button slot="footer" text="{{needsReview ? texts.recheck : isEdit ? texts.saveEdit : texts.submit}}" loading="{{saving}}" disabled="{{(cartRows.length === 0 && !isEdit) || notice}}" reason="{{notice}}" bind:press="onSubmit" />
</hz-sheet>

<hz-tabbar wx:if="{{!isEdit}}" tabs="{{tabs}}" current="shop" />
<hz-confirm id="hz-confirm" />
