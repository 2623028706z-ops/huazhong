<import src="/views/detail.wxml" />
<hz-navbar title="{{title}}" back />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
<view wx:else class="u-list">
  <hz-realtime-bar text="{{realtime}}" />
  <hz-error wx:if="{{failure}}" message="{{failure.message}}" request-id="{{failure.requestId}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="detail" /></block>
  <template wx:elif="{{view}}" is="order-body" data="{{...view}}" />
</view>
<template is="buttons" data="{{buttons, busy}}" />
<hz-reason-sheet
  show="{{sheet}}"
  title="{{texts.cancelTitle}}"
  required="{{sheetRequired}}"
  body="{{texts.cancelBody}}"
  confirm="{{texts.confirmCancel}}"
  error="{{sheetError}}"
  loading="{{busy === 'storeCancel'}}"
  bind:close="onCloseSheet"
  bind:submit="onCancel"
/>
