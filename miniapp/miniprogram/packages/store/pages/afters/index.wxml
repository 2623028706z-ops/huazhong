<import src="/views/pick.wxml" />
<import src="/views/list.wxml" />
<import src="/views/detail.wxml" />
<hz-navbar title="{{title}}" back />
<view class="u-list">
  <hz-filter-bar status-kind="{{statusKind}}" statuses="{{statuses}}" counts="{{counts}}" date-label="{{dateLabel}}" value="{{filter}}" bind:change="onFilter" />
  <template is="list-state" data="{{failure, skeleton, loaded, rows, emptyObject}}" />
  <template is="cards" data="{{rows, statusKind, done, allLoaded}}" />
</view>
<hz-action-bar wx:if="{{canApply}}">
  <hz-button text="{{texts.apply}}" bind:press="onApply" />
</hz-action-bar>
<template is="pick-sheet" data="{{show: pickSheet, title: texts.pickTitle, picks, empty: texts.noPick, error: pickError}}" />
<hz-sheet show="{{detailSheet}}" title="{{texts.detailTitle}}" bind:close="onCloseDetail">
  <view class="u-sheet-form u-sheet-plain">
    <hz-error wx:if="{{detailError}}" message="{{detailError}}" />
    <template wx:if="{{detail}}" is="after-body" data="{{...detail}}" />
  </view>
</hz-sheet>
