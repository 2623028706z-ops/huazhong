<import src="/views/pick.wxml" />
<import src="/views/detail.wxml" />
<hz-navbar title="{{title}}" back guard="{{lines.length > 0}}" />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
<view wx:else class="u-list">
  <hz-error wx:if="{{formError}}" message="{{formError}}" />
  <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="form" /></block>
  <block wx:else>
    <template is="info" data="{{rows: info}}" />
    <view class="u-card u-info">
      <view class="hz-store-after__row u-info__head"><text>{{texts.lines}}</text><text>{{texts.qty}}</text><text>{{texts.unit}}</text><text>{{texts.reason}}</text></view>
      <view wx:for="{{tableRows}}" wx:key="orderLineId" class="hz-store-after__row" data-index="{{index}}" bindtap="onEditLine">
        <view><text class="u-info__title">{{item.name}}</text><text class="u-info__meta">{{texts.code}} {{item.code}}　　{{item.maxText}} {{item.unit}}　　{{item.imageText}}</text></view>
        <text>{{item.qty}}</text><text>{{item.unit}}</text><text>{{item.reasonText}}</text>
      </view>
    </view>
    <hz-add-button text="{{texts.add}}" bind:press="onOpenPick" />
  </block>
</view>
<hz-action-bar><hz-button text="{{texts.submit}}" loading="{{saving}}" disabled="{{uploading}}" bind:press="onSubmit" /></hz-action-bar>
<template is="pick-sheet" data="{{show: pickSheet, title: texts.pickTitle, picks, empty: texts.noPick, multi: true, count: pickCount, confirm: pickConfirm}}" />
<hz-sheet center guard="{{editChanged}}" show="{{editIndex >= 0}}" title="{{editLine.name}}" footer bind:close="onCloseEditor">
  <view class="u-sheet-form">
    <view class="u-sheet-row"><text>{{texts.qty}}</text><view><text>{{editLine.maxText}}</text><hz-stepper value="{{editLine.qty}}" min="{{1}}" max="{{editLine.maxQty}}" data-index="{{editIndex}}" bind:change="onQty" /><text>{{editLine.unit}}</text></view></view>
    <text wx:if="{{editError.qty}}" class="u-field__error">{{editError.qty}}</text>
    <hz-choices label="{{texts.reason}}" options="{{reasonOptions}}" value="{{editLine.reason ? [editLine.reason] : []}}" error="{{editError.reason}}" data-index="{{editIndex}}" bind:change="onReason" />
    <hz-field label="{{texts.description}}" type="textarea" placeholder="{{texts.optional}}" value="{{editLine.description}}" error="{{editError.description}}" data-index="{{editIndex}}" bind:change="onDescription" />
    <text class="u-field__label">{{editLine.reason === 'qty_mismatch' ? texts.imagesOptional : texts.images}}</text><hz-upload files="{{editLine.images}}" data-index="{{editIndex}}" bind:add="onAddImages" bind:remove="onRemoveImage" />
    <text wx:if="{{editError.images}}" class="u-field__error">{{editError.images}}</text>
  </view>
  <hz-button slot="footer" kind="secondary" text="{{texts.remove}}" disabled="{{uploading}}" bind:press="onDeleteEditor" />
  <hz-button slot="footer" text="{{texts.confirm}}" disabled="{{uploading}}" bind:press="onConfirmEditor" />
</hz-sheet>
<hz-confirm id="hz-confirm" />
