<hz-cover />
<hz-navbar transparent />
<view class="u-home">
  <hz-brand lead="{{lead}}" person="{{person}}" />
  <view class="u-home__body">
    <hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
    <hz-error wx:elif="{{failure}}" message="{{failure.message}}" retry bind:retry="onFailureAction" />
    <block wx:else>
      <hz-notice wx:if="{{notice}}" text="{{notice}}" />
      <hz-hub wx:if="{{hero}}" hero="{{hero}}" minis="{{minis}}" bind:select="onSelect" />
    </block>
  </view>
</view>
<hz-tabbar tabs="{{tabs}}" current="home" />
