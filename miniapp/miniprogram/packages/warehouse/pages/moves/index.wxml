<import src="/views/list.wxml" /><hz-navbar title="{{title}}" back /><view class="u-list"><view class="u-segments"><view wx:for="{{['','in','out']}}" wx:key="*this" class="u-segments__item {{filter.status===item?'u-segments__item--on':''}}" data-key="{{item}}" bindtap="onDirection">{{item===''?texts.all:item==='in'?texts.in:texts.out}}</view></view><hz-filter-bar date-label="{{dateLabel}}" value="{{filter}}" bind:change="onFilter" /><template is="list-state" data="{{failure,skeleton,loaded,rows,emptyObject}}" /><view wx:for="{{groups}}" wx:key="day" wx:for-item="group" class="u-section"><text class="u-section__title">{{group.title}}</text><template is="cards" data="{{rows:group.rows}}" /></view><text wx:if="{{done && rows.length}}" class="u-list__end">{{allLoaded}}</text></view>
