<import src="/views/list.wxml" />
<import src="/views/stock.wxml" />
<hz-navbar title="{{title}}" back />
<view class="u-list">
  <template is="material-head" data="{{...head}}" />
  <hz-filter-bar sections="{{sections}}" section="{{filter.status}}" date-label="{{dateLabel}}" dimensions="{{dimensions}}" value="{{filter}}" bind:change="onFilter" bind:section="onDirection" />
  <template is="list-state" data="{{failure,skeleton,loaded,rows,emptyObject}}" />
  <view wx:for="{{groups}}" wx:key="day" wx:for-item="group" class="u-section"><text class="u-section__title">{{group.title}}</text><view class="u-card u-rows"><template wx:for="{{group.rows}}" wx:key="id" is="hz-stock-row" data="{{...item, openable: true}}" /></view></view>
  <text wx:if="{{done && rows.length}}" class="u-list__end">{{allLoaded}}</text>
</view>
