<import src="/views/pick.wxml" />
<hz-navbar title="{{title}}" back guard="{{changed}}" />
<view class="u-list">
  <hz-realtime-bar text="{{realtime}}" bind:refresh="onRealtime" />
  <hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" />
  <hz-error wx:elif="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  <hz-error wx:if="{{formError}}" message="{{formError}}" />
  <hz-skeleton wx:if="{{!loaded}}" type="form" />
  <block wx:else>
    <view wx:if="{{kind === 'in'}}" class="u-card u-form-card"><hz-picker id="doc-supplier" label="{{texts.supplier}}" options="{{supplierOptions}}" value="{{form.supplierId}}" error="{{fields.supplierId}}" bind:change="onSupplier" /></view>
    <view wx:if="{{kind === 'out'}}" class="u-card u-form-card"><view class="hz-form-row" bindtap="onOpenCategoryPick"><text class="hz-form-row__label">{{texts.outCategory}}</text><view class="hz-form-row__value"><text class="u-ellipsis {{categoryName ? '' : 'hz-form-row__hint'}}">{{categoryName || texts.pickHint}}</text><text class="hz-icon hz-icon--chevron-right hz-form-row__icon"></text></view></view><text wx:if="{{fields.outCategoryId}}" class="u-field__error">{{fields.outCategoryId}}</text></view>
    <view class="u-section"><hz-line-item id="add-material" material title="{{texts.materials}}" lines="{{lines}}" mode="price" quantity-only="{{kind !== 'in'}}" min="1" removable add-text="{{texts.add}}" bind:qty="onQty" bind:price="onPrice" bind:remove="onRemove" bind:add="onOpenPick" /><text wx:if="{{fields.lines}}" class="u-field__error">{{fields.lines}}</text></view>
    <view class="u-card u-form-card"><hz-field id="doc-reason" label="{{kind === 'loss' ? texts.lossReason : texts.reason}}" placeholder="{{texts.optional}}" value="{{form.reason}}" type="textarea" error="{{fields.reason}}" bind:change="onReason" /></view>
    <view wx:if="{{kind === 'loss'}}" class="u-section"><text class="u-section__title">{{texts.images}}</text><hz-upload files="{{form.images}}" bind:add="onAddImages" bind:remove="onRemoveImage" /><text wx:if="{{fields.imageFileIds}}" class="u-field__error">{{fields.imageFileIds}}</text></view>
  </block>
</view>
<hz-action-bar wx:if="{{loaded}}"><hz-button text="{{submitText}}" loading="{{saving || uploading}}" bind:press="onSubmit" /></hz-action-bar>
<template is="pick-sheet" data="{{show:pickSheet,title:texts.pick,placeholder:texts.searchMaterial,keyword:pickKeyword,picks,empty:texts.noPick,error:pickError,count:pickCount,confirm:pickConfirm,summary:pickSummary}}" />
<hz-confirm id="hz-confirm" />
<hz-sheet show="{{categoryPick}}" title="{{texts.pickOne}}" footer bind:close="onCloseCategoryPick">
  <view class="u-sheet-section"><view wx:for="{{categoryOptions}}" wx:key="id" class="u-choice {{item.id === form.outCategoryId ? 'u-choice--on' : ''}}" data-key="{{item.id}}" bindtap="onCategory"><text>{{item.name}}</text><text wx:if="{{item.id === form.outCategoryId}}" class="hz-icon hz-icon--check u-choice__check"></text></view></view>
  <hz-button slot="footer" kind="quiet" text="{{texts.manage}}" bind:press="onManageCategories" />
</hz-sheet>
