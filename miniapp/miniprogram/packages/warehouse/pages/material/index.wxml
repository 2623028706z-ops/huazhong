<import src="/views/detail.wxml" />
<hz-navbar title="{{title}}" back />
<view class="u-list">
  <hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" />
  <hz-error wx:elif="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  <hz-skeleton wx:if="{{!loaded}}" type="detail" />
  <block wx:else>
    <template is="info" data="{{title:material.name,rows}}" />
    <view class="u-section"><text class="u-section__title">{{texts.batches}}</text><view class="u-card u-info"><view wx:for="{{batches}}" wx:key="id" class="u-sheet-row"><text>{{item.date}}</text><text>{{item.qty}}</text></view></view></view>
  </block>
</view>
<template is="buttons" data="{{buttons}}" />
