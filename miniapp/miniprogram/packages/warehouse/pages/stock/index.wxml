<import src="/views/list.wxml" />
<import src="/views/stock.wxml" />
<hz-navbar title="{{title}}" back="{{back}}" />
<view class="u-list">
  <hz-filter-bar search-placeholder="{{search}}" sections="{{sections}}" section="{{section}}" dimensions="{{dimensions}}" value="{{filter}}" bind:change="onFilter" bind:section="onSection" />
  <template is="list-state" data="{{failure,skeleton,loaded,rows,emptyObject}}" />
  <template is="hz-stock-groups" data="{{groups, openable: true}}" />
  <text wx:if="{{done && rows.length}}" class="u-list__end">{{allLoaded}}</text>
</view>
<hz-action-bar tabbar="{{tabs.length > 0}}"><hz-button kind="secondary" text="{{texts.manage}}" bind:press="onManage" /><hz-button text="{{texts.create}}" bind:press="onCreate" /></hz-action-bar>
<hz-tabbar wx:if="{{tabs.length}}" tabs="{{tabs}}" current="stock" />
