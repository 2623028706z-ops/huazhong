<hz-navbar title="{{title}}" back guard="{{changed}}" />
<view class="u-list">
  <hz-realtime-bar text="{{realtime}}" bind:refresh="onRealtime" />
  <hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" /><hz-error wx:elif="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" /><hz-error wx:if="{{formError}}" message="{{formError}}" /><hz-skeleton wx:if="{{!loaded}}" type="form" />
  <block wx:else><view class="u-card u-info"><text>{{categories}}</text></view><view wx:for="{{rows}}" wx:key="materialId" class="u-card u-form-card"><view class="u-sheet-row"><text>{{item.name}}</text><hz-tag wx:if="{{!item.enabled}}" text="{{texts.disabled}}" warn /></view><view class="u-sheet-row"><text>{{texts.bookQty}}</text><text>{{item.book}}</text></view><hz-field label="{{item.actualLabel}}" type="number" value="{{item.actualText}}" error="{{item.error}}" data-index="{{index}}" bind:change="onActual" /><view wx:if="{{item.diff}}" class="u-sheet-row"><text>{{texts.difference}}</text><text>{{item.diff}}</text></view></view><view class="u-card u-form-card"><hz-field label="{{texts.diffReason}}" type="textarea" value="{{form.reason}}" error="{{fields.reason}}" bind:change="onReason" /></view></block>
</view>
<hz-action-bar wx:if="{{loaded}}"><hz-button text="{{texts.submit.stocktake}}" loading="{{saving}}" bind:press="onSubmit" /></hz-action-bar>
<hz-confirm id="hz-confirm" />
