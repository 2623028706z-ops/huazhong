<hz-navbar title="{{title}}" back guard="{{changed}}" />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" />
<view wx:else class="u-list">
  <hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  <hz-error wx:if="{{error}}" message="{{error}}" />
  <hz-skeleton wx:if="{{!loaded}}" type="form" />
  <block wx:else>
    <view class="u-card u-form-card">
      <view class="u-sheet-row">
        <text class="u-sheet-row__label">{{kind === 'supplier' ? texts.supplier : texts.customer}}</text>
        <text class="u-sheet-row__value">{{partyName}}</text>
      </view>
      <view class="u-sheet-row" bindtap="onOpenPeriod">
        <text class="u-sheet-row__label">{{texts.period}}</text>
        <text class="u-sheet-row__value">{{periodText}}<text class="hz-icon hz-icon--chevron-right"></text></text>
      </view>
      <view class="u-sheet-row">
        <text class="u-sheet-row__label">{{texts.statementDate}}</text>
        <text class="u-sheet-row__value">{{today}}</text>
      </view>
      <hz-field label="{{texts.note}}" type="textarea" value="{{note}}" placeholder="{{texts.optional}}" bind:change="onNote" />
    </view>
    <view wx:if="{{changes.length}}" class="u-card u-info">
      <view wx:for="{{changes}}" wx:key="*this">{{item}}</view>
    </view>
    <hz-statement-list title="{{main.title}}" meta="{{main.meta}}" groups="{{main.groups}}" empty-text="{{main.emptyText}}" bind:press="onSourceDetail" bind:toggle="onToggle" />
    <hz-statement-list title="{{afterSection.title}}" groups="{{afterSection.groups}}" empty-text="{{afterSection.emptyText}}" bind:press="onSourceDetail" bind:toggle="onToggle" />
    <hz-statement cells="{{cells}}" />
  </block>
</view>
<hz-action-bar>
  <view class="u-bar-total">
    <text class="u-serif-amount">{{kind === 'supplier' ? texts.payable : texts.receivable}} {{dueText}}</text>
  </view>
  <hz-button text="{{needsReview ? texts.review : texts.statementGenerate}}" loading="{{saving}}" bind:press="onSubmit" />
</hz-action-bar>
<hz-sheet show="{{periodSheet}}" title="{{texts.period}}" bind:close="onClosePeriod">
  <view class="u-sheet-form">
    <hz-picker label="{{texts.periodFrom}}" mode="date" value="{{periodFrom}}" end="{{periodTo}}" data-key="periodFrom" bind:change="onPeriod" />
    <hz-picker label="{{texts.periodTo}}" mode="date" value="{{periodTo}}" start="{{periodFrom}}" end="{{today}}" data-key="periodTo" bind:change="onPeriod" />
  </view>
</hz-sheet>
<hz-confirm id="hz-confirm" />
