<import src="/views/detail.wxml" /><hz-navbar title="{{title}}" back /><hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" /><view wx:else class="u-list"><hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" /><hz-skeleton wx:if="{{!loaded}}" type="detail" /><block wx:else><hz-notice wx:if="{{notice}}" text="{{notice}}" /><template is="info" data="{{...info}}" /><view class="u-card u-info"><hz-info-rows rows="{{amountRows}}" /></view><view wx:for="{{groups}}" wx:key="title" class="u-section"><text class="u-section__title">{{item.title}}</text><view wx:for="{{item.rows}}" wx:for-item="source" wx:key="id" data-key="{{source.id}}" bindtap="onSource"><hz-card row="{{source}}" /></view></view><text wx:if="{{!hasAfter}}" class="u-info__meta">{{texts.noAfter}}</text><view class="u-section"><text class="u-section__title">{{supplier ? texts.payments : texts.receipts}}</text><text wx:if="{{!settlements.length}}" class="u-info__meta">{{supplier ? texts.noPayment : texts.noReceipt}}</text><view wx:for="{{settlements}}" wx:key="id" data-key="{{item.id}}" bindtap="onFund"><hz-card row="{{item}}" status-kind="recordStatus" /></view></view><hz-button wx:if="{{canVoid && canShare && canRegister}}" kind="text" text="{{texts.statementVoid}}" disabled="{{voidDisabled}}" reason="{{voidReason}}" bind:press="onVoid" /></block></view><hz-action-bar wx:if="{{canShare || canRegister || canVoid}}"><hz-button wx:if="{{canShare}}" kind="secondary" text="{{texts.share}}" bind:press="onShare" /><hz-button wx:if="{{canRegister}}" text="{{supplier ? texts.registerPayment : texts.registerReceipt}}" bind:press="onRegister" /><hz-button wx:if="{{canVoid && !(canShare && canRegister)}}" text="{{texts.statementVoid}}" disabled="{{voidDisabled}}" reason="{{voidReason}}" bind:press="onVoid" /></hz-action-bar><hz-reason-sheet show="{{voidSheet}}" title="{{texts.statementVoid}}" required confirm="{{texts.confirmVoid}}" error="{{error}}" loading="{{busy}}" bind:close="onCloseVoid" bind:submit="onSubmitVoid" />
