.hz-receive-pick__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: var(--hz-row-pad) var(--hz-card-pad) var(--hz-line-gap);
  border-bottom: 1px solid var(--hz-line);
}

.hz-receive-pick__title {
  font-size: var(--hz-font-md);
}

.hz-receive-pick__hint {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-receive-pick__empty {
  display: block;
  padding: var(--hz-row-pad) var(--hz-card-pad);
  font-size: var(--hz-font);
  color: var(--hz-muted);
}

.hz-receive-pick__row {
  display: flex;
  gap: var(--hz-line-gap);
  align-items: flex-start;
  padding: var(--hz-row-pad) var(--hz-card-pad);
}

.hz-receive-pick__row + .hz-receive-pick__row {
  border-top: 1px solid var(--hz-line);
}

.hz-receive-pick__body {
  display: flex;
  flex-direction: column;
  gap: var(--hz-space-1);
  font-size: var(--hz-font);
}

.hz-receive-pick__meta {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.hz-receive-pick__due {
  font-size: var(--hz-font-md);
  color: var(--hz-ink);
}

.hz-receive-fold {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--hz-row-pad) var(--hz-card-pad);
  font-size: var(--hz-font);
  color: var(--hz-muted);
}
