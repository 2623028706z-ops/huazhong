<hz-navbar title="{{title}}" back guard="{{changed}}" />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
<view wx:else class="u-list">
  <hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  <hz-error wx:if="{{formError}}" message="{{formError}}" />
  <hz-button wx:if="{{needsReview}}" kind="secondary" text="{{texts.recheck}}" bind:press="onReviewLedger" />
  <view wx:if="{{ledgerChanges.length}}" class="u-card u-info"><text class="u-section__title">本次重核变化</text><view wx:for="{{ledgerChanges}}" wx:key="*this" class="u-info__meta">{{item}}</view></view>
  <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="form" /></block>
  <block wx:else>
    <!-- 核销预收只选客户，不写组标题 -->
    <view class="u-section">
      <text wx:if="{{!isAllocate}}" class="u-section__title">{{texts.receipt}}</text>
      <view class="u-card u-form-card">
        <hz-picker label="{{texts.customer}}" options="{{customerOptions}}" value="{{customerId}}" error="{{fields.customerId}}" bind:change="onCustomer" />
        <block wx:if="{{!isAllocate}}">
          <hz-picker label="{{texts.date}}" mode="date" value="{{form.receiptDate}}" end="{{today}}" error="{{fields.receiptDate}}" bind:change="onDate" />
          <hz-field label="{{texts.amount}}" type="digit" value="{{form.amountText}}" error="{{fields.amountCents}}" bind:change="onAmount" />
          <hz-picker label="{{texts.method}}" options="{{methodOptions}}" value="{{form.methodName}}" error="{{fields.methodName}}" bind:change="onMethod" />
          <hz-field label="{{texts.note}}" type="textarea" placeholder="{{texts.optional}}" value="{{form.note}}" bind:change="onNote" />
        </block>
      </view>
    </view>
    <view wx:if="{{customerId}}" class="u-section">
      <text class="u-section__title">{{texts.allocDetail}}</text>
      <text wx:if="{{allocRows.length === 0}}" class="u-info__meta">{{texts.empty}}</text>
      <view wx:for="{{allocRows}}" wx:key="orderId" class="u-card u-form-card">
        <view class="u-info__head">
          <text class="u-info__title">{{item.name}}</text>
          <text class="u-serif-amount u-amount">{{item.sub}}</text>
        </view>
        <hz-button wx:if="{{item.notice}}" kind="text" text="{{item.notice}} · 查看退货与改价记录" data-key="{{item.orderId}}" bind:press="onOpenDocument" />
        <view class="u-info__head">
          <hz-field label="{{texts.allocThis}}" type="digit" value="{{item.text}}" data-index="{{index}}" bind:change="onAlloc" />
          <hz-button kind="text" text="{{texts.fill}}" data-index="{{index}}" bind:press="onFill" />
        </view>
      </view>
      <hz-notice text="{{summary}}" />
    </view>
  </block>
</view>
<hz-action-bar>
  <hz-button text="{{isAllocate ? texts.confirmAllocate : texts.confirmReceipt}}" loading="{{saving}}" disabled="{{!customerId}}" bind:press="onSubmit" />
</hz-action-bar>
<hz-confirm id="hz-confirm" />
