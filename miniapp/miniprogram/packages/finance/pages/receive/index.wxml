<hz-navbar title="{{title}}" back guard="{{changed}}" /><hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" /><view wx:else class="u-list"><hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" /><hz-error wx:if="{{formError}}" message="{{formError}}" /><view wx:if="{{changes.length}}" class="u-card u-info"><view wx:for="{{changes}}" wx:key="*this">{{item}}</view></view><hz-skeleton wx:if="{{!loaded}}" type="form" /><block wx:else><view class="u-card u-form-card"><hz-picker label="{{isPayment ? texts.supplier : texts.customer}}" options="{{partyOptions}}" value="{{partyId}}" error="{{fields.customerId || fields.supplierId}}" bind:change="onParty" /></view><view class="u-section"><text class="u-section__title">{{texts.statements}}</text><text wx:if="{{partyId && !rows.length}}">{{texts.noStatements}}</text><view wx:for="{{rows}}" wx:key="id" class="hz-finance-select" data-key="{{item.id}}" bindtap="onStatement"><text class="hz-finance-select__check">{{item.selected?'☑':'☐'}}</text><view class="hz-finance-select__card"><hz-card row="{{item}}" status-kind="statementStatus" /></view></view></view><view class="u-card u-form-card"><hz-picker label="{{isPayment ? texts.paymentDate : texts.receiptDate}}" mode="date" value="{{form.receiptDate}}" end="{{today}}" error="{{fields.receiptDate || fields.payDate}}" data-key="receiptDate" bind:change="onField" /><hz-field label="{{isPayment ? texts.paymentAmount : texts.receiptAmount}}" type="digit" value="{{form.amountText}}" suffix="{{texts.currency}}" error="{{fields.amountCents}}" data-key="amountText" bind:change="onField" /><hz-field label="{{texts.discount}}" type="digit" value="{{form.discountText}}" suffix="{{texts.currency}}" placeholder="{{texts.optional}}" error="{{fields.discountCents}}" data-key="discountText" bind:change="onField" /><hz-field wx:if="{{form.discountText && form.discountText !== '0'}}" label="{{texts.discountReason}}" value="{{form.discountReason}}" error="{{fields.discountReason}}" data-key="discountReason" bind:change="onField" /><hz-picker label="{{isPayment ? texts.paymentMethod : texts.receiptMethod}}" options="{{methodOptions}}" value="{{form.methodName}}" error="{{fields.methodName}}" data-key="methodName" bind:change="onField" /><hz-field label="{{texts.note}}" placeholder="{{texts.optional}}" value="{{form.note}}" data-key="note" bind:change="onField" /></view><hz-notice text="{{summary}}" /></block></view><hz-action-bar><hz-button text="{{needsReview ? texts.review : isPayment ? texts.confirmPayment : texts.confirmReceipt}}" loading="{{saving}}" disabled="{{!partyId}}" bind:press="onSubmit" /></hz-action-bar><hz-confirm id="hz-confirm" />
