<hz-navbar title="{{title}}" back guard="{{changed}}" /><hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" /><view wx:else class="u-list"><hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" /><hz-error wx:if="{{formError}}" message="{{formError}}" /><view wx:if="{{changes.length}}" class="u-card u-info"><view wx:for="{{changes}}" wx:key="*this">{{item}}</view></view><hz-skeleton wx:if="{{!loaded}}" type="form" /><block wx:else><view class="u-card u-form-card"><view wx:if="{{partyLocked}}" class="u-sheet-row"><text class="u-sheet-row__label">{{isPayment ? texts.supplier : texts.customer}}</text><text class="u-sheet-row__value">{{partyName}}</text></view><hz-picker wx:else label="{{isPayment ? texts.supplier : texts.customer}}" options="{{partyOptions}}" value="{{partyId}}" error="{{fields.customerId || fields.supplierId}}" bind:change="onParty" /></view><view class="u-card hz-receive-pick"><view class="hz-receive-pick__head"><text class="u-serif hz-receive-pick__title">{{texts.statements}}</text><text class="hz-receive-pick__hint">{{isPayment ? texts.pickToPay : texts.pickToReceive}}</text></view><text wx:if="{{partyId && !rows.length}}" class="hz-receive-pick__empty">{{texts.noStatements}}</text><view wx:for="{{rows}}" wx:key="id" class="hz-receive-pick__row" data-key="{{item.id}}" bindtap="onStatement"><view class="u-check {{item.selected ? 'u-check--on' : ''}}"><text wx:if="{{item.selected}}" class="hz-icon hz-icon--check"></text></view><view class="hz-receive-pick__body"><text>{{texts.no}} {{item.no}}</text><text class="hz-receive-pick__meta">{{texts.period}} {{item.period}}</text><text class="hz-receive-pick__meta">{{isPayment ? texts.payable : texts.receivable}} <text class="u-serif-amount hz-receive-pick__due">{{item.due}}</text></text></view></view></view><view class="u-card u-form-card"><hz-picker label="{{isPayment ? texts.paymentDate : texts.receiptDate}}" mode="date" value="{{form.receiptDate}}" end="{{today}}" error="{{fields.receiptDate || fields.payDate}}" data-key="receiptDate" bind:change="onField" /><hz-field label="{{isPayment ? texts.paymentAmount : texts.receiptAmount}}" type="digit" value="{{form.amountText}}" suffix="{{texts.currency}}" error="{{fields.amountCents}}" data-key="amountText" bind:change="onField" /><hz-field label="{{texts.discount}}" type="digit" value="{{form.discountText}}" suffix="{{texts.currency}}" placeholder="{{texts.optional}}" error="{{fields.discountCents}}" data-key="discountText" bind:change="onField" /><hz-field label="{{texts.discountReason}}" placeholder="{{texts.discountReasonHint}}" value="{{form.discountReason}}" error="{{fields.discountReason}}" data-key="discountReason" bind:change="onField" /><hz-picker label="{{isPayment ? texts.paymentMethod : texts.receiptMethod}}" options="{{methodOptions}}" value="{{form.methodName}}" error="{{fields.methodName}}" data-key="methodName" bind:change="onField" /><hz-field label="{{texts.note}}" type="textarea" placeholder="{{texts.optional}}" value="{{form.note}}" data-key="note" bind:change="onField" /></view></block></view><hz-action-bar><view class="u-bar-total"><text class="u-serif-amount">{{summary.due}}</text><text class="{{summary.short ? 'u-field__error' : 'u-info__meta'}}">{{summary.meta}}</text></view><hz-button text="{{needsReview ? texts.review : isPayment ? texts.confirmPayment : texts.confirmReceipt}}" loading="{{saving}}" disabled="{{!partyId}}" bind:press="onSubmit" /></hz-action-bar><hz-confirm id="hz-confirm" />
