<import src="/views/purchase.wxml" />
<import src="/views/payment-panel.wxml" />
<import src="/views/stock.wxml" />
<hz-navbar title="{{title}}" back />
<view class="u-list">
  <hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  <hz-skeleton wx:if="{{!loaded}}" type="detail" />
  <template wx:elif="{{stockView}}" is="stock-body" data="{{...stockView}}" />
  <template wx:elif="{{view}}" is="po-body" data="{{...view}}" />
  <view wx:if="{{allocations.length}}" class="u-section"><text class="u-section__title">完整核销历史</text>
    <view class="u-card u-info"><view wx:for="{{allocations}}" wx:key="id" class="u-info__line" data-key="{{item.key}}" bind:tap="onOpenPayment"><text>{{item.name}}</text><text>{{item.amount}}</text><text class="u-info__meta">{{item.sub}}</text></view></view>
  </view>
</view>
<template is="payment-panel" data="{{paymentLayer,paymentError,paymentFields,paymentReason,paymentBusy,paymentView,paymentTexts,refundForm,refundMethods}}" />
