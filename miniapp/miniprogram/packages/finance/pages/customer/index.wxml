<import src="/views/list.wxml" />
<import src="/views/detail.wxml" />
<import src="/views/payment-panel.wxml" />
<hz-navbar title="{{title}}" back />
<view class="u-list">
  <hz-filter-bar status-kind="{{statusKind}}" statuses="{{statuses}}" counts="{{counts}}" date-label="{{dateLabel}}" value="{{filter}}" bind:change="onFilter" />
  <hz-statement wx:if="{{cells.length > 0}}" cells="{{cells}}" />
  <view wx:if="{{refunds.length}}" class="u-section"><text class="u-section__title">退款记录</text><view class="u-card u-info"><view wx:for="{{refunds}}" wx:key="no" class="u-info__line" data-key="{{item.receiptId}}" bind:tap="onOpenReceipt">{{item.no}} · {{item.date}} · ¥{{item.amount}} · {{item.status}}</view></view></view>
  <template is="list-state" data="{{failure, skeleton, loaded, rows, emptyObject}}" />
  <template is="cards" data="{{rows, statusKind, done, allLoaded}}" />
</view>
<template is="buttons" data="{{buttons, busy}}" />
<hz-sheet show="{{layer !== ''}}" title="{{layerTitle}}" back="{{layers.length > 1}}" bind:close="onSheetClose" bind:back="onSheetBack">
  <view class="u-sheet-form u-sheet-plain">
    <hz-error wx:if="{{sheetError}}" message="{{sheetError}}" />
    <block wx:if="{{layer === 'order' && orderSheet}}">
      <template is="info" data="{{title: orderSheet.title, rows: orderSheet.rows}}" />
      <view wx:if="{{orderSheet.afters.length > 0}}" class="u-section">
        <text class="u-sheet-section__title">{{texts.after}}</text>
        <view wx:for="{{orderSheet.afters}}" wx:key="id" data-key="{{item.id}}" bindtap="onOpenAfter">
          <hz-card date="{{item.date}}" status-kind="afterStatus" status="{{item.status}}" title="{{item.title}}" total="{{item.total}}" meta="{{item.meta}}" amount="{{item.amount}}" amount-text="{{item.amountText}}" />
        </view>
      </view>
      <view wx:if="{{orderSheet.allocs.length > 0}}" class="u-section">
        <text class="u-sheet-section__title">{{texts.allocations}}</text>
        <view class="u-card u-rows">
          <view wx:for="{{orderSheet.allocs}}" wx:key="id" class="u-rows__item" data-key="{{item.key}}" bindtap="onOpenReceipt">
            <view class="u-info__head">
              <text>{{item.name}}</text>
              <text class="u-serif-amount u-amount">{{item.amount}}</text>
            </view>
            <text class="u-info__meta">{{item.sub}}</text>
          </view>
        </view>
      </view>
    </block>
    <block wx:if="{{layer === 'after' && afterSheet}}">
      <template is="after-body" data="{{...afterSheet}}" />
    </block>

  </view>
</hz-sheet>
<template is="payment-panel" data="{{paymentLayer,paymentFields,paymentView,paymentError,paymentReason,paymentBusy,paymentTexts,refundForm,refundMethods}}" />
