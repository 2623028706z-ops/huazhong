<hz-navbar title="{{title}}" back /><view class="u-list"><hz-error wx:if="{{failure || error}}" message="{{failure.message || error}}" retry bind:retry="onFailureAction" /><hz-skeleton wx:if="{{busy}}" type="detail" /><image wx:if="{{image}}" src="{{image}}" mode="widthFix" style="width:100%" /></view><canvas class="u-document-canvas" type="2d" id="documentCanvas" style="position:fixed;left:-10000px;width:720px;height:1px" /><hz-action-bar><hz-button kind="secondary" text="{{texts.saveImage}}" disabled="{{!image}}" bind:press="onSave" /><hz-button text="{{texts.sendImage}}" disabled="{{!image}}" bind:press="onSend" /></hz-action-bar>
