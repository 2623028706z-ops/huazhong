<hz-navbar title="{{title}}" back guard="{{changed}}" /><view class="u-list"><hz-error wx:if="{{failure || error}}" message="{{failure.message || error}}" retry="{{failure.retry}}" bind:retry="onFailureAction" /><hz-skeleton wx:if="{{!loaded}}" type="form" /><view wx:else class="u-card u-form-card"><view class="u-sheet-row"><text>{{supplier ? texts.supplier : texts.customer}}</text><text>{{partyName}}</text></view><hz-field label="{{texts.termDays}}" type="number" value="{{termText}}" suffix="{{texts.days}}" placeholder="{{texts.optional}}" data-key="termText" bind:change="onField" /><hz-field wx:if="{{openingEditable}}" label="{{texts.openingDebt}}" type="digit" value="{{openingText}}" suffix="{{texts.currency}}" data-key="openingText" bind:change="onField" /><block wx:else><view class="u-sheet-row"><text>{{texts.openingDebt}}</text><text>{{openingText}}</text></view><hz-notice text="{{texts.openingLocked}}" /></block></view><view class="u-info u-info__meta"><text>{{supplier ? texts.supplierTermDaysHint : texts.termDaysHint}}</text><text>{{supplier ? texts.supplierOpeningDebtHint : texts.openingDebtHint}}</text></view></view><hz-action-bar><hz-button text="{{needsReview ? texts.review : texts.save}}" loading="{{saving}}" bind:press="onSubmit" /></hz-action-bar><hz-confirm id="hz-confirm" />
