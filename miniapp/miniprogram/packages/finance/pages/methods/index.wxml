<hz-navbar title="{{title}}" back />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" />
<view wx:else class="u-list">
  <hz-error wx:if="{{failure}}" message="{{failure.message}}" retry bind:retry="onFailureAction" />
  <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="form" /></block>
  <view wx:for="{{sections}}" wx:key="kind" wx:for-item="section" class="u-section">
    <text class="u-section__title">{{section.title}}</text>
    <view class="u-card u-form-card">
      <hz-error wx:if="{{section.error}}" message="{{section.error}}" />
      <hz-switch wx:for="{{section.rows}}" wx:key="id" label="{{item.name}}" value="{{item.enabled}}" data-kind="{{section.kind}}" data-id="{{item.id}}" bind:change="onEnabled" />
      <view class="u-sheet-form__group">
        <hz-field label="{{texts.newMethod}}" value="{{section.newName}}" data-kind="{{section.kind}}" bind:change="onNewName" />
        <hz-button kind="secondary" text="{{texts.add}}" loading="{{busy === section.kind}}" data-kind="{{section.kind}}" bind:press="onAdd" />
      </view>
    </view>
  </view>
</view>
