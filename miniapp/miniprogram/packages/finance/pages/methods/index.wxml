<hz-navbar title="{{title}}" back />
<hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" request-id="{{failure.requestId}}" bind:action="onFailureAction" />
<view wx:else class="u-list">
  <hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
  <block wx:if="{{!loaded}}"><hz-skeleton wx:if="{{!failure}}" type="form" /></block>
  <view class="u-section">
    <view class="u-card u-form-card">
      <hz-error wx:if="{{listError}}" message="{{listError}}" />
      <hz-switch wx:for="{{rows}}" wx:key="id" label="{{item.name}}" value="{{item.enabled}}" data-id="{{item.id}}" bind:change="onEnabled" />
      <view class="hz-methods__add u-tap" bindtap="onOpenAdd"><text class="hz-icon hz-icon--plus"></text><text>{{addTitle}}</text></view>
    </view>
  </view>
</view>
<hz-sheet show="{{adding}}" title="{{addTitle}}" guard="{{newName !== ''}}" footer bind:close="onCloseAdd">
  <view class="u-sheet-form">
    <hz-error wx:if="{{formError}}" message="{{formError}}" />
    <hz-field label="{{texts.name}}" value="{{newName}}" error="{{fields.name}}" bind:change="onNewName" />
  </view>
  <hz-button slot="footer" text="{{texts.save}}" loading="{{saving}}" bind:press="onSave" />
</hz-sheet>
<hz-confirm id="hz-confirm" />
