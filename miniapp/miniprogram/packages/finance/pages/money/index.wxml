<import src="/views/detail.wxml" /><hz-navbar title="{{title}}" back /><hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" /><view wx:else class="u-list"><hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" /><hz-skeleton wx:if="{{!loaded}}" type="detail" /><block wx:else><hz-notice wx:if="{{view.notice}}" text="{{view.notice}}" /><template is="info" data="{{title:view.title,status:view.status,statusKind:view.statusKind,rows:view.rows}}" /><hz-statement-list title="{{texts.statements}}" groups="{{view.statements}}" empty-text="{{texts.noLinkedStatements}}" bind:press="onStatement" /></block></view><hz-action-bar wx:if="{{view.hasVoid}}"><hz-button kind="secondary" text="{{isPayment ? texts.voidPayment : texts.voidReceipt}}" disabled="{{view.voidDisabled}}" reason="{{view.voidReason}}" bind:press="onVoid" /></hz-action-bar><hz-reason-sheet show="{{voidSheet}}" title="{{isPayment ? texts.voidPayment : texts.voidReceipt}}" required confirm="{{texts.confirmVoid}}" error="{{error}}" loading="{{busy}}" bind:close="onCloseVoid" bind:submit="onSubmitVoid" />
