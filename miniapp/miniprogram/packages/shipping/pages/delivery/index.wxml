<hz-navbar title="{{title}}" back /><view class="u-list"><hz-error wx:if="{{failure}}" message="{{failure.message}}" retry bind:retry="onFailureAction" /><hz-skeleton wx:if="{{!image && !failure}}" type="detail" /><image wx:if="{{image}}" src="{{image}}" mode="widthFix" style="width:100%" /></view><view class="u-document-canvas" id="documentColors" /><hz-action-bar><hz-button kind="secondary" text="{{texts.save}}" disabled="{{!image}}" bind:press="onSave" /><hz-button text="{{texts.share}}" disabled="{{!image}}" bind:press="onShare" /></hz-action-bar>
