<import src="/views/list.wxml" />
<hz-navbar title="{{title}}" back />
<view class="u-list">
  <hz-filter-bar status-kind="{{statusKind}}" statuses="{{statuses}}" counts="{{counts}}" search-placeholder="{{searchPlaceholder}}" dimensions="{{dimensions}}" value="{{filter}}" bind:change="onFilter" />
  <template is="list-state" data="{{failure, skeleton, loaded, rows, emptyObject}}" />
  <template is="cards" data="{{rows, statusKind, done, allLoaded,selection:true}}" />
</view>

<hz-action-bar wx:if="{{filter.status !== 'shipped'}}"><hz-button kind="secondary" text="{{texts.allSelected}}" bind:press="onSelectAll" /><hz-button text="{{batchText}}" disabled="{{!selected.length}}" loading="{{batchBusy}}" bind:press="onOpenBatch" /></hz-action-bar>
<hz-confirm id="hz-confirm" />
