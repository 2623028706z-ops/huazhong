/* 设计变量：唯一出处，取值见 02 章第 2 节。组件和 TDesign 主题都读这些变量 */
page {
  /* 颜色 */
  --hz-brand: #b75d45; /* 陶土红：logo、图标、主按钮底、选中短线，不做文字色 */
  --hz-ink: #3b2a24; /* 标题、正文、金额、选中的文字 */
  --hz-muted: #7a5a4a; /* 次要文字、箭头 */
  --hz-paper: #fffbf6; /* 亮格：底栏、实底卡片、选中的格子 */
  --hz-card: #fffbf6db; /* 卡片（亮格 86%） */
  --hz-bg: #f6ebdf; /* 浅杏墙：页面底色 */
  --hz-hair: #ecd4c6; /* 描边、禁用按钮底色 */
  --hz-line: #f8ebe4; /* 卡片内分隔线 */
  --hz-tint: #f8ebe4; /* 头像底色 */
  --hz-green: #4c6a48; /* 完成 */
  --hz-green-bg: #e7ecdf;
  --hz-amber: #8a5a1e; /* 等待、警告标记 */
  --hz-amber-bg: #f6e7d2;
  --hz-grey: #6f665f; /* 结束、无效 */
  --hz-grey-bg: #eeeae5;
  --hz-danger: #a3313d; /* 报错（玫瑰红） */
  --hz-danger-bg: #f9e4e3;
  --hz-on-brand: #fff; /* 陶土红底上的字和图标 */

  /* 字体 */
  --hz-serif: 'HZ Serif', 'Songti SC', serif; /* 思源宋体子集，core/font.ts 加载 */
  --hz-font: 14px;
  --hz-font-badge: 10px; /* 底栏角标 */
  --hz-font-xs: 11px;
  --hz-font-sm: 12px;
  --hz-font-note: 13px; /* 只读明细第二行、记录、弹层区块、身份行 */
  --hz-font-md: 15px; /* 按钮、卡片对象、明细名称、金额、步进器数字 */
  --hz-font-lg: 16px; /* 入口卡名称、弹层标题 */
  --hz-font-title: 17px;
  --hz-font-amount: 18px; /* 对账格金额 */

  /* 图标（iconfont 用字号定大小） */
  --hz-icon-xs: 14px; /* 胶囊 × */
  --hz-icon-sm: 16px; /* 入口卡箭头 */
  --hz-icon: 18px;
  --hz-icon-md: 20px; /* 弹层左上 */
  --hz-icon-nav: 22px;
  --hz-icon-tab: 24px;
  --hz-icon-entry: 26px;

  /* 尺寸 */
  --hz-radius: 12px;
  --hz-radius-inner: 9px;
  --hz-radius-sheet: 14px;
  --hz-radius-pill: 999px; /* 状态标签、标记、胶囊、角标 */
  --hz-tap: 44px;
  --hz-nav: 44px;
  --hz-tabbar: 62px;
  --hz-input: 42px;
  --hz-textarea: 72px;

  /* 间距 */
  --hz-gap-page: 16px; /* 列表、详情、表单页左右 */
  --hz-gap-home: 20px; /* 铺品牌背景的页面左右：各首页、我的、模块首页、登录页 */
  --hz-gap-bar: 14px; /* 顶栏、搜索栏、底栏 */
  --hz-gap-sheet: 16px; /* 弹层内容 */
  --hz-card-pad: 16px;
  --hz-card-gap: 10px;
  --hz-row-pad: 12px;
  --hz-line-gap: 6px; /* 卡片内三行之间 */

  /* TDesign 主题：只改变量，不覆盖内部样式。变量名已按 1.17.0 核对 */
  --td-brand-color: var(--hz-brand);
  --td-radius-default: var(--hz-radius);

  /* 正文系统字体：TDesign 的 font 简写要用 */
  --td-font-family: -apple-system, 'PingFang SC', sans-serif;
  --td-text-color-primary: var(--hz-ink);
  --td-text-color-placeholder: var(--hz-muted);
}
