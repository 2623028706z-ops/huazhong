/* 基础重置：正文系统字体、正文色、页面底色 */
page {
  font-size: var(--hz-font);
  line-height: 1.5;
  color: var(--hz-ink);
  background: var(--hz-bg);
  -webkit-font-smoothing: antialiased;
}

view,
text,
image,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  font-size: inherit;
  line-height: inherit;
  color: inherit;
  background: none;
  border-radius: 0;
}

button::after {
  border: none;
}

image {
  display: block;
}
