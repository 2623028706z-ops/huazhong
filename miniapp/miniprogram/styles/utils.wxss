/* 公共片段：组件用这些类，不复制粘贴（01 章第 3.1 节） */

/* 1px 细线：伪元素 + 缩放，高分屏上也是一个物理像素 */
.u-hairline-bottom {
  position: relative;
}

.u-hairline-bottom::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1px;
  content: '';
  background: var(--hz-line);
  transform: scaleY(0.5);
  transform-origin: 0 100%;
}

/* 单行省略 */
.u-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 点击区域不小于 44px，外观可以更小 */
.u-tap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: var(--hz-tap);
  min-height: var(--hz-tap);
}

/* 底部安全区 */
.u-safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 衬线字：标题 500、金额 600 */
.u-serif {
  font-family: var(--hz-serif);
  font-weight: 500;
}

.u-serif-amount {
  font-family: var(--hz-serif);
  font-weight: 600;
}

/* 信息行里的金额：15px 墨色加粗，不靠继承字号（02 章第 6 节第 4 条） */
.u-amount {
  flex: none;
  font-size: var(--hz-font-md);
  font-weight: 600;
  color: var(--hz-ink);
}

/* 卡片底（hz-card、入口卡、明细、提示条共用） */
.u-card {
  background: var(--hz-card);
  border-radius: var(--hz-radius);
}

/* 11px 胶囊：hz-status、hz-tag 共用尺寸 */
.u-pill {
  display: inline-block;
  height: 20px;
  padding: 0 8px;
  font-size: var(--hz-font-xs);
  line-height: 20px;
  white-space: nowrap;
  border-radius: var(--hz-radius-pill);
}

/* 表单字段外框：hz-field、hz-picker 共用（02 章第 4 节） */
.u-field {
  display: flex;
  flex-direction: column;
  gap: var(--hz-line-gap);
}

.u-field__label {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.u-field__box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hz-input);
  padding: 0 var(--hz-row-pad);
  color: var(--hz-ink);
  background: var(--hz-paper);
  border-radius: var(--hz-radius);
  box-shadow: inset 0 0 0 1px var(--hz-hair);
}

.u-field__box--focus {
  box-shadow: inset 0 0 0 1.5px var(--hz-brand);
}

.u-field__box--error {
  background: var(--hz-danger-bg);
  box-shadow: inset 0 0 0 1px var(--hz-danger);
}

.u-field__box--placeholder {
  color: var(--hz-muted);
}

.u-field__icon {
  font-size: var(--hz-icon);
  color: var(--hz-muted);
}

.u-field__error {
  font-size: var(--hz-font-sm);
  color: var(--hz-danger);
}

/* 弹层里的区块：不套框，用细线分隔，左右留 --hz-gap-sheet（hz-sheet） */
.u-sheet-section {
  padding: var(--hz-row-pad) var(--hz-gap-sheet);
  font-size: var(--hz-font-note);
  border-top: 1px solid var(--hz-line);
}

/* 区块的小标题（原因、改动） */
.u-sheet-section__title {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

/* 弹层抬头：先写这是哪一条（02 章第 1 节） */
.u-sheet-head {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.u-sheet-head__title {
  font-size: var(--hz-font-md);
  font-weight: 600;
}

.u-sheet-head__meta {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

/* 区块竖排：小标题 + 内容、多行「标签　值」 */
.u-sheet-stack {
  display: flex;
  flex-direction: column;
  gap: var(--hz-line-gap);
}

/* 「标签　值」一行（个人资料、日志详情、组件总览） */
.u-sheet-row {
  display: flex;
  gap: var(--hz-row-pad);
  justify-content: space-between;
}

.u-sheet-row__label {
  flex: none;
  color: var(--hz-muted);
}

.u-sheet-row__value {
  min-width: 0;
  text-align: right;
}

/* 改动「旧 → 新」：旧值次要色，新值加粗 */
.u-sheet-row__from {
  color: var(--hz-muted);
}

.u-sheet-row__to {
  font-weight: 600;
}

/* 弹层里的表单：左右留 --hz-gap-sheet，按意思分组，组之间细线（02 章第 1 节） */
.u-sheet-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: var(--hz-row-pad) var(--hz-gap-sheet);
  border-top: 1px solid var(--hz-line);
}

.u-sheet-form__group {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-top: var(--hz-line-gap);
  border-top: 1px solid var(--hz-line);
}

/* 表单里「标签　内容 + 文字按钮」一行（员工弹层的微信），高同 hz-switch */
.u-sheet-form__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hz-tap);
  font-size: var(--hz-font-md);
}

.u-sheet-form__value {
  display: flex;
  gap: var(--hz-line-gap);
  align-items: center;
  font-size: var(--hz-font);
  color: var(--hz-muted);
}

/* 小标题：弹层里的「下单日期」、组件总览的分组说明 */
.u-caption {
  margin-bottom: 8px;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

/* 铺品牌背景的页面（各首页、我的）：左右 20px，抬头下面 32px 开始放窗格 */
.u-home {
  padding: 0 var(--hz-gap-home);
}

.u-home__body {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 32px;
}

/* 列表页：左右 16px，卡片间距 10px */
.u-list {
  display: flex;
  flex-direction: column;
  gap: var(--hz-card-gap);
  padding: 12px var(--hz-gap-page);
}

/* 按天分组的列表组头（操作日志）：13px 墨色加粗（02 章第 1 节、第 6 节） */
.u-list__group {
  padding: var(--hz-line-gap) 2px 0;
  font-size: var(--hz-font-note);
  font-weight: 600;
  letter-spacing: 0.04em;
}

.u-list__end {
  padding: 12px 0;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
  text-align: center;
}

/* 详情、表单里的一组：小标题 + 卡片（产品明细、发货信息、变更记录），和上一组多隔 6px；
   组里卡片之间照常 10px，小标题和下面的卡片只隔 6px */
.u-section {
  display: flex;
  flex-direction: column;
  gap: var(--hz-card-gap);
  margin-top: var(--hz-line-gap);
}

.u-section__title {
  margin-bottom: calc(var(--hz-line-gap) - var(--hz-card-gap));
  padding: 0 2px;
  font-size: var(--hz-font-note);
  font-weight: 600;
  letter-spacing: 0.04em;
}

/* 一张卡里多行、行间细线（订货目录、配方）：比一行一张卡紧凑 */
.u-rows {
  padding: 0 var(--hz-card-pad);
}

.u-rows__item {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: var(--hz-line-gap) 0;
}

.u-rows__item + .u-rows__item {
  border-top: 1px solid var(--hz-line);
}

/* 订货目录第一行（同 hz-card 第 2 行）：名称（主信息，最多两行）、订货价靠右顶齐 */
.u-rows__head {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding-top: 4px;
}

.u-rows__title {
  flex: 1;
  min-width: 0;
  font-size: var(--hz-font-md);
  font-weight: 500;
  line-height: 1.4;
}

.u-rows__price {
  flex: none;
  font-size: var(--hz-font-md);
  font-weight: 600;
  line-height: 1.4;
  color: var(--hz-ink);
}

/* 订货目录第二行（同 hz-card 第 3 行）：标记在左，接客户产品编码，次要色 */
.u-rows__foot {
  display: flex;
  gap: 8px;
  align-items: center;
  padding-bottom: 2px;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

/* 提醒说明（配方所有客户共用）：琥珀字，不用最弱的灰 */
.u-note-warn {
  padding: 8px 12px;
  font-size: var(--hz-font-sm);
  color: var(--hz-amber);
  background: var(--hz-amber-bg);
  border-radius: var(--hz-radius-inner);
}

/* 长名称最多两行，不把价格挤走 */
.u-clamp-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 一行里左边名称、右边控件 */
.u-rows__line {
  display: flex;
  gap: var(--hz-line-gap);
  align-items: center;
  min-height: var(--hz-tap);
}

.u-rows__name {
  flex: 1;
  min-width: 0;
  font-size: var(--hz-font-md);
}

/* 配方一行：名称 → 用量 → 单位 → 垃圾桶 */
.u-rows__unit {
  flex: none;
  min-width: 2em;
  font-size: var(--hz-font-note);
  color: var(--hz-muted);
}

.u-rows__trash {
  flex: none;
  margin-right: -12px;
  font-size: var(--hz-icon);
  color: var(--hz-muted);
}

/* 金额输入小框（明细单价、订货价）：36px 高，后面跟单位 */
.u-price-box {
  display: flex;
  align-items: center;
  width: 96px;
  height: 36px;
  padding: 0 10px;
  background: var(--hz-paper);
  border-radius: var(--hz-radius-inner);
  box-shadow: inset 0 0 0 1px var(--hz-hair);
}

.u-price-box__input {
  flex: 1;
  min-width: 0;
  font-size: var(--hz-font-md);
}

.u-price-box__unit {
  flex: none;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

/* 详情页的信息卡（views/detail.wxml）：单号 + 状态，下面「标签　值」一行一项 */
.u-info {
  display: flex;
  flex-direction: column;
  gap: var(--hz-line-gap);
  padding: var(--hz-row-pad) var(--hz-card-pad);
  font-size: var(--hz-font-note);
}

.u-info__head {
  display: flex;
  gap: var(--hz-line-gap);
  align-items: center;
  justify-content: space-between;
}

.u-info__title {
  font-size: var(--hz-font-md);
  font-weight: 600;
}

.u-info__meta {
  color: var(--hz-muted);
}

/* 一张卡里的多行（售后产品），行间细线 */
.u-info__line {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-bottom: var(--hz-line-gap);
  border-bottom: 1px solid var(--hz-line);
}

.u-info__line:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

/* 售后图片缩略图 1:1 */
.u-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--hz-line-gap);
}

.u-thumbs__item {
  width: 72px;
  height: 72px;
  background: var(--hz-tint);
  border-radius: var(--hz-radius-inner);
}

/* 选择弹层里的一行（选订单、选产品）：整行可点 */
.u-pick-row {
  display: flex;
  gap: var(--hz-row-pad);
  align-items: center;
  justify-content: space-between;
  min-height: var(--hz-tap);
  padding: var(--hz-line-gap) var(--hz-gap-sheet);
  font-size: var(--hz-font);
  border-top: 1px solid var(--hz-line);
}

/* 右边的日期、库存不断行，名称长了自己换行 */
.u-pick-row__sub {
  flex: none;
  white-space: nowrap;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

/* 表单里一行一张卡片、行里有多个字段（申请售后、售后表单、配方） */
.u-form-card {
  display: flex;
  flex-direction: column;
  gap: var(--hz-row-pad);
  padding: var(--hz-row-pad) var(--hz-card-pad);
}

/* 左侧列表 + 右侧内容（客户门店、订货目录） */
.u-split {
  display: flex;
  flex: 1;
  min-height: 0;
}

.u-split__side {
  flex: none;
  width: 108px;
}

.u-split__main {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--hz-card-gap);
  min-width: 0;
  padding: 0 var(--hz-gap-page) 0 var(--hz-line-gap);
}

/* 带图的一行（产品管理）：左图右字 */
.u-product {
  display: flex;
  gap: var(--hz-row-pad);
  align-items: center;
  padding: var(--hz-row-pad);
}

.u-product__info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

/* 只读弹层（收款、售后、订单详情弹层）：详情模板里的卡片在弹层里不装框，
   区块之间 --hz-line 细线，区块小标题 12px 次要色（02 章第 4 节 hz-sheet、第 6 节第 2 条）。
   卡片底色和弹层亮格分不出来，可点的 hz-card（订单弹层里的售后）也一样摊平，和下面的核销行对齐 */
.u-sheet-plain .u-card {
  background: transparent;
  border-radius: 0;
}

.u-sheet-plain .u-info,
.u-sheet-plain .u-rows,
.u-sheet-plain .hz-card {
  padding-right: 0;
  padding-left: 0;
}

.u-sheet-plain .u-section {
  padding-top: var(--hz-row-pad);
  border-top: 1px solid var(--hz-line);
}

.u-sheet-plain .u-section__title {
  font-size: var(--hz-font-sm);
  font-weight: 400;
  color: var(--hz-muted);
  letter-spacing: 0;
}
