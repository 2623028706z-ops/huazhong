/* 公共片段：组件用这些类，不复制粘贴（01 章第 3.1 节） */

/* 1px 细线：伪元素 + 缩放，高分屏上也是一个物理像素 */
.u-hairline-bottom {
  position: relative;
}

.u-hairline-bottom::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1px;
  content: '';
  background: var(--hz-line);
  transform: scaleY(0.5);
  transform-origin: 0 100%;
}

/* 单行省略 */
.u-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 点击区域不小于 44px，外观可以更小 */
.u-tap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: var(--hz-tap);
  min-height: var(--hz-tap);
}

/* 底部安全区 */
.u-safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 衬线字：标题 500、金额 600 */
.u-serif {
  font-family: var(--hz-serif);
  font-weight: 500;
}

.u-serif-amount {
  font-family: var(--hz-serif);
  font-weight: 600;
}

/* 底栏左侧的合计：金额 + 数量（订货结算条、结算页） */
.u-bar-total {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  min-height: var(--hz-tap);
}

/* 订货结算条（定稿 .cb）：购物车图标带款数角标 + 宋体金额 + 小字件数 */
.u-cart {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 16px;
  min-width: 0;
}

.u-cart__icon {
  position: relative;
  display: flex;
  font-size: var(--hz-icon-tab);
}

.u-cart__badge {
  position: absolute;
  top: -6px;
  right: -9px;
  min-width: 17px;
  height: 17px;
  padding: 0 4px;
  box-sizing: border-box;
  border: 1.5px solid var(--hz-ink);
  border-radius: var(--hz-radius-pill);
  background: var(--hz-brand);
  color: var(--hz-on-brand);
  font-size: var(--hz-font-xs);
  line-height: 14px;
  text-align: center;
}

.u-bar-total__amount {
  font-family: var(--hz-serif);
  font-size: var(--hz-font-total);
  font-weight: 700;
  color: var(--hz-on-brand);
}

.u-bar-total__meta {
  margin-top: 1px;
  font-size: var(--hz-font-xs);
  opacity: 0.7;
}

/* 信息行里的金额：15px 墨色加粗，不靠继承字号（02 章第 6 节第 4 条） */
.u-amount {
  flex: none;
  font-size: var(--hz-font-md);
  font-weight: 600;
  color: var(--hz-ink);
}

/* 卡片底（hz-card、入口卡、明细、提示条共用） */
.u-card {
  background: var(--hz-paper);
  border: 1px solid var(--hz-hair);
  border-radius: var(--hz-radius);
}

/* 11px 小方标签（定稿 .tag：行高 19、左右 7、圆角 4）：hz-status、hz-tag 共用尺寸 */
.u-pill {
  display: inline-block;
  height: 19px;
  padding: 0 7px;
  font-size: var(--hz-font-xs);
  font-weight: 500;
  line-height: 19px;
  white-space: nowrap;
  border-radius: var(--hz-radius-check);
}

/* 表单字段：hz-field、hz-picker、hz-choices 共用（02 章第 4 节）。
   页面卡片里是定稿 .cell 一行：字段名在左、值靠右、行间细线，选择项右边 ›，金额是右边小框；
   弹层里（.u-sheet-form）换回整条输入框——行样子靠下面这组变量切换 */
.u-field {
  display: flex;
  flex-flow: row wrap;
  align-items: center;
  column-gap: 10px;
  min-height: var(--hz-field-row, 48px);
  margin-top: -1px;
  font-size: var(--hz-font);
  border-top: 1px solid var(--hz-field-line, var(--hz-line));
}

.u-field__label {
  width: 72px;
  flex: none;
  font-size: var(--hz-field-label, var(--hz-font));
  color: var(--hz-muted);
}

.u-field__box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
  min-height: var(--hz-field-box, 48px);
  padding: 0 var(--hz-field-pad, 0);
  color: var(--hz-ink);
  text-align: var(--hz-field-align, right);
  background: var(--hz-field-bg, transparent);
  border-radius: var(--hz-radius);
  box-shadow: var(--hz-field-ring, none);
}

/* 弹层里（hz-sheet 面板带 u-boxed）：整条带框输入，字段名小字 */
.u-boxed {
  --hz-field-row: auto;
  --hz-field-line: transparent;
  --hz-field-label: var(--hz-font-sm);
  --hz-field-box: var(--hz-input);
  --hz-field-pad: var(--hz-row-pad);
  --hz-field-align: left;
  --hz-field-bg: var(--hz-paper);
  --hz-field-ring: inset 0 0 0 1px var(--hz-hair);
  --hz-field-ring-on: inset 0 0 0 1.5px var(--hz-brand);
  --hz-field-num: auto;
  --hz-field-num-flex: 1;
  --hz-field-num-h: var(--hz-input);
  --hz-field-area: var(--hz-textarea);
  --hz-field-area-pad: 10px;
}

.u-field__box--focus {
  box-shadow: var(--hz-field-ring-on, none);
}

.u-field__box--error {
  color: var(--hz-danger);
}

.u-field__box--placeholder {
  color: var(--hz-muted);
}

.u-field__icon {
  font-size: var(--hz-icon-sm);
  color: var(--hz-muted);
}

.u-field__error {
  flex-basis: 100%;
  padding-bottom: 8px;
  font-size: var(--hz-font-sm);
  color: var(--hz-danger);
}

/* 弹层里的区块：不套框，用细线分隔，左右留 --hz-gap-sheet（hz-sheet） */
.u-sheet-section {
  padding: var(--hz-row-pad) var(--hz-gap-sheet);
  font-size: var(--hz-font-sm);
  border-top: 1px solid var(--hz-line);
}

/* 小标题只一种（02 章第 6 节第 2 条）：12px 次要色。弹层区块小标题（原因、改动）、组件总览和筛选弹层的说明 */
.u-sheet-section__title,
.u-caption {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

/* 弹层抬头：先写这是哪一条（02 章第 1 节） */
.u-sheet-head {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.u-sheet-head__title {
  font-size: var(--hz-font-md);
  font-weight: 600;
}

.u-sheet-head__meta {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

/* 区块竖排：小标题 + 内容、多行「标签　值」 */
.u-sheet-stack {
  display: flex;
  flex-direction: column;
  gap: var(--hz-line-gap);
}

/* 「标签　值」一行（个人资料、日志详情、组件总览） */
.u-sheet-row {
  display: flex;
  gap: var(--hz-row-pad);
  justify-content: space-between;
}

.u-sheet-row__label {
  flex: none;
  color: var(--hz-muted);
}

.u-sheet-row__value {
  min-width: 0;
  text-align: right;
}

/* 改动「旧 → 新」：旧值次要色，新值加粗 */
.u-sheet-row__from {
  color: var(--hz-muted);
}

.u-sheet-row__to {
  font-weight: 600;
}

/* 弹层里的表单：左右留 --hz-gap-sheet，按意思分组，组之间细线（02 章第 1 节） */
.u-sheet-form {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: var(--hz-row-pad) var(--hz-gap-sheet);
  border-top: 1px solid var(--hz-line);
}

.u-sheet-form__group {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-top: var(--hz-line-gap);
  border-top: 1px solid var(--hz-line);
}

/* 表单里「标签　内容 + 文字按钮」一行（员工弹层的微信），高同 hz-switch */
.u-sheet-form__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hz-tap);
  font-size: var(--hz-font-md);
}

.u-sheet-form__value {
  display: flex;
  gap: var(--hz-line-gap);
  align-items: center;
  font-size: var(--hz-font);
  color: var(--hz-muted);
}

.u-sheet-buttons {
  display: grid;
  grid-auto-columns: 1fr;
  grid-auto-flow: column;
  gap: var(--hz-line-gap);
}

/* 小标题：弹层里的「下单日期」、组件总览的分组说明 */
.u-caption {
  margin-bottom: 8px;
}

/* 铺品牌背景的页面（各首页、我的）：左右 16px，抬头下面 32px 开始放窗格 */
.u-home {
  padding: 0 var(--hz-gap-page);
}

.u-home__body {
  display: flex;
  flex-direction: column;
  gap: var(--hz-card-gap);
  margin-top: 32px;
}

/* 列表页：左右 16px，卡片间距 10px */
.u-list {
  display: flex;
  flex-direction: column;
  gap: var(--hz-card-gap);
  padding: 12px var(--hz-gap-page);
}

/* 组标题只一种（02 章第 6 节第 2 条）：页面卡片外 13px 墨色加粗。
   列表组头（操作日志按天、产品按分类）和详情、表单里的一组共用 */
.u-list__group,
/* 分组标题（待办、常用、放久了 · 先用、发货单…）：宋体 15px 加粗，后面可跟灰色小字个数 */
.u-section__title {
  font-family: var(--hz-serif);
  font-size: var(--hz-font-group);
  font-weight: 600;
  letter-spacing: 1px;
  color: var(--hz-ink);
}

.u-section__count {
  margin-left: 8px;
  font-family: var(--hz-sans);
  font-size: var(--hz-font-sm);
  font-weight: 400;
  letter-spacing: 0;
  color: var(--hz-muted);
}

.u-list__group {
  padding: var(--hz-line-gap) 4px 0;
}

.u-list__end {
  padding: 12px 0;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
  text-align: center;
}

/* 详情、表单里的一组：小标题 + 卡片（产品明细、发货信息、变更记录），和上一组多隔 6px；
   组里卡片之间照常 10px，小标题和下面的卡片只隔 6px */
.u-section {
  display: flex;
  flex-direction: column;
  gap: var(--hz-card-gap);
  margin-top: var(--hz-line-gap);
}

.u-section__title {
  margin: 8px 0 calc(var(--hz-line-gap) - var(--hz-card-gap));
  padding: 0 4px;
}

/* 一张卡里多行、行间细线（订货目录、配方）：比一行一张卡紧凑 */
.u-rows {
  padding: 0 var(--hz-card-pad);
}

.u-rows__item {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: var(--hz-line-gap) 0;
}

.u-rows__item + .u-rows__item {
  border-top: 1px solid var(--hz-line);
}

/* 订货目录第一行（同 hz-card 第 2 行）：名称（主信息，最多两行）、订货价靠右顶齐 */
.u-rows__head {
  display: flex;
  gap: 12px;
  align-items: flex-start;
  padding-top: 4px;
}

.u-rows__title {
  flex: 1;
  min-width: 0;
  font-size: var(--hz-font-md);
  font-weight: 500;
  line-height: 1.4;
}

.u-rows__price {
  flex: none;
  font-size: var(--hz-font-md);
  font-weight: 600;
  line-height: 1.4;
  color: var(--hz-ink);
}

/* 订货目录第二行（同 hz-card 第 3 行）：标记在左，接客户产品编码，次要色 */
.u-rows__foot {
  display: flex;
  gap: 8px;
  align-items: center;
  padding-bottom: 2px;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

/* 提醒说明（配方所有客户共用）：琥珀字，不用最弱的灰 */
.u-note-warn {
  padding: 10px var(--hz-card-pad);
  font-size: var(--hz-font-sm);
  color: var(--hz-amber);
  background: var(--hz-amber-bg);
  border-radius: var(--hz-radius-inner);
}

/* 长名称最多两行，不把价格挤走 */
.u-clamp-2 {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* 一行里左边名称、右边控件 */
.u-rows__line {
  display: flex;
  gap: var(--hz-line-gap);
  align-items: center;
  min-height: var(--hz-tap);
}

.u-rows__name {
  flex: 1;
  min-width: 0;
  font-size: var(--hz-font-md);
}

/* 配方一行：名称 → 用量 → 单位 → 垃圾桶 */
.u-rows__unit {
  flex: none;
  min-width: 2em;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.u-rows__trash {
  flex: none;
  margin-right: -12px;
  font-size: var(--hz-icon);
  color: var(--hz-muted);
}

/* 金额输入小框（明细单价、订货价）：36px 高，后面跟单位 */
.u-price-box {
  display: flex;
  align-items: center;
  width: 96px;
  height: 36px;
  padding: 0 10px;
  background: var(--hz-paper);
  border-radius: var(--hz-radius-inner);
  box-shadow: inset 0 0 0 1px var(--hz-hair);
}

.u-price-box__input {
  flex: 1;
  min-width: 0;
  font-size: var(--hz-font-md);
}

.u-price-box__unit {
  flex: none;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

/* 详情页的信息卡（views/detail.wxml）：单号 + 状态，下面「标签　值」一行一项 */
.u-info {
  display: flex;
  flex-direction: column;
  gap: var(--hz-line-gap);
  padding: var(--hz-card-pad-y) var(--hz-card-pad);
  font-size: var(--hz-font-sm);
}

/* 抬头下一条细线再接字段（定稿 .dc .hd + .kvs，和列表卡片一致） */
.u-info__head {
  display: flex;
  gap: var(--hz-line-gap);
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--hz-line-gap);
  margin-bottom: 2px;
  border-bottom: 1px solid var(--hz-line);
}

.u-info__title {
  font-size: var(--hz-font-md);
  font-weight: 600;
}

.u-info__meta {
  color: var(--hz-muted);
}

/* 一张卡里的多行（售后产品），行间细线 */
.u-info__line {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-bottom: var(--hz-line-gap);
  border-bottom: 1px solid var(--hz-line);
}

.u-info__line:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

/* 售后图片缩略图 1:1 */
.u-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: var(--hz-line-gap);
}

.u-thumbs__item {
  width: 72px;
  height: 72px;
  background: var(--hz-tint);
  border-radius: var(--hz-radius-inner);
}

/* 选一个（定稿 108）：一行一个，名称下可有一行小字；选中红字 + 右边对勾。hz-picker、筛选选客户共用 */
.u-choice {
  display: flex;
  gap: var(--hz-row-pad);
  align-items: center;
  justify-content: space-between;
  min-height: var(--hz-tap);
  padding: var(--hz-line-gap) 0;
  font-size: var(--hz-font);
  color: var(--hz-ink);
}

.u-choice + .u-choice {
  border-top: 1px solid var(--hz-line);
}

.u-choice__main {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.u-choice__sub {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.u-choice--on {
  font-weight: 600;
  color: var(--hz-brand);
}

.u-choice__check {
  flex: none;
  font-size: var(--hz-icon);
  color: var(--hz-brand);
}

/* 表单里一行一张卡片、行里有多个字段（申请售后、售后表单、配方） */
.u-form-card {
  display: flex;
  flex-direction: column;
  padding: 0 var(--hz-card-pad);
  overflow: hidden;
}

/* 表单卡里的只读一行（例如从对账单进来的客户）：和字段行同一个样子 */
.u-form-card .u-sheet-row {
  align-items: center;
  min-height: 48px;
  margin-top: -1px;
  font-size: var(--hz-font);
  border-top: 1px solid var(--hz-line);
}

/* 表单卡第一行是小标题（订单信息、确认订单店名）：上面留足内边距，下面再接字段行 */
.u-form-card > .u-info__title {
  display: block;
  padding: var(--hz-card-pad-y) 0 var(--hz-line-gap);
}

/* 左侧列表 + 右侧内容（客户门店、订货目录） */
.u-split {
  display: flex;
  flex: 1;
  min-height: 0;
}

.u-split__side {
  flex: none;
  width: 108px;
}

.u-split__main {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--hz-card-gap);
  min-width: 0;
  padding: 0 var(--hz-gap-page) 0 var(--hz-line-gap);
}

/* scroll-view 里 gap 不生效：直接子卡片自己留 10px，标签行和第一张卡片之间同样 10px，底部留 12px */
.u-split__main > view[data-key] {
  margin-bottom: var(--hz-card-gap);
}

.u-split__main > .u-split__tabs {
  display: block;
  margin-bottom: var(--hz-card-gap);
}

.u-split__main::after {
  display: block;
  height: 12px;
  content: '';
}

/* 带图的一行（产品管理）：左图右字 */
.u-product {
  display: flex;
  gap: var(--hz-row-pad);
  align-items: center;
  padding: var(--hz-row-pad);
}

.u-product__info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

/* 只读弹层（收款、售后、订单详情弹层）：详情模板里的卡片在弹层里不装框，
   区块之间 --hz-line 细线，区块小标题 12px 次要色（02 章第 4 节 hz-sheet、第 6 节第 2 条）。
   卡片底色和弹层亮格分不出来，可点的 hz-card（订单弹层里的售后）也一样摊平，与下面的记录行对齐 */
.u-sheet-plain .u-card {
  background: transparent;
  border-radius: 0;
}

.u-sheet-plain .u-info,
.u-sheet-plain .u-rows,
.u-sheet-plain .hz-card,
.u-sheet-plain .hz-line-item__list {
  padding-right: 0;
  padding-left: 0;
}

.u-sheet-plain .u-section {
  padding-top: var(--hz-row-pad);
  border-top: 1px solid var(--hz-line);
}

.u-sheet-plain .u-section__title {
  font-size: var(--hz-font-sm);
  font-weight: 400;
  color: var(--hz-muted);
  letter-spacing: 0;
}

.u-field > picker {
  flex: 1;
  min-width: 0;
}

.u-field__suffix {
  flex: none;
  color: var(--hz-muted);
}

.u-aged {
  color: var(--hz-amber);
}

/* 页面最下面一行灰字操作，居中（详情第三个操作、取消邀请、作废采购单等） */
.u-detail-third {
  display: flex;
  justify-content: center;
  padding: 14px var(--hz-gap-page) 6px;
  color: var(--hz-muted);
}

/* 单据图片取色用的隐藏元素：画布读它的计算样式，颜色只在 tokens 里定 */
.u-document-canvas {
  position: fixed;
  width: 1px;
  height: 1px;
  pointer-events: none;
  visibility: hidden;
  color: var(--hz-ink);
  background-color: var(--hz-paper);
  border-color: var(--hz-brand) var(--hz-hair) var(--hz-muted) var(--hz-bg);
}

.u-count-table {
  display: grid;
  grid-template-columns: minmax(85px, 1fr) repeat(3, 38px) 28px;
  gap: 4px;
  align-items: center;
  padding: 12px 10px;
  font-size: var(--hz-font-sm);
  text-align: right;
  border-bottom: 1px solid var(--hz-hair);
}

.u-count-table > view:first-child,
.u-count-table > text:first-child {
  text-align: left;
}

.u-count-table--head {
  background: var(--hz-tint);
  color: var(--hz-muted);
}

/* 盘点行内直接输入实盘数 */
.u-count-table--edit {
  grid-template-columns: minmax(85px, 1fr) 38px 64px 38px 28px;
}

.u-count-table__input {
  box-sizing: border-box;
  width: 100%;
  height: 30px;
  padding: 0 6px;
  font-size: var(--hz-font-sm);
  text-align: right;
  background: var(--hz-paper);
  box-shadow: inset 0 0 0 1px var(--hz-hair);
  border-radius: var(--hz-radius-check);
}

/* 勾选框：方框，选中品牌红底白勾（卡片多选、配货打勾、对账单选单共用） */
.u-check {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  font-size: var(--hz-icon-xs);
  color: var(--hz-on-brand);
  border-radius: var(--hz-radius-check);
  box-shadow: inset 0 0 0 1.5px var(--hz-hair);
}

.u-check--on {
  background: var(--hz-brand);
  box-shadow: none;
}
