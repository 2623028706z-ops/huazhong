/* 公共片段：组件用这些类，不复制粘贴（01 章第 3.1 节） */

/* 1px 细线：伪元素 + 缩放，高分屏上也是一个物理像素 */
.u-hairline-bottom {
  position: relative;
}

.u-hairline-bottom::after {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 1px;
  content: '';
  background: var(--hz-line);
  transform: scaleY(0.5);
  transform-origin: 0 100%;
}

/* 单行省略 */
.u-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 点击区域不小于 44px，外观可以更小 */
.u-tap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: var(--hz-tap);
  min-height: var(--hz-tap);
}

/* 底部安全区 */
.u-safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 衬线字：标题 500、金额 600 */
.u-serif {
  font-family: var(--hz-serif);
  font-weight: 500;
}

.u-serif-amount {
  font-family: var(--hz-serif);
  font-weight: 600;
}

/* 卡片底（hz-card、入口卡、明细、提示条共用） */
.u-card {
  background: var(--hz-card);
  border-radius: var(--hz-radius);
}

/* 11px 胶囊：hz-status、hz-tag 共用尺寸 */
.u-pill {
  display: inline-block;
  height: 20px;
  padding: 0 8px;
  font-size: var(--hz-font-xs);
  line-height: 20px;
  white-space: nowrap;
  border-radius: var(--hz-radius-pill);
}

/* 表单字段外框：hz-field、hz-picker 共用（02 章第 4 节） */
.u-field {
  display: flex;
  flex-direction: column;
  gap: var(--hz-line-gap);
}

.u-field__label {
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}

.u-field__box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--hz-input);
  padding: 0 var(--hz-row-pad);
  color: var(--hz-ink);
  background: var(--hz-paper);
  border-radius: var(--hz-radius);
  box-shadow: inset 0 0 0 1px var(--hz-hair);
}

.u-field__box--focus {
  box-shadow: inset 0 0 0 1.5px var(--hz-brand);
}

.u-field__box--error {
  background: var(--hz-danger-bg);
  box-shadow: inset 0 0 0 1px var(--hz-danger);
}

.u-field__box--placeholder {
  color: var(--hz-muted);
}

.u-field__icon {
  font-size: var(--hz-icon);
  color: var(--hz-muted);
}

.u-field__error {
  font-size: var(--hz-font-sm);
  color: var(--hz-danger);
}

/* 弹层里的区块：不套框，用细线分隔（hz-sheet） */
.u-sheet-section {
  padding: var(--hz-row-pad) var(--hz-gap-sheet);
  font-size: var(--hz-font-note);
  border-top: 1px solid var(--hz-line);
}

/* 小标题：弹层里的「下单日期」、组件总览的分组说明 */
.u-caption {
  margin-bottom: 8px;
  font-size: var(--hz-font-sm);
  color: var(--hz-muted);
}
