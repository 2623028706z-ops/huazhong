<template name="bom-rows"><!-- 组标题在卡外，右边小字 hint（每束用量 · n 种花材）；表头第一列写 column（花材）；可不传 hint --><view class="u-section"><view class="u-section__title u-section__title--split"><text>{{heading}}</text><text wx:if="{{hint}}" class="u-caption">{{hint}}</text></view><text wx:if="{{error}}" class="u-field__error">{{error}}</text><hz-line-item material title="{{column}}" lines="{{bomRows}}" mode="quantity" quantity-only compact min="{{1}}" removable add-text="{{add}}" bind:qty="onBomQty" bind:remove="onRemoveBom" bind:add="onAddBom" /></view></template>
