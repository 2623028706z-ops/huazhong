<template name="bom-rows"><!-- 可不传：note（共享配方说明） --><view class="u-section"><text wx:if="{{note}}" class="u-note-warn">{{note}}</text><text wx:if="{{error}}" class="u-field__error">{{error}}</text><hz-line-item material title="{{heading}}" lines="{{bomRows}}" mode="quantity" quantity-only min="{{1}}" removable edit-key="{{editKey}}" bind:qty="onBomQty" bind:remove="onRemoveBom" /><hz-add-button text="{{add}}" bind:press="onAddBom" /></view></template>
