<!-- 配方明细（X10、X11 弹层）：页面 <import src="/views/bom.wxml" /> 后用。
     一种花材一行：名称、用量、单位、垃圾桶；下面「添加花材」。发 onBomQty / onRemoveBom（data-index）、onAddBom -->
<template name="bom-rows">
  <view class="u-section">
    <text class="u-section__title">{{heading}}</text>
    <text wx:if="{{note}}" class="u-note-warn">{{note}}</text>
    <text wx:if="{{error}}" class="u-field__error">{{error}}</text>
    <view wx:if="{{bom.length > 0}}" class="u-card u-rows">
      <view wx:for="{{bom}}" wx:key="materialId" class="u-rows__item">
        <view class="u-rows__line">
          <text class="u-rows__name u-ellipsis">{{item.name}}</text>
          <hz-stepper value="{{item.qty}}" min="{{1}}" data-index="{{index}}" bind:change="onBomQty" />
          <text class="u-rows__unit">{{item.unit}}</text>
          <view class="u-tap u-rows__trash" data-index="{{index}}" bindtap="onRemoveBom">
            <text class="hz-icon hz-icon--trash-2"></text>
          </view>
        </view>
      </view>
    </view>
    <hz-add-button text="{{add}}" bind:press="onAddBom" />
  </view>
</template>
