<!-- 详情页的公共区块（06 章第 1.1 节）：页面 <import src="/views/detail.wxml" /> 后用 template 引用。
     数据都由 views/*.ts 换好成文字，这里不做格式化 -->
<!-- 信息卡：单号 + 状态，下面「标签　值」一行一项；传了 heading 就是一组（小标题 + 卡片） -->
<template name="info-card">
  <!-- 可不传：title、status、statusKind、cols（默认两列「字段名 + 值紧跟」，传 false 才一列） -->
  <view class="u-card u-info">
    <view wx:if="{{title}}" class="u-info__head">
      <text class="u-info__title">{{title}}</text>
      <hz-status wx:if="{{status}}" kind="{{statusKind}}" code="{{status}}" />
    </view>
    <hz-info-rows rows="{{rows}}" cols="{{cols !== false}}" />
  </view>
</template>
<template name="info">
  <!-- 可不传：heading、title、status、statusKind、cols -->
  <view wx:if="{{heading}}" class="u-section">
    <text class="u-section__title">{{heading}}</text>
    <template is="info-card" data="{{title, status, statusKind, rows, cols}}" />
  </view>
  <template wx:else is="info-card" data="{{title, status, statusKind, rows, cols}}" />
</template>
<!-- 售后产品：数量和原因、问题说明、图片直接展开（hz-line-item after 变体） -->
<template name="after-lines">
  <view class="u-section">
    <text wx:if="{{heading}}" class="u-section__title">{{heading}}</text>
    <hz-line-item lines="{{lines}}" mode="after" />
  </view>
</template>
<!-- 底部操作区：按 core/actions 的 buttonsOf 显示，点了发 onAction（data-code 是操作码）。
     最多 2 个按钮，第 3 个起收进最左的「更多」（02 章第 4 节，2026-10-06 第 4 批） -->
<template name="buttons">
  <!-- 可不传：busy（按钮只打开弹层或跳页时） -->
  <hz-action-bar wx:if="{{buttons.length > 0}}" more="{{buttons.length > 2}}">
    <hz-more wx:if="{{buttons.length > 2}}">
      <hz-button wx:for="{{buttons}}" wx:key="code" wx:if="{{index >= 2}}" kind="secondary" text="{{item.text}}" disabled="{{item.disabled}}" reason="{{item.reason}}" data-code="{{item.code}}" bind:press="onAction" />
    </hz-more>
    <hz-button
      wx:for="{{buttons}}"
      wx:key="code"
      wx:if="{{index < 2}}"
      kind="{{item.kind}}"
      text="{{item.text}}"
      disabled="{{item.disabled}}"
      reason="{{item.reason}}"
      loading="{{busy === item.code}}"
      data-code="{{item.code}}"
      bind:press="onAction"
    />
  </hz-action-bar>
</template>
<!-- 订单只读内容（S6、X3、H3 只读）：数据是 views/order.ts 的 orderViewOf。详情区块顺序统一（02 章第 6 节第 21 条）：
     进度条 → 提示条 → 信息卡（含取消、作废、取消申请信息）→ 产品明细（明细 + 金额）→ 变更记录 -->
<template name="order-body">
  <hz-progress steps="{{progress}}" />
  <hz-notice wx:if="{{noteNotice}}" text="{{noteNotice}}" /><hz-notice wx:if="{{cancelNotice}}" text="{{cancelNotice}}" /><hz-notice wx:if="{{notice}}" text="{{notice}}" />
  <template is="info" data="{{...info}}" />
  <template wx:if="{{reason.rows.length > 0}}" is="info" data="{{...reason}}" />
  <template wx:if="{{void.rows.length > 0}}" is="info" data="{{...void}}" />
  <template wx:for="{{requests}}" wx:key="id" is="info-card" data="{{rows: item.rows}}" />
  <view class="u-section">
    <hz-line-item title="{{linesHeading}}" qty-label="{{qtyLabel}}" note="{{shipNote}}" note-label="{{shipNoteLabel}}" lines="{{lines}}" quantity-only="{{quantityOnly}}" bind:open="onOpenBom" />
  </view>
  <hz-records wx:if="{{changes.length > 0}}" type="orderChange" items="{{changes}}" />
</template>
<!-- 售后只读内容（S7 弹层、X6、F3 弹层）：进度条 → 提示条 → 信息卡（含关闭或作废信息）→ 售后明细 -->
<template name="after-body">
  <hz-progress steps="{{progress}}" /><hz-notice wx:if="{{notice}}" text="{{notice}}" />
  <template is="info" data="{{...info}}" />
  <template wx:if="{{reason.rows.length > 0}}" is="info" data="{{...reason}}" />
  <template is="after-lines" data="{{lines, heading: ''}}" />
</template>
