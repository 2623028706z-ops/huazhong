<import src="list.wxml" /><template name="external-business"><hz-cover mode="full" /><hz-navbar title="{{title}}" /><view class="u-list"><hz-brand /><hz-tabs items="{{segmentTabs}}" value="{{segment}}" bind:change="onSegment" /><hz-statement wx:if="{{segment === 'statements'}}" cells="{{cells}}" /><hz-filter-bar status-kind="{{statusKind}}" statuses="{{statuses}}" counts="{{counts}}" date-label="{{dateLabel}}" search-placeholder="{{segment === 'statements' ? '' : texts.no}}" value="{{filter}}" bind:change="onFilter" /><template is="list-state" data="{{failure,skeleton,loaded,rows,emptyObject}}" /><template is="cards" data="{{rows,statusKind,done,allLoaded}}" /><text wx:if="{{segment === 'afters'}}" class="u-info__meta">{{texts.storeAfterHint}}</text></view><hz-tabbar tabs="{{tabs}}" current="orders" /></template>
