<import src="list.wxml" /><template name="external-business"><!-- 可不传：segmentCounts、apply（门店才有：段名数字、售后段底栏「申请售后」） --><!-- 定稿 004：顶上就是宋体三段，不写页名、不放字标和背景图 --><hz-navbar title="" /><view class="u-list"><hz-tabs big items="{{segmentTabs}}" value="{{segment}}" counts="{{segmentCounts}}" bind:change="onSegment" /><hz-statement wx:if="{{segment === 'statements'}}" cells="{{cells}}" /><hz-filter-bar search-placeholder="{{searchPlaceholder}}" status-kind="{{statusKind}}" statuses="{{statuses}}" date-label="{{dateLabel}}" value="{{filter}}" bind:change="onFilter" /><template is="list-state" data="{{failure,skeleton,loaded,rows,emptyObject}}" /><template is="cards" data="{{rows,statusKind,done,allLoaded}}" /></view><hz-action-bar wx:if="{{segment === 'afters' && apply}}" tabbar><hz-button text="{{apply.text}}" disabled="{{apply.disabled}}" reason="{{apply.reason}}" bind:press="onApplyAfter" /></hz-action-bar><hz-tabbar tabs="{{tabs}}" current="orders" /></template>
