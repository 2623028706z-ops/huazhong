<import src="list.wxml" /><template name="external-business"><!-- 定稿 004：顶上就是宋体三段，不写页名、不放字标和背景图 --><hz-navbar title="" /><view class="u-list"><hz-tabs big items="{{segmentTabs}}" value="{{segment}}" bind:change="onSegment" /><hz-statement wx:if="{{segment === 'statements'}}" cells="{{cells}}" /><hz-filter-bar status-kind="{{statusKind}}" statuses="{{statuses}}" counts="{{counts}}" date-label="{{dateLabel}}" value="{{filter}}" bind:change="onFilter" /><template is="list-state" data="{{failure,skeleton,loaded,rows,emptyObject}}" /><template is="cards" data="{{rows,statusKind,done,allLoaded}}" /><text wx:if="{{segment === 'afters'}}" class="u-info__meta hz-orders__hint">{{texts.storeAfterHint}}</text></view><hz-tabbar tabs="{{tabs}}" current="orders" /></template>
