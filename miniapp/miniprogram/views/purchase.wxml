<import src="detail.wxml" />
<template name="po-body">
  <hz-notice wx:if="{{notice}}" text="{{notice}}" />
  <hz-progress steps="{{progress}}" />
  <template is="info" data="{{...info}}" />
  <view class="u-section">
    <hz-line-item material title="{{linesHeading}}" qty-label="{{qtyLabel}}" lines="{{lines}}" />

  </view>
  <hz-records wx:if="{{changes.length}}" type="poChange" items="{{changes}}" />
  <hz-records wx:if="{{prices.length}}" type="priceChange" items="{{prices}}" />
  <hz-records wx:if="{{returns.length}}" type="returns" items="{{returns}}" />
  <template wx:if="{{reason.rows.length}}" is="info" data="{{...reason}}" />
</template>
<template name="invite-body">
  <hz-progress steps="{{progress}}" />
  <template is="info" data="{{...info}}" />
  <view class="u-section">
    <hz-line-item material title="{{linesHeading}}" qty-label="{{qtyLabel}}" lines="{{lines}}" quantity-only="{{!submitted}}" />
  </view>
  <template wx:if="{{reason.rows.length}}" is="info" data="{{...reason}}" />
</template>
