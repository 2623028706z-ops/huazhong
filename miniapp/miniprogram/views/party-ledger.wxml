<import src="list.wxml" />
<template name="party-ledger">
<hz-navbar title="{{title}}" back /><view class="u-list"><hz-statement cells="{{cells}}" /><view class="u-card u-form-card"><view class="u-sheet-row"><text>{{supplier ? texts.supplierCredited : texts.credited}}</text><text class="u-serif-amount">{{creditText}}</text><hz-button wx:if="{{canRefund}}" kind="text" text="{{texts.refund}}" bind:press="onRefund" /></view><view class="u-sheet-row"><text>{{termsText}}</text><hz-button wx:if="{{canTerms}}" kind="text" text="{{texts.modify}}" bind:press="onTerms" /></view></view><hz-tabs items="{{ledgerTabs}}" value="{{ledgerTab}}" bind:change="onLedgerTab" /><hz-filter-bar wx:if="{{ledgerTab === 'statements'}}" status-kind="statementStatus" statuses="{{statuses}}" counts="{{counts}}" date-label="{{texts.statementDate}}" value="{{filter}}" bind:change="onFilter" /><template wx:if="{{ledgerTab === 'statements'}}" is="list-state" data="{{failure,skeleton,loaded,rows,emptyObject}}" /><template wx:if="{{ledgerTab === 'statements'}}" is="cards" data="{{rows,statusKind,done,allLoaded}}" /><block wx:else><hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" /><hz-state wx:if="{{loaded && !sourceGroups.length}}" message="{{texts.noUnstatemented}}" /><view wx:for="{{sourceGroups}}" wx:key="title" class="u-section"><text class="u-section__title">{{item.title}}</text><view wx:for="{{item.rows}}" wx:for-item="source" wx:key="id" data-key="{{source.id}}" bindtap="onSource"><hz-card row="{{source}}" /></view></view></block><view wx:if="{{refundRows.length}}" class="u-section"><text class="u-section__title">{{texts.refunds}}</text><view wx:for="{{refundRows}}" wx:key="id" class="u-card u-info"><view class="u-sheet-row"><text>{{item.no}}</text><text>{{item.status}}</text></view><view class="u-sheet-row"><text>{{texts.refundDate}}</text><text>{{item.date}}</text></view><view class="u-sheet-row"><text>{{texts.refundAmount}}</text><text class="u-serif-amount">{{item.amount}}</text></view><text wx:if="{{item.reason}}">{{item.reason}}</text><hz-button wx:if="{{item.canVoid}}" kind="text" text="{{texts.voidRefund}}" data-key="{{item.id}}" bind:press="onVoidRefund" /></view></view></view><hz-action-bar wx:if="{{canCreate || canRegister}}"><hz-button wx:if="{{canCreate}}" kind="secondary" text="{{texts.statementCreate}}" bind:press="onCreate" /><hz-button wx:if="{{canRegister}}" text="{{supplier ? texts.registerPayment : texts.registerReceipt}}" bind:press="onRegister" /></hz-action-bar><hz-sheet show="{{refundSheet}}" guard="{{refundChanged}}" title="{{supplier ? texts.refundSupplierCredit : texts.refundCredit}}" footer bind:close="onCloseRefund"><view class="u-sheet-form"><hz-error wx:if="{{refundError}}" message="{{refundError}}" /><hz-picker id="refund-date" label="{{texts.refundDate}}" mode="date" value="{{refundForm.refundDate}}" end="{{today}}" data-key="refundDate" bind:change="onRefundField" /><hz-field id="refund-amount" label="{{texts.refundAmount}}" type="digit" value="{{refundForm.amountText}}" suffix="{{texts.currency}}" data-key="amountText" bind:change="onRefundField" /><hz-picker id="refund-method" label="{{texts.refundMethod}}" options="{{refundMethods}}" value="{{refundForm.methodName}}" data-key="methodName" bind:change="onRefundField" /><hz-field label="{{texts.note}}" value="{{refundForm.note}}" data-key="note" bind:change="onRefundField" /></view><hz-button slot="footer" text="{{texts.confirmRefund}}" loading="{{refundBusy}}" bind:press="onSubmitRefund" /></hz-sheet><hz-reason-sheet show="{{voidRefundId !== ''}}" title="{{texts.voidRefund}}" required confirm="{{texts.confirmVoid}}" error="{{refundError}}" loading="{{refundBusy}}" bind:close="onCloseVoidRefund" bind:submit="onSubmitVoidRefund" /><hz-confirm id="hz-confirm" />
</template>
