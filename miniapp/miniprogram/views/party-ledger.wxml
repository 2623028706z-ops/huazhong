<import src="list.wxml" />
<import src="detail.wxml" />
<template name="party-ledger">
<hz-navbar title="{{title}}" back /><view class="u-list"><text class="u-serif hz-party-title">{{partyName}}</text>
<hz-party-summary label="{{summary.label}}" amount-cents="{{summary.amountCents}}" lines="{{summary.lines}}" />
<hz-tabs items="{{ledgerTabs}}" value="{{ledgerTab}}" bind:change="onLedgerTab" />
<template wx:if="{{ledgerTab === 'statements'}}" is="list-state" data="{{failure,skeleton,loaded,rows,emptyObject}}" />
<template wx:if="{{ledgerTab === 'statements'}}" is="cards" data="{{rows,statusKind,done,allLoaded}}" />
<block wx:else>
<hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" />
<hz-state wx:if="{{loaded && !sourceGroups.length}}" message="{{texts.noUnstatemented}}" />
<view wx:for="{{sourceGroups}}" wx:key="title" class="u-section">
<text wx:if="{{item.title}}" class="u-section__title">{{item.title}}</text>
<view wx:for="{{item.rows}}" wx:for-item="source" wx:key="id" data-key="{{source.id}}" bindtap="onSource">
<hz-card row="{{source}}" />
</view>
</view>
</block>
<!-- 退回记录：整行点开看这一笔，作废在弹层底栏（行里不放按钮） -->
<view wx:if="{{refundRows.length}}" class="u-section"><text class="u-section__title">{{texts.refunds}}</text><view wx:for="{{refundRows}}" wx:key="id" class="u-card u-info u-tap" data-key="{{item.id}}" bindtap="onRefundRow"><view class="u-sheet-row"><text>{{item.no}}</text><text>{{item.status}}</text></view><view class="u-sheet-row"><text>{{texts.refundDate}}</text><text>{{item.date}}</text></view><view class="u-sheet-row"><text>{{texts.refundAmount}}</text><text class="u-serif-amount">{{item.amount}}</text></view><text wx:if="{{item.reason}}">{{item.reason}}</text></view></view></view>
<!-- 底栏：新建对账单 / 登记收款（付款）、往来设置、多收退回，最多 2 个，多的收进左边「更多」（同详情页） -->
<template is="buttons" data="{{buttons}}" />
<hz-sheet show="{{refundSheet}}" guard="{{refundChanged}}" title="{{supplier ? texts.refundSupplierCredit : texts.refundCredit}}" footer bind:close="onCloseRefund"><view class="u-sheet-form"><hz-error wx:if="{{refundError}}" message="{{refundError}}" /><hz-picker id="refund-date" label="{{texts.refundDate}}" mode="date" value="{{refundForm.refundDate}}" end="{{today}}" data-key="refundDate" bind:change="onRefundField" /><hz-field id="refund-amount" label="{{texts.refundAmount}}" type="digit" value="{{refundForm.amountText}}" suffix="{{texts.currency}}" data-key="amountText" bind:change="onRefundField" /><hz-picker id="refund-method" label="{{texts.refundMethod}}" options="{{refundMethods}}" value="{{refundForm.methodName}}" data-key="methodName" bind:change="onRefundField" /><hz-field label="{{texts.note}}" type="textarea" value="{{refundForm.note}}" data-key="note" bind:change="onRefundField" /></view><hz-button slot="footer" text="{{texts.confirmRefund}}" loading="{{refundBusy}}" bind:press="onSubmitRefund" /></hz-sheet><hz-sheet show="{{refundDetail !== null}}" title="{{supplier ? texts.refundSupplierCredit : texts.refundCredit}}" footer="{{refundDetail.hasVoid}}" bind:close="onCloseRefundDetail"><view class="u-sheet-section"><hz-info-rows rows="{{refundDetail.rows}}" /></view><hz-button slot="footer" kind="secondary" text="{{texts.voidRefund}}" disabled="{{refundDetail.voidDisabled}}" reason="{{refundDetail.voidReason}}" bind:press="onVoidRefund" /></hz-sheet><hz-reason-sheet show="{{voidRefundId !== ''}}" title="{{texts.voidRefund}}" required confirm="{{texts.confirmVoid}}" error="{{refundError}}" loading="{{refundBusy}}" bind:close="onCloseVoidRefund" bind:submit="onSubmitVoidRefund" /><hz-confirm id="hz-confirm" />
</template>
