<import src="detail.wxml" />
<template name="stock-body">
  <hz-notice wx:if="{{notice}}" text="{{notice}}" />
  <template is="info" data="{{...info}}" />
  <view class="u-section"><hz-line-item title="{{linesHeading}}" qty-label="{{qtyLabel}}" lines="{{lines}}" quantity-only="{{quantityOnly}}" /></view>
  <hz-records wx:if="{{prices.length}}" type="priceChange" items="{{prices}}" />
  <view wx:if="{{images.length}}" class="u-section"><view class="u-thumbs"><image wx:for="{{images}}" wx:key="fileId" class="u-thumbs__item" src="{{item.thumbUrl}}" mode="aspectFill" data-url="{{item.url}}" data-urls="{{urls}}" bindtap="onPreview" /></view></view>
  <template wx:if="{{void.rows.length}}" is="info" data="{{...void}}" />
</template>
<!-- 库存行（W11、M5 同一套）：名称 + 编码 / 分类，右边库存数（宋体大字）+ 已放天数 -->
<template name="hz-stock-row">
  <view class="u-rows__item hz-stock-row" data-key="{{id}}" bindtap="{{openable ? 'onOpen' : ''}}">
    <view class="u-rows__head">
      <view class="hz-stock-row__name"><text class="u-rows__title">{{name}}</text><text wx:if="{{typeText}}" class="hz-stock-row__type">{{typeText}}</text></view>
      <view class="hz-stock-row__qty"><text class="hz-stock-row__unit">{{label}}</text><text class="u-serif-amount hz-stock-row__num {{tone}}">{{qty}}</text><text class="hz-stock-row__unit">{{unit}}</text></view>
    </view>
    <view class="u-rows__foot"><text>{{sub}}</text><hz-tag wx:if="{{disabled}}" text="{{disabledText}}" /><text wx:if="{{age}}" class="hz-stock-row__age {{aged ? 'u-aged' : ''}}">{{age}}</text></view>
  </view>
</template>
<!-- 分组：放久了 · 先用 / 其他，一组一张卡 -->
<template name="hz-stock-groups">
  <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
    <view wx:if="{{group.title}}" class="hz-stock-group"><text class="u-section__title {{group.aged ? 'u-aged' : ''}}">{{group.title}}</text><text class="hz-stock-group__count">{{group.count}}</text></view>
    <view class="u-card u-rows"><template wx:for="{{group.rows}}" wx:key="id" is="hz-stock-row" data="{{...item, openable}}" /></view>
  </block>
</template>
<!-- 花材抬头卡（W12、W13）：花材名 + 库存（宋体大字），下面编码 / 分类 / 单位；edit 有值时右下一个「修改花材」 -->
<template name="material-head">
  <view class="u-card hz-stock-head">
    <view class="hz-stock-head__top"><text class="u-serif hz-stock-head__name">{{name}}</text><view class="hz-stock-row__qty"><text class="u-serif-amount hz-stock-head__num">{{qty}}</text><text class="hz-stock-row__unit">{{unit}}</text></view></view>
    <view class="hz-stock-head__bottom"><text class="hz-stock-row__unit">{{sub}}</text><hz-tag wx:if="{{disabled}}" text="{{disabledText}}" /><hz-button wx:if="{{edit}}" kind="text" text="{{edit}}" bind:press="onEdit" /></view>
  </view>
</template>
