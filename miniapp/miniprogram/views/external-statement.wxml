<import src="detail.wxml" /><import src="stock.wxml" /><template name="external-statement"><hz-navbar title="{{title}}" back /><hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" /><view wx:else class="u-list"><hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" /><hz-skeleton wx:if="{{!loaded}}" type="detail" /><block wx:else><hz-notice wx:if="{{view.notice}}" text="{{view.notice}}" /><template is="info" data="{{...view.info}}" /><hz-statement cells="{{view.cells}}" /><view wx:for="{{view.groups}}" wx:key="title" class="u-section"><text class="u-section__title">{{item.title}}</text><view wx:for="{{item.rows}}" wx:for-item="source" wx:key="id" data-key="{{source.id}}" bindtap="onSource"><hz-card row="{{source}}" /></view></view><view wx:if="{{supplier}}" class="u-section"><text class="u-section__title">{{texts.receipts}}</text><text wx:if="{{!view.settlements.length}}">{{texts.noReceipt}}</text><hz-card wx:for="{{view.settlements}}" wx:key="id" row="{{item}}" status-kind="recordStatus" /></view></block></view><hz-sheet show="{{sourceSheet}}" title="{{texts.sourceNo}}" bind:close="onCloseSource"><view class="u-sheet-form u-sheet-plain"><hz-error wx:if="{{sourceError}}" message="{{sourceError}}" /><hz-skeleton wx:elif="{{!stockView}}" type="detail" /><template wx:else is="stock-body" data="{{...stockView}}" /></view></hz-sheet></template>
