<import src="detail.wxml" /><import src="stock.wxml" /><template name="external-statement"><hz-navbar title="{{title}}" back /><hz-state wx:if="{{failure.kind === 'page'}}" kind="{{failure.state}}" message="{{failure.message}}" bind:action="onFailureAction" /><view wx:else class="u-list"><hz-error wx:if="{{failure}}" message="{{failure.message}}" retry="{{failure.retry}}" bind:retry="onFailureAction" /><hz-skeleton wx:if="{{!loaded}}" type="detail" /><block wx:else><hz-notice wx:if="{{view.notice}}" text="{{view.notice}}" /><template is="info" data="{{...view.info}}" /><hz-statement cells="{{view.cells}}" /><hz-statement-list title="{{view.main.title}}" meta="{{view.main.meta}}" groups="{{view.main.groups}}" empty-text="{{view.main.emptyText}}" bind:press="onSource" /><hz-statement-list title="{{view.afterSection.title}}" groups="{{view.afterSection.groups}}" empty-text="{{view.afterSection.emptyText}}" bind:press="onSource" /><hz-statement-list wx:if="{{view.receiptSection}}" title="{{view.receiptSection.title}}" groups="{{view.receiptSection.groups}}" empty-text="{{view.receiptSection.emptyText}}" /></block></view><hz-sheet show="{{sourceSheet}}" title="{{texts.sourceNo}}" bind:close="onCloseSource"><view class="u-sheet-form u-sheet-plain"><hz-error wx:if="{{sourceError}}" message="{{sourceError}}" /><hz-skeleton wx:elif="{{!stockView}}" type="detail" /><template wx:else is="stock-body" data="{{...stockView}}" /></view></hz-sheet></template>
