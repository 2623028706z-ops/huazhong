<import src="list.wxml" />
<template name="invite-list">
  <!-- 可不传：embedded -->
  <hz-navbar wx:if="{{!embedded}}" title="{{title}}" back="{{!supplier}}" />
  <view class="u-list">
    <hz-filter-bar date-label="{{dateLabel}}" status-kind="{{statusKind}}" statuses="{{statuses}}" counts="{{counts}}" dimensions="{{dimensions}}" value="{{filter}}" bind:change="onFilter" />
    <template is="list-state" data="{{failure,skeleton,loaded,rows,emptyObject}}" />
    <template is="cards" data="{{rows,statusKind,done,allLoaded}}" />
  </view>
  <hz-tabbar wx:if="{{supplier}}" tabs="{{tabs}}" current="supply" />
</template>
