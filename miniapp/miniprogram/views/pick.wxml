<!-- 选择弹层（选订单、选产品、选花材）：页面 <import src="/views/pick.wxml" /> 后用；
     单选：点一行发 onPick（data-key 是 id）；多选（multi）：点一行发 onPick 切换勾选，
     底部「添加（n）」发 onPickConfirm；关闭发 onClosePick -->
<template name="pick-sheet">
  <!-- 可不传：error、multi、count、confirm（多选时传 multi: true、已勾数量、按钮字） -->
  <hz-sheet show="{{show}}" title="{{title}}" footer="{{!!multi}}" bind:close="onClosePick">
    <view wx:if="{{error}}" class="u-sheet-section"><hz-error message="{{error}}" /></view>
    <view wx:elif="{{picks.length === 0}}" class="u-sheet-section">{{empty}}</view>
    <view class="u-sheet-section">
      <view wx:for="{{picks}}" wx:key="id" class="u-choice {{item.checked ? 'u-choice--on' : ''}}" data-key="{{item.id}}" bindtap="onPick">
        <view class="u-choice__main">
          <text>{{item.name}}</text>
          <text wx:if="{{item.sub}}" class="u-choice__sub">{{item.sub}}</text>
        </view>
        <text wx:if="{{item.checked}}" class="u-choice__check hz-icon hz-icon--check"></text>
      </view>
    </view>
    <hz-button wx:if="{{multi}}" slot="footer" text="{{confirm}}" disabled="{{!count}}" bind:press="onPickConfirm" />
  </hz-sheet>
</template>
