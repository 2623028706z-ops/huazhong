<template name="count-table"><view class="u-card"><view class="u-count-table u-count-table--head {{editable ? 'u-count-table--edit' : ''}}"><text>{{texts.materials}}</text><text>{{texts.bookQty}}</text><text>{{texts.actualQty}}</text><text>{{texts.difference}}</text><text>{{texts.unit}}</text></view><view wx:for="{{rows}}" wx:key="materialId" class="u-count-table {{editable ? 'u-count-table--edit' : ''}}"><view><text>{{item.name}}</text><hz-tag wx:if="{{item.enabled===false}}" text="{{texts.disabled}}" /><text wx:if="{{item.error}}" class="u-field__error">{{item.error}}</text></view><text>{{item.bookQty}}</text><input wx:if="{{editable}}" class="u-count-table__input" type="number" value="{{item.actualText}}" data-index="{{index}}" bindinput="onActualInput" /><text wx:else>{{item.actualText}}</text><text>{{item.diffQty}}</text><text>{{item.unit}}</text></view></view></template>
