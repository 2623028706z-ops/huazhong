    return date.slice(0, 4) === today.slice(0, 4) ? date.slice(5) : date;
}
function formatTime(timestamp) {
    var minutes = shanghaiMinutesOf(timestamp);
    var days = Math.floor(minutes / MINUTES_PER_DAY);
    var minuteOfDay = minutes - days * MINUTES_PER_DAY;
    return (civilFromDays(days) + ' ' + pad2(Math.floor(minuteOfDay / 60)) + ':' + pad2(minuteOfDay % 60));
}
function formatNavDate(date) {
    var weekday = (((daysOfDate(date) + 4) % 7) + 7) % 7;
    var dotted = date.slice(0, 4) + '.' + date.slice(5, 7) + '.' + date.slice(8, 10);
