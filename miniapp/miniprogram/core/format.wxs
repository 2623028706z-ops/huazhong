var WEEK_PREFIX = '周';
var WEEKDAY_NAMES = '日一二三四五六';
var YUAN = '¥';
var MINUS = '−';
var COUNT_MAX = 99;
function pad2(value) {
    return value < 10 ? '0' + value : '' + value;
}
function daysFromCivil(year, month, day) {
    var shifted = month <= 2 ? year - 1 : year;
    var era = Math.floor(shifted / 400);
    var yearOfEra = shifted - era * 400;
    var monthIndex = month > 2 ? month - 3 : month + 9;
