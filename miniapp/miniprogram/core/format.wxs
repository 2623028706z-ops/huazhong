}
function shanghaiMinutesOf(timestamp) {
    var days = daysOfDate(timestamp.slice(0, 10));
    var hours = parseInt(timestamp.slice(11, 13), 10);
    var minutes = parseInt(timestamp.slice(14, 16), 10);
    return days * MINUTES_PER_DAY + hours * 60 + minutes + SHANGHAI_OFFSET_MINUTES;
}
function shanghaiDateOf(epochMs) {
    var minutes = Math.floor(epochMs / MS_PER_MINUTE) + SHANGHAI_OFFSET_MINUTES;
    return civilFromDays(Math.floor(minutes / MINUTES_PER_DAY));
}
function formatMoney(cents) {
    var sign = cents < 0 ? MINUS : '';
    var absolute = Math.abs(cents);
    var fen = absolute % 100;
    var yuan = '' + Math.floor(absolute / 100);
    var grouped = '';
    while (yuan.length > 3) {
        grouped = ',' + yuan.slice(yuan.length - 3) + grouped;
