{
  "name": "huazhong",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm --filter @huazhong/server build",
    "typecheck": "tsc -b shared/tsconfig.build.json && tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p miniapp --noEmit && tsc -p scripts --noEmit",
    "lint": "eslint . && stylelint \"miniapp/**/*.wxss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "dup": "jscpd",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen": "pnpm --filter @huazhong/scripts gen",
    "gen:check": "pnpm --filter @huazhong/scripts gen:check",
    "gen:backdrop": "pnpm --filter @huazhong/scripts gen:backdrop",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm knip && pnpm dup && pnpm gen:check && pnpm test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jscpd": "5.3.3",
    "knip": "6.38.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
